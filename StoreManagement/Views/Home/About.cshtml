<link href="~/Content/home/home.css" rel="stylesheet" />

@{
    ViewBag.Title = "About";
}
<main aria-labelledby="title">
    @if (User.Identity.IsAuthenticated)
    {
        <div class="dashboard-container">
            <div class="dashboard-welcome">
                <h1 id="title">@ViewBag.Title</h1>
                <p>@ViewBag.Message</p>
            </div>

            <div class="home-card">
                <div class="main-view-card-header">
                    <span class="main-view-card-icon"><i class="fa fa-info-circle"></i></span>
                    <h4>About Store Management</h4>
                </div>
                <p class="main-row-detail-muted mb-0">Use this area to provide additional information.</p>
            </div>
        </div>
    }
    else
    {
        <p>Please log in to view this content.</p>
    }

</main>
