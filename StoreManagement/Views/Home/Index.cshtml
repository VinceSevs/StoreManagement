@{
    ViewBag.Title = "Home Page";

    var currentUserProfile = StoreManagement.Models.UserAccess.Current(Context);
    string displayName = currentUserProfile != null ? currentUserProfile.DisplayName : User.Identity.Name;
    string firstName = string.IsNullOrWhiteSpace(displayName) ? "" : displayName.Trim().Split(' ')[0];

    bool canDashboard = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Dashboard);
    bool canCar = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Car);
    bool canNncr = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Nncr);
    bool canComplaint = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.ComplaintReport);
    bool canPdfReceipt = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.PdfReceipt);
}

<main>
    @if (User.Identity.IsAuthenticated)
    {
        <div class="dashboard-container">

            <div class="dashboard-welcome">
                <h1>Welcome back, @firstName</h1>
                <p>Here's quick access to what you work with most.</p>
            </div>

            <div class="dashboard-grid">

                @if (canDashboard)
                {
                    <a href="@Url.Action("Index", "Dashboard")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-tachometer"></i></span>
                        <span class="dashboard-card-label">Dashboard</span>
                    </a>
                }

                @if (canCar)
                {
                    <a href="@Url.Action("CapaList", "Capa")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-folder-open-o"></i></span>
                        <span class="dashboard-card-label">CAR List</span>
                    </a>
                    <a href="@Url.Action("Quality", "Capa")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-plus-square-o"></i></span>
                        <span class="dashboard-card-label">CAR Report Form</span>
                    </a>
                }

                @if (canNncr)
                {
                    <a href="@Url.Action("NncrList", "Nncr")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-list-alt"></i></span>
                        <span class="dashboard-card-label">NNCR List</span>
                    </a>
                    <a href="@Url.Action("Quality", "Nncr")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-pencil-square-o"></i></span>
                        <span class="dashboard-card-label">NNCR Report Form</span>
                    </a>
                }

                @if (canComplaint)
                {
                    <a href="@Url.Action("Index", "ComplaintReport")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-file-text-o"></i></span>
                        <span class="dashboard-card-label">Product Complaint</span>
                    </a>
                    <a href="@Url.Action("Index", "Ncr")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-exclamation-triangle"></i></span>
                        <span class="dashboard-card-label">Non-Conformance</span>
                    </a>
                }

                @if (canPdfReceipt)
                {
                    <a href="@Url.Action("PdfReceipt", "Finance")" class="dashboard-card">
                        <span class="dashboard-card-icon"><i class="fa fa-file-pdf-o"></i></span>
                        <span class="dashboard-card-label">PDF Receipt</span>
                    </a>
                }

            </div>

        </div>
    }
    else
    {
        <p>Please log in to view this content.</p>
    }

</main>
