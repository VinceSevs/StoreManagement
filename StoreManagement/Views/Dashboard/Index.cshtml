                            <tr><td>Closed</td><td class="text-end">@Model.PcrStats.Closed</td><td class="text-end">@Model.NcrStats.Closed</td></tr>
                            <tr><td>Cancelled / Invalid</td><td class="text-end">@Model.PcrStats.Cancelled</td><td class="text-end">@Model.NcrStats.Cancelled</td></tr>
