    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="dash-card">
                <h6>Status Breakdown</h6>
                @if (Model.ComplaintStats.Total == 0)
                {
                    <div class="dash-empty">No PCR/NCR records yet.</div>
                }
                else
                {
                    <div class="dash-summary" id="complaintStatusSummary"><i class="bi bi-lightbulb"></i><span></span></div>
