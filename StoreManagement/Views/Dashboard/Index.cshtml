@model StoreManagement.Models.DashboardViewModel

@{
    ViewBag.Title = "Main Dashboard";

    string carStatusSummary = "";
    if (Model.CarStats.Total > 0)
    {
        string dominantLabel; int dominantCount;
        if (Model.CarStats.Open >= Model.CarStats.InVerification && Model.CarStats.Open >= Model.CarStats.Closed && Model.CarStats.Open >= Model.CarStats.Cancelled)
        { dominantLabel = "awaiting response"; dominantCount = Model.CarStats.Open; }
        else if (Model.CarStats.InVerification >= Model.CarStats.Closed && Model.CarStats.InVerification >= Model.CarStats.Cancelled)
        { dominantLabel = "awaiting verification"; dominantCount = Model.CarStats.InVerification; }
        else if (Model.CarStats.Closed >= Model.CarStats.Cancelled)
        { dominantLabel = "closed"; dominantCount = Model.CarStats.Closed; }
        else
        { dominantLabel = "cancelled"; dominantCount = Model.CarStats.Cancelled; }

        int pct = (int)System.Math.Round(dominantCount * 100.0 / Model.CarStats.Total);
        carStatusSummary = "Most CAR reports (" + dominantCount + " of " + Model.CarStats.Total + ", " + pct + "%) are " + dominantLabel + ".";
    }

    string carClassificationSummary = "";
    if (Model.CarClassificationLabels.Count > 0 && Model.CarStats.Total > 0)
    {
        int pct = (int)System.Math.Round(Model.CarClassificationCounts[0] * 100.0 / Model.CarStats.Total);
        carClassificationSummary = "Most CAR reports are attributed to " + Model.CarClassificationLabels[0]
            + " (" + Model.CarClassificationCounts[0] + " of " + Model.CarStats.Total + ", " + pct + "%).";
    }

    string pcrVsNcrSummary = "";
    int complaintTotalForSummary = Model.PcrTotal + Model.NcrTotal;
    if (complaintTotalForSummary > 0)
    {
        int pcrPct = (int)System.Math.Round(Model.PcrTotal * 100.0 / complaintTotalForSummary);
        pcrVsNcrSummary = "PCRs make up " + pcrPct + "% of all complaint records (" + Model.PcrTotal + " PCR vs " + Model.NcrTotal + " NCR).";
    }
}

<link href="~/Content/dashboard/index.css" rel="stylesheet" />

<div class="lead-page-header dash-toolbar">
    <div class="d-flex align-items-center gap-3">
        <div class="lead-page-icon"><i class="bi bi-speedometer2"></i></div>
        <div>
            <div class="lead-eyebrow">Overview</div>
            <h1>Dashboard</h1>
        </div>
    </div>
    <div class="dash-toolbar-controls">
        <div>
            <label class="small fw-semibold text-secondary d-block mb-1" for="dashTrendRangeSelect">Trend Range</label>
            <select id="dashTrendRangeSelect" class="form-select dash-filter-select">
                <option value="3">Last 3 Months</option>
                <option value="6" selected>Last 6 Months</option>
                <option value="12">Last 12 Months</option>
                <option value="24">Last 24 Months</option>
            </select>
        </div>
        <div>
            <label class="small fw-semibold text-secondary d-block mb-1" for="dashFilterSelect">View</label>
            <select id="dashFilterSelect" class="form-select dash-filter-select">
                <option value="all">All Modules</option>
                <option value="car">CAR</option>
                <option value="complaint">Complaint Report</option>
            </select>
        </div>
    </div>
</div>

<!-- ===================== CAR SECTION ===================== -->
<div class="dash-section" data-section="car" id="carSection">
    <div class="dash-section-title">
        <span class="icon-chip"><i class="bi bi-folder2-open"></i></span> CAR (Corrective Action Report)
    </div>

    <div class="dash-stat-row">
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="dash-stat-card" style="--accent:#7d1f27;" title="View all CAR reports">
            <div class="dash-stat-value">@Model.CarStats.Total</div>
            <div class="dash-stat-label">Total</div>
            <div class="dash-stat-delta" id="carTotalDelta"></div>
        </a>
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="dash-stat-card" style="--accent:#c07a00;" title="View all CAR reports">
            <div class="dash-stat-value">@Model.CarStats.Open</div>
            <div class="dash-stat-label">Awaiting Response</div>
        </a>
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="dash-stat-card" style="--accent:#2f6690;" title="View all CAR reports">
            <div class="dash-stat-value">@Model.CarStats.InVerification</div>
            <div class="dash-stat-label">Awaiting Verification</div>
        </a>
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="dash-stat-card" style="--accent:#2f6b46;" title="View all CAR reports">
            <div class="dash-stat-value">@Model.CarStats.Closed</div>
            <div class="dash-stat-label">Closed</div>
        </a>
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="dash-stat-card" style="--accent:#8f7d7b;" title="View all CAR reports">
            <div class="dash-stat-value">@Model.CarStats.Cancelled</div>
            <div class="dash-stat-label">Cancelled</div>
        </a>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="dash-card">
                <h6>Status Breakdown</h6>
                @if (Model.CarStats.Total == 0)
                {
                    <div class="dash-empty">No CAR reports yet.</div>
                }
                else
                {
                    <div class="dash-summary"><i class="bi bi-lightbulb"></i><span>@carStatusSummary</span></div>
                    <div class="dash-chart-wrap"><canvas id="carStatusChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead><tr><th>Status</th><th class="text-end">Count</th></tr></thead>
                        <tbody>
                            <tr><td>Awaiting Response</td><td class="text-end">@Model.CarStats.Open</td></tr>
                            <tr><td>Awaiting Verification</td><td class="text-end">@Model.CarStats.InVerification</td></tr>
                            <tr><td>Closed</td><td class="text-end">@Model.CarStats.Closed</td></tr>
                            <tr><td>Cancelled</td><td class="text-end">@Model.CarStats.Cancelled</td></tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="dash-card">
                <h6>Reports Filed Over Time</h6>
                @if (Model.CarStats.Total == 0)
                {
                    <div class="dash-empty">No CAR reports yet.</div>
                }
                else
                {
                    <div class="dash-summary" id="carTrendSummary"><i class="bi bi-lightbulb"></i><span></span></div>
                    <div class="dash-chart-wrap"><canvas id="carTrendChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead id="carTrendHead"></thead>
                        <tbody id="carTrendBody"></tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-12">
            <div class="dash-card">
                <h6>Reports by Classification (who's responsible)</h6>
                @if (Model.CarClassificationLabels.Count == 0)
                {
                    <div class="dash-empty">No CAR reports yet.</div>
                }
                else
                {
                    <div class="dash-summary"><i class="bi bi-lightbulb"></i><span>@carClassificationSummary</span></div>
                    <div class="dash-chart-wrap dash-chart-tall"><canvas id="carClassificationChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead><tr><th>Classification</th><th class="text-end">Count</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < Model.CarClassificationLabels.Count; i++)
                            {
                                <tr><td>@Model.CarClassificationLabels[i]</td><td class="text-end">@Model.CarClassificationCounts[i]</td></tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="dash-view-all">
        <a href="@Url.Action("CapaList", "Capa")" target="_blank" class="btn btn-outline-primary btn-sm">
            View All CAR Reports <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>

<!-- ================ COMPLAINT REPORT SECTION ================ -->
<div class="dash-section" data-section="complaint" id="complaintSection">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="dash-section-title mb-0">
            <span class="icon-chip"><i class="bi bi-file-earmark-text"></i></span> Complaint Report
        </div>
        <div>
            <label class="small fw-semibold text-secondary d-block mb-1" for="complaintScopeSelect">Scope</label>
            <select id="complaintScopeSelect" class="form-select form-select-sm dash-scope-select">
                <option value="all">All (PCR + NCR)</option>
                <option value="pcr">PCR Only</option>
                <option value="ncr">NCR Only</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <a href="@Url.Action("Index", "ComplaintReport")" target="_blank" class="dash-mini-pill" title="View all PCR records">
            <i class="bi bi-file-earmark-text"></i> PCR: @Model.PcrTotal
        </a>
        <a href="@Url.Action("Index", "Ncr")" target="_blank" class="dash-mini-pill" title="View all NCR records">
            <i class="bi bi-exclamation-diamond"></i> NCR: @Model.NcrTotal
        </a>
    </div>

    <div class="dash-stat-row">
        <a href="@Url.Action("Index", "ComplaintReport")" target="_blank" id="complaintTotalLink" class="dash-stat-card" style="--accent:#7d1f27;" title="View records">
            <div class="dash-stat-value" id="complaintTotalValue">@Model.ComplaintStats.Total</div>
            <div class="dash-stat-label">Total</div>
            <div class="dash-stat-delta" id="complaintTotalDelta"></div>
        </a>
        <div class="dash-stat-card" style="--accent:#c07a00;">
            <div class="dash-stat-value" id="complaintOpenValue">@Model.ComplaintStats.Open</div>
            <div class="dash-stat-label">Open / Ongoing</div>
        </div>
        <div class="dash-stat-card" style="--accent:#2f6b46;">
            <div class="dash-stat-value" id="complaintClosedValue">@Model.ComplaintStats.Closed</div>
            <div class="dash-stat-label">Closed</div>
        </div>
        <div class="dash-stat-card" style="--accent:#8f7d7b;">
            <div class="dash-stat-value" id="complaintCancelledValue">@Model.ComplaintStats.Cancelled</div>
            <div class="dash-stat-label">Cancelled / Invalid</div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="dash-card">
                <h6>Status Breakdown</h6>
                @if (Model.ComplaintStats.Total == 0)
                {
                    <div class="dash-empty">No PCR/NCR records yet.</div>
                }
                else
                {
                    <div class="dash-summary" id="complaintStatusSummary"><i class="bi bi-lightbulb"></i><span></span></div>
                    <div class="dash-chart-wrap"><canvas id="complaintStatusChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead><tr><th>Status</th><th class="text-end">Count</th></tr></thead>
                        <tbody>
                            <tr><td>Open / Ongoing</td><td class="text-end" id="complaintStatusOpenCell">@Model.ComplaintStats.Open</td></tr>
                            <tr><td>Closed</td><td class="text-end" id="complaintStatusClosedCell">@Model.ComplaintStats.Closed</td></tr>
                            <tr><td>Cancelled / Invalid</td><td class="text-end" id="complaintStatusCancelledCell">@Model.ComplaintStats.Cancelled</td></tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-lg-8">
            <div class="dash-card">
                <h6 id="complaintTrendTitle">PCR + NCR Filed Over Time</h6>
                @if (Model.ComplaintStats.Total == 0)
                {
                    <div class="dash-empty">No PCR/NCR records yet.</div>
                }
                else
                {
                    <div class="dash-summary" id="complaintTrendSummary"><i class="bi bi-lightbulb"></i><span></span></div>
                    <div class="dash-chart-wrap"><canvas id="complaintTrendChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead id="complaintTrendHead"></thead>
                        <tbody id="complaintTrendBody"></tbody>
                    </table>
                }
            </div>
        </div>
        <div class="col-12" id="pcrVsNcrCard">
            <div class="dash-card">
                <h6>PCR vs NCR by Status</h6>
                @if (Model.PcrTotal == 0 && Model.NcrTotal == 0)
                {
                    <div class="dash-empty">No PCR/NCR records yet.</div>
                }
                else
                {
                    <div class="dash-summary"><i class="bi bi-lightbulb"></i><span>@pcrVsNcrSummary</span></div>
                    <div class="dash-chart-wrap dash-chart-tall"><canvas id="pcrVsNcrChart"></canvas></div>
                    <table class="table dash-data-table mb-0">
                        <thead><tr><th>Status</th><th class="text-end">PCR</th><th class="text-end">NCR</th></tr></thead>
                        <tbody>
                            <tr><td>Open / Ongoing</td><td class="text-end">@Model.PcrStats.Open</td><td class="text-end">@Model.NcrStats.Open</td></tr>
                            <tr><td>Closed</td><td class="text-end">@Model.PcrStats.Closed</td><td class="text-end">@Model.NcrStats.Closed</td></tr>
                            <tr><td>Cancelled / Invalid</td><td class="text-end">@Model.PcrStats.Cancelled</td><td class="text-end">@Model.NcrStats.Cancelled</td></tr>
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    <div class="dash-view-all">
        <a href="@Url.Action("Index", "ComplaintReport")" target="_blank" class="btn btn-outline-primary btn-sm">
            View All PCR Records <i class="bi bi-arrow-right"></i>
        </a>
        <a href="@Url.Action("Index", "Ncr")" target="_blank" class="btn btn-outline-primary btn-sm">
            View All NCR Records <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.5.1/chart.umd.min.js"></script>
<script>
    window.DASHBOARD_DATA = {
        trendYearMonths: @Html.Raw(Json.Encode(Model.TrendYearMonths)),
        trendLabels: @Html.Raw(Json.Encode(Model.TrendLabels)),
        carTrend: @Html.Raw(Json.Encode(Model.CarTrend)),
        pcrTrend: @Html.Raw(Json.Encode(Model.PcrTrend)),
        ncrTrend: @Html.Raw(Json.Encode(Model.NcrTrend)),
        complaintTrend: @Html.Raw(Json.Encode(Model.ComplaintTrend)),
        carClassificationLabels: @Html.Raw(Json.Encode(Model.CarClassificationLabels)),
        carClassificationCounts: @Html.Raw(Json.Encode(Model.CarClassificationCounts)),
        carStats: {
            open: @Model.CarStats.Open,
            verify: @Model.CarStats.InVerification,
            closed: @Model.CarStats.Closed,
            cancelled: @Model.CarStats.Cancelled
        },
        complaintStats: {
            total: @Model.ComplaintStats.Total,
            open: @Model.ComplaintStats.Open,
            closed: @Model.ComplaintStats.Closed,
            cancelled: @Model.ComplaintStats.Cancelled
        },
        pcrStats: {
            total: @Model.PcrStats.Total,
            open: @Model.PcrStats.Open,
            closed: @Model.PcrStats.Closed,
            cancelled: @Model.PcrStats.Cancelled
        },
        ncrStats: {
            total: @Model.NcrStats.Total,
            open: @Model.NcrStats.Open,
            closed: @Model.NcrStats.Closed,
            cancelled: @Model.NcrStats.Cancelled
        },
        complaintReportListUrl: '@Url.Action("Index", "ComplaintReport")',
        ncrListUrl: '@Url.Action("Index", "Ncr")',
        capaListUrl: '@Url.Action("CapaList", "Capa")'
    };
</script>
<script src="~/Scripts/dashboard/index.js"></script>
