
<link href="~/Content/capa/capa.css" rel="stylesheet" />

<div class="main-list-page">

    <!-- =========================================
         CAR FORM HERO BANNER
         ========================================= -->

    <div class="main-hero d-print-none">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Warehouse logistics" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("CapaList", "Capa")"
                   class="main-hero-back"
                   title="Back to CAR Reports"
                   aria-label="Back to CAR Reports">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <a href="@Url.Action("CapaList", "Capa")">CAR</a>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span>New Report</span>
            </nav>

            <h2 class="main-hero-heading">
                Corrective Action Report
            </h2>

            <p class="main-hero-description">
                Product Quality &amp; Food Safety Compliance. Describe the non-conformance and who should respond.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-exclamation-triangle"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Non-conformance</div>
                        <div class="main-hero-feature-desc">Items, defects and remarks</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-camera"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Evidence</div>
                        <div class="main-hero-feature-desc">Photos and documents</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-paper-plane"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Notify</div>
                        <div class="main-hero-feature-desc">Send to the responsible party</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="capa-page">

        <div class="capa-actionbar d-print-none">
            <span id="submitStatus" class="me-auto small fw-semibold"></span>
            <button type="button" class="btn main-outline-btn" onclick="startFormTour()">
                <i class="fa fa-info-circle"></i> Take a Tour
            </button>
            <button type="button" class="btn main-form-cancel-btn" onclick="clearForm()">Clear form</button>
            <button type="button" class="btn main-form-save-btn" id="submitBtn" onclick="submitCapaForm()">Submit to Database</button>
        </div>

        <form id="capaForm">

            <section class="capa-card">

                <div class="main-view-card-header">
                    <h4>Report Details</h4>
                    <div class="capa-grid-date">
                        <input type="date" class="form-control font-mono readonly-field" name="doc_date" id="docDateInput" value="@ViewBag.DateCreated" readonly aria-label="Date">
                    </div>
                </div>

                <div class="row g-3 capa-grid mb-3">
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">
                            Issued By <i class="fw-normal fst-italic">(Name / Department)</i>
                        </label>
                        <input type="text" class="form-control capa-autofill" name="issued_by" id="issuedByInput" value="@IsseERP.Models.MySession.Current.FullName" readonly>
                        <div class="form-text">
                            @if (string.IsNullOrWhiteSpace(IsseERP.Models.MySession.Current?.FullName))
                            {
                                <a href="@Url.Action("Login", "Home")">&middot; Login here</a>
                            }
                        </div>
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">
                            Ref. No. <i id="tempRefNoOptionalHint" class="fw-normal fst-italic">(not required for LLII / DC Site)</i>
                            <span id="refNoOptionalHint" class="fw-normal fst-italic d-none">(not required for LLII / DC Site)</span>
                        </label>
                        <input type="text" id="removeReadonly" class="form-control font-mono capa-autofill" name="ref_no" readonly>
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">
                            Issued to <i class="fw-normal fst-italic">(Department)</i>
                        </label>
                        <select class="form-control" name="issued_to" id="issuedToSelect" required>
                            <option value="" disabled selected>Select department&hellip;</option>

                            @foreach (var d in ViewBag.Capa)
                            {
                                <option value="@d.DepartmentID">@d.DepartmentDescription</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Site Warehouse</label>
                        <select class="form-control" name="site_warehouse" id="siteWarehouseSelect" onchange="handleWarehouseChange()" required>
                            <option value="" disabled selected>Select warehouse&hellip;</option>
                            @foreach (var w in ViewBag.Warehouse)
                            {
                                <option value="@w.WarehouseID" data-code="@w.ExternalCode">@w.WarehouseName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Warehouse Code</label>
                        <input type="text" class="form-control font-mono" name="warehouse_code" id="warehouseCodeInput" placeholder="Auto-fills from selection" readonly>
                    </div>

                </div>

                <div class="row g-3 capa-grid">
                    <div class="col-md-6">
                        <div class="capa-panel" id="nonconformanceTypeSection">
                            <div class="capa-panel-title">
                                Type of Non-conformance <span>(select one)</span>
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                <input type="radio" class="btn-check" name="nonconformance_type" id="ncType1" value="ProductQualityFoodSafety" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                                <label class="capa-choice" for="ncType1">Product Quality &amp; Food Safety</label>

                                <input type="radio" class="btn-check" name="nonconformance_type" id="ncType2" value="EnvironmentHealthSafetySecurity" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                                <label class="capa-choice" for="ncType2">Environment, Health &amp; Safety, Security</label>

                                <input type="radio" class="btn-check" name="nonconformance_type" id="ncType3" value="InternalQualityAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                                <label class="capa-choice" for="ncType3">Internal Quality Audit</label>

                                <input type="radio" class="btn-check" name="nonconformance_type" id="ncType4" value="ExternalQualityAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                                <label class="capa-choice" for="ncType4">External Quality Audit</label>

                                <input type="radio" class="btn-check" name="nonconformance_type" id="ncType5" value="CustomerAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                                <label class="capa-choice" for="ncType5">Customer Audit</label>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-2 d-none" id="externalAuditSubWrap">
                                <input type="radio" class="btn-check" name="external_audit_subtype" id="eqaGov" value="Government" autocomplete="off" required>
                                <label class="capa-choice is-neutral" for="eqaGov">Government</label>

                                <input type="radio" class="btn-check" name="external_audit_subtype" id="eqa3rd" value="ThirdParty" autocomplete="off" required>
                                <label class="capa-choice is-neutral" for="eqa3rd">3rd Party</label>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="capa-panel" id="carClassificationSection">
                            <div class="capa-panel-title">
                                CAR Classification <span>(select one)</span>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="car_classification_type" id="carLlii" value="LLII" onchange="handleCarClassificationChange()" required>
                                    <label class="form-check-label" for="carLlii">LLII</label>
                                </div>
                                @* Supplier classification hidden.
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="car_classification_type" id="carSupplier" value="Supplier" onchange="handleCarClassificationChange()" required>
                                    <label class="form-check-label" for="carSupplier">Supplier</label>
                                </div>*@
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="car_classification_type" id="carTrucker" value="Trucker" onchange="handleCarClassificationChange()" required>
                                    <label class="form-check-label" for="carTrucker">Trucker</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="car_classification_type" id="carDcSite" value="DCSite" onchange="handleCarClassificationChange()" required>
                                    <label class="form-check-label" for="carDcSite">DC Site</label>
                                </div>

                            </div>
                            <div id="carClassificationDetail" class="main-form-group mt-2">
                                <select id="carSupplierSelect" class="form-control d-none" required onchange="handleSupplierChange()">
                                    <option value="" disabled selected>Select Supplier&hellip;</option>
                                    @foreach (var v in ViewBag.Vendor)
                                    {
                                        <option value="@v.VendorID" data-name="@v.VendorName" data-email="@v.EmailAddress">@v.VendorName (@v.EmailAddress)</option>
                                    }
                                </select>
                                <select id="carTruckerSelect" class="form-control d-none" required>
                                    <option value="" disabled selected>Select Trucker&hellip;</option>
                                    @foreach (var t in ViewBag.Truck)
                                    {
                                        <option value="@t.TruckID" data-name="@t.TruckerName" data-email="@t.EmailAddress">@t.TruckerName (@t.EmailAddress)</option>
                                    }
                                </select>
                                <select id="carDcSiteSelect" class="form-control d-none" required>
                                    <option value="" disabled selected>Select DC Site&hellip;</option>
                                    @foreach (var dc in ViewBag.DcSites)
                                    {
                                        var dcEmail = (dc.ExternalCode ?? "").ToString().ToLower() + "@leadlogistics.com.ph";
                                        <option value="@dc.ExternalCode" data-name="@dc.WarehouseName" data-email="@dcEmail">@dc.WarehouseName (@dcEmail)</option>
                                    }
                                </select>
                                <input type="text" id="carOtherText" class="form-control d-none" placeholder="name@leadlogistics.com.ph, name2@leadlogistics.com.ph" title="One or more email addresses, separated by a comma or semicolon" required>
                            </div>
                        </div>
                    </div>
                </div>

            </section>

            @Html.Partial("~/Views/Capa/_PartialView/_QualityFirstItem.cshtml")

            <div class="capa-add-row d-print-none">
                <button type="button" class="btn main-outline-btn" id="addItemBtn" onclick="addCapaItem()">
                    <i class="fa fa-plus-circle"></i> Add Item
                </button>
            </div>

            @Html.Partial("~/Views/Capa/_PartialView/_QualityItemTemplate.cshtml")

            @*<div class="d-flex justify-content-between text-secondary small border-top pt-3 font-mono">
                <span>QF-QAD-014 Rev 03</span>
                <span>Effectivity date: April 15, 2026</span>
            </div>*@

        </form>
    </div>
</div>


<script src="~/Scripts/capa/quality.js"></script>

<script>
	window.CAPA_CONFIG = {
		itemCatalogUrl: '@Url.Action("Catalog", "Capa")',
		defectCatalogUrl: '@Url.Action("DefectCatalog", "Capa")',
		vendorItemListUrl: '@Url.Action("VendorItemList", "Capa")',
		saveCapaReportUrl: '@Url.Action("SaveCapaReport", "Capa")',
		capaStatusUrl: '@Url.Action("CapaStatus", "Capa")'
	};
</script>
<script src="https://cdn.jsdelivr.net/npm/intro.js@7.2.0/minified/intro.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/intro.js@7.2.0/minified/introjs.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="@Url.Content("~/Scripts/capa/capa-form.js")?v=@DateTime.Now.Ticks"></script>
<script src="@Url.Content("~/Scripts/capa/capa-tour.js")?v=@DateTime.Now.Ticks"></script>
