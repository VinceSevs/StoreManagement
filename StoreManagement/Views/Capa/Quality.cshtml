
<style>
    :root {
        --bs-primary: #7d1f27;
        --bs-primary-rgb: 125,31,39;
        --bs-body-font-family: 'Inter', Arial, sans-serif;
        --bs-body-color: #241316;
        --bs-border-color: #e2d3d0;
        --bs-link-color: #7d1f27;
        --bs-link-hover-color: #4f1015;
    }

    body {
        background: var(--bs-body-bg);
    }

    h1, h2, h3, .brand-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
    }

    .font-mono {
        font-family: 'IBM Plex Mono', monospace;
    }

    .card {
        border-color: #e2d3d0;
    }

    .btn-primary {
        --bs-btn-bg: var(--bs-primary);
        --bs-btn-border-color: var(--bs-primary);
        --bs-btn-hover-bg: #5e161f;
        --bs-btn-hover-border-color: #5e161f;
        --bs-btn-active-bg: #5e161f;
        --bs-btn-active-border-color: #5e161f;
    }

    .btn-outline-primary {
        --bs-btn-color: var(--bs-primary);
        --bs-btn-border-color: var(--bs-primary);
        --bs-btn-hover-bg: var(--bs-primary);
        --bs-btn-hover-border-color: var(--bs-primary);
    }

    .btn-check:checked + .btn-outline-primary {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
        color: #fff;
    }

    .btn-check:checked + .btn-outline-secondary {
        background-color: #5b474a;
        border-color: #5b474a;
        color: #fff;
    }

    .form-check-input:checked {
        background-color: var(--bs-primary);
        border-color: var(--bs-primary);
    }

    .step-badge {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        background: var(--bs-primary);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: .8rem;
        font-family: 'Space Grotesk', sans-serif;
    }

    .brand-logo {
        height: 52px;
        width: auto;
    }

    .autocomplete-wrap {
        position: relative;
    }

    .ac-dropdown {
        position: absolute;
        z-index: 1000;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: .25rem;
        max-height: 230px;
        overflow-y: auto;
        display: none;
    }

        .ac-dropdown.open {
            display: block;
        }

        .ac-dropdown small {
            color: var(--bs-primary);
        }

    .attach-thumb {
        position: relative;
    }

        .attach-thumb img {
            aspect-ratio: 4/3;
            object-fit: cover;
        }

        .attach-thumb .btn-close {
            position: absolute;
            top: .5rem;
            right: .5rem;
            background-color: #fff;
            border-radius: 50%;
            padding: .35rem;
            opacity: .9;
            box-shadow: 0 1px 4px rgba(0,0,0,.25);
        }

    #submitStatus.text-success {
        color: #3f6b46 !important;
    }

    @@media print {
        .d-print-none {
            display: none !important;
        }

        body {
            background: #fff;
        }

        .card {
            box-shadow: none !important;
        }
    }

    /* Scoped to .capa-tour-tooltip / .capa-tour-highlight so other intro.js
    tours elsewhere in the app are untouched. */
    .capa-tour-tooltip.introjs-tooltip {
        font-family: 'Inter', Arial, sans-serif;
        max-width: 380px;
        border-radius: 16px;
        border: none;
        box-shadow: 0 20px 50px rgba(125, 31, 39, .25), 0 4px 12px rgba(0,0,0,.08);
        padding: 0;
        overflow: hidden;
        box-sizing: border-box;
    }

    .capa-tour-tooltip *,
    .capa-tour-tooltip *::before,
    .capa-tour-tooltip *::after {
        box-sizing: border-box;
    }

    /* Header row (title + skip button) — this is what was overflowing */
    .capa-tour-tooltip .introjs-tooltip-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        padding: 16px 16px 0;
        overflow: hidden;
    }

    .capa-tour-tooltip .introjs-tooltip-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1rem;
        line-height: 1.3;
        color: var(--bs-primary);
        flex: 1 1 auto;
        min-width: 0;
        margin: 0;
    }

    .capa-tour-tooltip .introjs-skipbutton {
        flex: none;
        position: static !important; /* override intro.js default absolute positioning */
        width: auto;
        height: auto;
        font-size: .72rem;
        font-weight: 600;
        color: #8f7d7b;
        background: #f6efee;
        border: none;
        border-radius: 999px;
        padding: 4px 10px;
        line-height: 1.4;
        white-space: nowrap;
    }

        .capa-tour-tooltip .introjs-skipbutton:hover {
            background: #eddedc;
            color: #5b474a;
        }

    .capa-tour-tooltip .introjs-tooltiptext {
        padding: 10px 20px 18px;
        font-size: .92rem;
        line-height: 1.55;
        color: #241316;
    }

    .capa-tour-tooltip .introjs-tooltipbuttons {
        border-top: 1px solid #f1e4e3;
        padding: 12px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: #fdfaf9;
        gap: 8px;
    }

    .capa-tour-tooltip .introjs-button {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: .82rem;
        padding: 7px 16px;
        border-radius: 999px;
        border: 1.5px solid var(--bs-primary);
        color: var(--bs-primary);
        background: #fff;
        text-shadow: none;
        transition: all .15s ease;
        white-space: nowrap;
    }

        .capa-tour-tooltip .introjs-button:hover {
            background: var(--bs-primary);
            color: #fff;
        }

    .capa-tour-tooltip .introjs-nextbutton,
    .capa-tour-tooltip .introjs-donebutton {
        background: var(--bs-primary);
        color: #fff;
    }

        .capa-tour-tooltip .introjs-nextbutton:hover,
        .capa-tour-tooltip .introjs-donebutton:hover {
            background: #5e161f;
            border-color: #5e161f;
        }

    .capa-tour-tooltip .introjs-disabled {
        opacity: .35;
        pointer-events: none;
    }

    .capa-tour-tooltip .introjs-progress {
        height: 5px;
        background: #f1e4e3;
        border-radius: 999px;
        margin: 0 20px 14px;
        overflow: hidden;
    }

    .capa-tour-tooltip .introjs-progressbar {
        background: linear-gradient(90deg, var(--bs-primary), #a8434a);
        border-radius: 999px;
    }

    .capa-tour-tooltip .introjs-arrow.top {
        border-bottom-color: #fff;
    }

    .capa-tour-tooltip .introjs-arrow.bottom {
        border-top-color: #fff;
    }

    .capa-tour-tooltip .introjs-arrow.left {
        border-right-color: #fff;
    }

    .capa-tour-tooltip .introjs-arrow.right {
        border-left-color: #fff;
    }

    /* Welcome / closing "cover" steps: no skip button clutter, centered title */
    .capa-tour-cover .introjs-tooltip-header {
        justify-content: center;
    }

    .capa-tour-cover .introjs-skipbutton {
        display: none;
    }

    .capa-tour-cover .introjs-tooltip-title {
        text-align: center;
        font-size: 1.15rem;
    }

    .capa-tour-cover .introjs-tooltiptext {
        text-align: center;
        font-size: 1rem;
    }

    /* Highlighted field + dimmed backdrop */
    .capa-tour-highlight {
        border-radius: 10px !important;
        box-shadow: 0 0 0 4px rgba(125,31,39,.35), 0 0 0 9999px rgba(36,19,22,.55) !important;
    }

    .introjs-overlay {
        background: rgba(36,19,22,.55);
    }

    @@media (max-width: 480px) {
        .capa-tour-tooltip.introjs-tooltip {
            max-width: 90vw;
        }
    }
</style>

<div class="container my-4">

    <div class="d-flex align-items-center justify-content-end gap-2 mb-3 d-print-none">
        <span id="submitStatus" class="me-auto small fw-semibold"></span>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="startFormTour()">
            <i class="bi bi-info-circle"></i> Take a Tour
        </button>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearForm()">Clear form</button>
        <button type="button" class="btn btn-primary btn-sm" id="submitBtn" onclick="submitCapaForm()">Submit to Database</button>

    </div>

    <form id="capaForm" class="card shadow-sm">
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-end border-bottom pb-3 mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="data:image/png;base64," class="brand-logo" alt="LEAD Logistics Innovations, Inc.">
                    <div>
                        <div class="text-uppercase small fw-semibold font-mono" style="color:var(--bs-primary);letter-spacing:.08em">Quality Assurance @*&middot; @ViewBag.ReportNumber*@</div>
                        <h1 class="h3 mb-0">Corrective Action Report</h1>
                        <div class="text-secondary small">Product Quality &amp; Food Safety Compliance</div>
                    </div>
                </div>
                <div class="text-end">
                    <label class="form-label small text-uppercase text-secondary mb-1">Date</label>
                    <input type="date" class="form-control font-mono" name="doc_date" id="docDateInput" value="@ViewBag.DateCreated" readonly>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">
                        Issued By <i class="fw-normal fst-italic text-lowercase">(Name / Department)</i>
                    </label>
                    <input type="text" class="form-control" name="issued_by" id="issuedByInput" value="@IsseERP.Models.MySession.Current.FullName" style="background-color:#f4e2e0" readonly>
                    <div class="form-text">
                        @if (string.IsNullOrWhiteSpace(IsseERP.Models.MySession.Current?.FullName))
                        {
                            <a href="@Url.Action("Login", "Home")">&middot; Login here</a>
                        }
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">
                        Ref. No. <i id="tempRefNoOptionalHint" class="fw-normal fst-italic text-lowercase">(not required for LLII / DC Site)</i>
                        <span id="refNoOptionalHint" class="fw-normal fst-italic text-lowercase d-none">(not required for LLII / DC Site)</span>
                    </label>
                    <input type="text" id="removeReadonly"class="form-control font-mono" name="ref_no" style="background-color:#f4e2e0" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">
                        Issued to <i class="fw-normal fst-italic text-lowercase">(Department)</i>
                    </label>
                    <select class="form-select" name="issued_to" id="issuedToSelect" required>
                        <option value="" disabled selected>Select department&hellip;</option>

                        @foreach (var d in ViewBag.Capa)
                        {
                            <option value="@d.DepartmentID">@d.DepartmentDescription</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">Site Warehouse</label>
                    <select class="form-select" name="site_warehouse" id="siteWarehouseSelect" onchange="handleWarehouseChange()" required>
                        <option value="" disabled selected>Select warehouse&hellip;</option>
                        @foreach (var w in ViewBag.Warehouse)
                        {
                            <option value="@w.WarehouseID" data-code="@w.ExternalCode">@w.WarehouseName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">Warehouse Code</label>
                    <input type="text" class="form-control font-mono" name="warehouse_code" id="warehouseCodeInput" placeholder="Auto-fills from selection" readonly>
                </div>

            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" style="border-left:4px solid var(--bs-primary) !important;">
                        <label class="form-label small text-uppercase text-secondary">Immediate Action Due Date</label>
                        <input type="date" class="form-control font-mono" name="correction_due" id="correctionDueInput" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" style="border-left:4px solid var(--bs-primary) !important;">
                        <label class="form-label small text-uppercase text-secondary">Corrective Action Due Date</label>
                        <input type="date" class="form-control font-mono" name="capa_due" id="capaDueInput" required>
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" id="nonconformanceTypeSection">
                        <div class="fw-semibold text-uppercase small mb-2" style="color:var(--bs-primary)">
                            Type of Non-conformance <span class="fw-normal text-secondary text-lowercase">(select one)</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <input type="radio" class="btn-check" name="nonconformance_type" id="ncType1" value="ProductQualityFoodSafety" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="ncType1">Product Quality &amp; Food Safety</label>

                            <input type="radio" class="btn-check" name="nonconformance_type" id="ncType2" value="EnvironmentHealthSafetySecurity" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="ncType2">Environment, Health &amp; Safety, Security</label>

                            <input type="radio" class="btn-check" name="nonconformance_type" id="ncType3" value="InternalQualityAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="ncType3">Internal Quality Audit</label>

                            <input type="radio" class="btn-check" name="nonconformance_type" id="ncType4" value="ExternalQualityAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="ncType4">External Quality Audit</label>

                            <input type="radio" class="btn-check" name="nonconformance_type" id="ncType5" value="CustomerAudit" onchange="handleNonconformanceTypeChange()" autocomplete="off" required>
                            <label class="btn btn-outline-primary btn-sm rounded-pill" for="ncType5">Customer Audit</label>
                        </div>
                        <div class="d-flex flex-wrap gap-2 mt-2 d-none" id="externalAuditSubWrap">
                            <input type="radio" class="btn-check" name="external_audit_subtype" id="eqaGov" value="Government" autocomplete="off" required>
                            <label class="btn btn-outline-secondary btn-sm rounded-pill" for="eqaGov">Government</label>

                            <input type="radio" class="btn-check" name="external_audit_subtype" id="eqa3rd" value="ThirdParty" autocomplete="off" required>
                            <label class="btn btn-outline-secondary btn-sm rounded-pill" for="eqa3rd">3rd Party</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" id="carClassificationSection">
                        <div class="fw-semibold text-uppercase small mb-2" style="color:var(--bs-primary)">
                            CAR Classification <span class="fw-normal text-secondary text-lowercase">(select one)</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="car_classification_type" id="carLlii" value="LLII" onchange="handleCarClassificationChange()" required>
                                <label class="form-check-label" for="carLlii">LLII</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="car_classification_type" id="carSupplier" value="Supplier" onchange="handleCarClassificationChange()" required>
                                <label class="form-check-label" for="carSupplier">Supplier</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="car_classification_type" id="carTrucker" value="Trucker" onchange="handleCarClassificationChange()" required>
                                <label class="form-check-label" for="carTrucker">Trucker</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="car_classification_type" id="carDcSite" value="DCSite" onchange="handleCarClassificationChange()" required>
                                <label class="form-check-label" for="carDcSite">DC Site</label>
                            </div>

                        </div>
                        <div id="carClassificationDetail" class="mt-2">
                            <select id="carSupplierSelect" class="form-select form-select-sm d-none" required onchange="handleSupplierChange()">
                                <option value="" disabled selected>Select Supplier&hellip;</option>
                                @foreach (var v in ViewBag.Vendor)
                                {
                                    <option value="@v.VendorID" data-name="@v.VendorName" data-email="@v.EmailAddress">@v.VendorName (@v.EmailAddress)</option>
                                }
                            </select>
                            <select id="carTruckerSelect" class="form-select form-select-sm d-none" required>
                                <option value="" disabled selected>Select Trucker&hellip;</option>
                                @foreach (var t in ViewBag.Truck)
                                {
                                    <option value="@t.TruckID" data-name="@t.TruckerName" data-email="@t.EmailAddress">@t.TruckerName (@t.EmailAddress)</option>
                                }
                            </select>
                            <select id="carDcSiteSelect" class="form-select form-select-sm d-none" required>
                                <option value="" disabled selected>Select DC Site&hellip;</option>
                                @foreach (var dc in ViewBag.DcSites)
                                {
                                    var dcEmail = (dc.ExternalCode ?? "").ToString().ToLower() + "@leadlogistics.com.ph";
                                    <option value="@dc.ExternalCode" data-name="@dc.WarehouseName" data-email="@dcEmail">@dc.WarehouseName (@dcEmail)</option>
                                }
                            </select>
                            <input type="text" id="carOtherText" class="form-control form-control-sm d-none" placeholder="Specify" required>
                        </div>
                    </div>
                </div>
            </div>

            <div class="capa-item-block" data-item-index="0" id="capaItemBlock0">
            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge me-2">1</span>Details of the Non-conformance</span>
                    <small class="text-secondary fst-italic">To be completed by Requestor</small>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Item Description <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <div class="autocomplete-wrap item-search-wrap">
                                <input type="text" class="form-control item-search" autocomplete="off"
                                       placeholder="Start typing, e.g. &ldquo;mini apple&rdquo;&hellip;" required>
                                <input type="hidden" class="item-field" data-field="item_id">
                                <div class="list-group ac-dropdown item-ac-dropdown shadow-sm"></div>
                            </div>
                            <select class="form-select item-vendor-select d-none">
                                <option value="" disabled selected>Select item&hellip;</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Item Code <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <input type="text" class="form-control font-mono item-code-display" placeholder="Auto-fills from selection" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Quantity of Affected Items <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <input type="number" min="0" class="form-control item-field" data-field="quantity" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Unit of Measure <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <select class="form-select item-field" data-field="uom_id" required>
                                @foreach (var u in ViewBag.UOM)
                                {
                                    if (string.Equals((string)u.Text, "Case", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@u.UOMID" selected>@u.Text - @u.IsoCode</option>
                                    }
                                    else
                                    {
                                        <option value="@u.UOMID">@u.Text - @u.IsoCode</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Defect Description <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <select class="form-select item-field defect-select" data-field="defect_category_id" required>
                                <option value="" disabled selected>Loading&hellip;</option>
                            </select>
                            <input type="text" class="form-control mt-2 d-none defect-other-input" placeholder="Specify the defect">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">Defect Category <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <input type="text" class="form-control font-mono defect-category-display" placeholder="Auto-fills from selection" readonly>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small text-uppercase text-secondary">UTD <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                            <input type="date" class="form-control item-field" data-field="used_to_date" required>
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label small text-uppercase text-secondary">Remarks</label>
                        <textarea class="form-control item-field" data-field="remarks" rows="4" placeholder="Describe what happened, when and where it was discovered, and which product, batch, or shipment is affected&hellip;" required></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge me-2">2</span>Photo / Document Attachments</span>
                    <small class="text-secondary fst-italic">Evidence photos, supporting documents, etc.</small>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                        <label class="btn btn-outline-primary btn-sm mb-0">
                            + Add file(s)
                            <input type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" multiple class="d-none item-attach-input">
                        </label>
                        <span class="small text-secondary fst-italic">Images, PDF, Word, or Excel &mdash; multiple files allowed. Stored only in this open page &mdash; nothing is uploaded anywhere.</span>
                    </div>
                    <div class="item-attach-empty text-secondary fst-italic small text-center py-3">No attachments added yet.</div>
                    <div class="item-attach-grid row row-cols-2 row-cols-md-3 g-3"></div>
                </div>
            </div>
            </div>

            <div class="d-flex mb-3">
                <button type="button" class="btn btn-outline-primary btn-sm" id="addItemBtn" onclick="addCapaItem()">
                    <i class="bi bi-plus-circle"></i> Add Item
                </button>
            </div>

            <template id="capaItemTemplate">
                <div class="capa-item-block">
                    <div class="card mb-3">
