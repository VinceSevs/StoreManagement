                                    <input type="text" class="form-control font-mono defect-category-display" placeholder="Auto-fills from selection" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">UTD <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                                    <input type="date" class="form-control item-field" data-field="used_to_date" required>
                                </div>
