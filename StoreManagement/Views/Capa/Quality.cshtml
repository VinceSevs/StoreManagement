                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Defect Description <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                                    <select class="form-select item-field defect-select" data-field="defect_category_id" required>
                                        <option value="" disabled selected>Loading&hellip;</option>
                                    </select>
