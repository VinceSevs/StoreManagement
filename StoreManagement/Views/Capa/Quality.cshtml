                                    <div class="autocomplete-wrap item-search-wrap">
                                        <input type="text" class="form-control item-search" autocomplete="off"
                                               placeholder="Start typing, e.g. &ldquo;mini apple&rdquo;&hellip;" required>
                                        <input type="hidden" class="item-field" data-field="item_id">
                                        <div class="list-group ac-dropdown item-ac-dropdown shadow-sm"></div>
                                    </div>
                                    <select class="form-select item-vendor-select d-none">
                                        <option value="" disabled selected>Select item&hellip;</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Item Code <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                                    <input type="text" class="form-control font-mono item-code-display" placeholder="Auto-fills from selection" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Quantity of Affected Items <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                                    <input type="number" min="0" class="form-control item-field" data-field="quantity" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Unit of Measure <span class="optional-hint d-none text-secondary fst-normal text-lowercase">(optional)</span></label>
                                    <select class="form-select item-field" data-field="uom_id" required>
