@using IsseERP.Models

<link href="~/Content/capa/capa.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<div class="main-list-page">

    <div class="capa-page is-narrow">

        <!-- =========================================
             CAR VERIFICATION HERO BANNER
             ========================================= -->

        <div class="main-hero is-record">

            <img class="main-hero-bg"
                 src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
                 alt="Warehouse logistics" />

            <div class="main-hero-gradient"></div>

            <div class="main-hero-content">

                <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                    <a href="@Url.Action("CapaStatus", "Capa")?token=@ViewBag.ResponseToken"
                       class="main-hero-back"
                       title="Back to Status"
                       aria-label="Back to Status">
                        <i class="fa fa-arrow-left"></i>
                    </a>
                    <a href="@Url.Action("CapaList", "Capa")">CAR</a>
                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                    <a href="@Url.Action("CapaStatus", "Capa")?token=@ViewBag.ResponseToken">Status</a>
                    <i class="fa fa-angle-right" aria-hidden="true"></i>
                    <span>Verification</span>
                </nav>

                <div class="main-hero-title-row">

                    <h2 class="main-hero-heading">Reference: @ViewBag.Capa.ReportNumber</h2>

                    @if (ViewBag.AlreadyVerified == true)
                    {
                        <span class="main-badge is-success">Already Verified</span>
                    }
                    else
                    {
                        <span class="main-badge is-info">Awaiting QA Verification</span>
                    }

                </div>

                <p class="main-hero-description">
                    Review the response, record the stock movement and confirm whether the corrective action was effective.
                </p>

                <div class="main-hero-features">

                    <div class="main-hero-feature">

                        <div class="main-hero-feature-icon">
                            <i class="fa fa-user"></i>
                        </div>

                        <div class="main-hero-feature-text">
                            <div class="main-hero-feature-label">Issued By</div>
                            <div class="main-hero-feature-desc">@ViewBag.Capa.IssuedBy</div>
                        </div>

                    </div>

                    <div class="main-hero-feature">

                        <div class="main-hero-feature-icon">
                            <i class="fa fa-building-o"></i>
                        </div>

                        <div class="main-hero-feature-text">
                            <div class="main-hero-feature-label">Site Warehouse</div>
                            <div class="main-hero-feature-desc">@ViewBag.Capa.SiteWarehouseName</div>
                        </div>

                    </div>

                    <div class="main-hero-feature">

                        <div class="main-hero-feature-icon">
                            <i class="fa fa-cubes"></i>
                        </div>

                        <div class="main-hero-feature-text">
                            <div class="main-hero-feature-label">Items</div>
                            <div class="main-hero-feature-desc">@ViewBag.Capa.Items.Count affected</div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <section class="capa-card">
            <div class="main-view-card-header">
                <h4>Response Summary</h4>
            </div>
            <div class="row g-3 capa-grid">
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Issued By</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IssuedBy" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Site Warehouse</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.SiteWarehouseName" readonly>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">Immediate Action Taken</label>
                    <textarea class="form-control readonly-field" rows="2" readonly>@ViewBag.Capa.ImmediateAction</textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IaPerson" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Date Completed</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.IaTargetDate != null ? ((DateTime)ViewBag.Capa.IaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">Root Cause Analysis</label>
                    <textarea class="form-control readonly-field" rows="2" readonly>@ViewBag.Capa.RootCause</textarea>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">Corrective Action</label>
                    <textarea class="form-control readonly-field" rows="2" readonly>@ViewBag.Capa.CapaActions</textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.CapaPerson" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Target Completion Date</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.CapaTargetDate != null ? ((DateTime)ViewBag.Capa.CapaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                </div>
            </div>
        </section>

        <section class="capa-card">
            <div class="main-view-card-header">
                <h4>Items</h4>
            </div>
            @{
                int itemNumber = 0;
                int photoIndex = 0;
                string headerHauler = ViewBag.Capa.Items.Count > 0 ? ViewBag.Capa.Items[0].Hauler : null;
            }
            @foreach (var capaItem in ViewBag.Capa.Items)
            {
                itemNumber++;
                int lineNumber = (int)capaItem.LineNumber;
                short? currentAdjustmentQty = capaItem.AdjustmentQty;
                int? currentAdjustmentBy = capaItem.AdjustmentBy;
                DateTime? currentAdjustmentDate = capaItem.AdjustmentDate;
                var itemPhotos = ViewBag.ItemAttachments.ContainsKey(lineNumber) ? ViewBag.ItemAttachments[lineNumber] : null;

                <div class="capa-item-card verification-item-block" data-line-number="@lineNumber">
                    <div class="capa-item-title">Item @itemNumber</div>
                    <div class="row g-3 capa-grid">
                        <div class="col-md-6 main-form-group">
                            <label class="form-label">Item</label>
                            <input type="text" class="form-control readonly-field" value="@capaItem.ItemDescription" readonly>
                        </div>
                        <div class="col-md-3 main-form-group">
                            <label class="form-label">Quantity</label>
                            <input type="text" class="form-control readonly-field" value="@capaItem.Quantity" readonly>
                        </div>
                        <div class="col-md-3 main-form-group">
                            <label class="form-label">Unit of Measure</label>
                            <input type="text" class="form-control readonly-field" value="@capaItem.UOMDisplay" readonly>
                        </div>
                        <div class="col-md-6 main-form-group">
                            <label class="form-label">Defect</label>
                            @{
                                var defectDisplay = string.IsNullOrWhiteSpace(capaItem.DefectName)
                                    ? "Other (Kindly Check Remarks)"
                                    : $"{capaItem.DefectName} ({capaItem.DefectCategoryName})";
                            }

                            <input type="text" class="form-control readonly-field" value="@defectDisplay" readonly>
                        </div>
                        <div class="col-md-6 main-form-group">
                            <label class="form-label">UTD</label>
                            <input type="text" class="form-control readonly-field font-mono" value="@(capaItem.UsedToDate != null ? ((DateTime)capaItem.UsedToDate).ToString("MMM dd, yyyy") : "")" readonly>
                        </div>
                        <div class="col-12 main-form-group">
                            <label class="form-label">Remarks</label>
                            <textarea class="form-control readonly-field" rows="2" readonly>@capaItem.Remarks</textarea>
                        </div>
                        @if (itemPhotos != null && itemPhotos.Count > 0)
                        {
                            <div class="col-12 main-form-group attached-photos-block">
                                <label class="form-label">Item @itemNumber Attached Photos </label>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var att in itemPhotos)
                                    {
                                        if (!string.IsNullOrEmpty(att.ContentType) && att.ContentType.StartsWith("image/"))
                                        {
                                            <button type="button" class="attach-thumb-btn" onclick="openLightbox(@photoIndex)">
                                                <img src="@Url.Action("CapaAttachment", "Capa")?path=@Uri.EscapeDataString(att.FilePath)"
                                                     class="capa-thumb" alt="Attachment"/>
                                            </button>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("CapaAttachment", "Capa")?path=@Uri.EscapeDataString(att.FilePath)" target="_blank"
                                               class="capa-thumb-file">
                                                <span>@(System.IO.Path.GetExtension(att.FilePath).TrimStart('.').ToUpperInvariant())</span>
                                                <small>@System.IO.Path.GetFileName(att.FilePath)</small>
                                            </a>
                                        }
                                        photoIndex++;
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </section>

        @if (ViewBag.AlreadyVerified == true)
        {
            <section class="capa-card">
                <div class="main-view-card-header">
                    <h4>Verification</h4>
                    <span class="main-badge is-success">Already Verified</span>
                </div>
                <div class="row g-3 capa-grid">
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Stock Movement</label>
                        <input type="text" class="form-control readonly-field" value="@(ViewBag.Capa.StockEventID == 2 ? "AUDIT" : ViewBag.Capa.StockEventID == 1 ? "OUT RIGHT" : "SA OUT")" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Accredited Hauler</label>
                        <input type="text" class="form-control readonly-field" value="@headerHauler" readonly>
                    </div>
                    <div class="col-md-6 main-form-group d-none">
                        <label class="form-label">Verified By</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IaVerifiedBy" readonly>
                    </div>
                    <div class="col-md-6 main-form-group d-none">
                        <label class="form-label">Verification Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.IaVerifiedDate != null ? ((DateTime)ViewBag.Capa.IaVerifiedDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-12 main-form-group">
                        <label class="form-label">Verification Notes</label>
                        <textarea class="form-control readonly-field" rows="2" readonly>@ViewBag.Capa.VerificationNotes</textarea>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Verified / Approved By</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.VerifiedByName" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.VerifiedDate != null ? ((DateTime)ViewBag.Capa.VerifiedDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                </div>
            </section>
        }
        else
        {
            int? headerVerifiedBy = ViewBag.Capa.VerifiedBy;

            <form id="verificationForm" class="capa-card">
                <div class="main-view-card-header">
                    <h4>Verification</h4>
                </div>
                <div class="row g-3 capa-grid">
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Stock Movement</label>
                        <input type="radio" class="btn-check" name="stock_event" id="stockEventSaOut" value="0" autocomplete="off">
                        <label class="capa-choice" for="stockEventSaOut">SA OUT</label>

                        <input type="radio" class="btn-check" name="stock_event" id="stockEventOutRight" value="1" autocomplete="off">
                        <label class="capa-choice" for="stockEventOutRight">OUT RIGHT</label>

                        <input type="radio" class="btn-check" name="stock_event" id="stockEventAudit" value="2" autocomplete="off">
                        <label class="capa-choice" for="stockEventAudit">AUDIT</label>
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Effectiveness</label>
                        <input type="radio" class="btn-check" name="effectiveness" id="effectivenessEffective" value="effective" autocomplete="off" checked>
                        <label class="capa-choice" for="effectivenessEffective">Effective</label>

                        <input type="radio" class="btn-check" name="effectiveness" id="effectivenessNotEffective" value="not_effective" autocomplete="off">
                        <label class="capa-choice" for="effectivenessNotEffective">Not Effective</label>
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Accredited Hauler</label>
                        <input type="text" class="form-control" id="hauler" value="@headerHauler">
                    </div>

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Verified / Approved By</label>
                        <input type="text" class="form-control capa-autofill" id="VerifiedBy" value="@IsseERP.Models.MySession.Current.FullName" readonly>
                        <div class="form-text">
                            @if (string.IsNullOrWhiteSpace(IsseERP.Models.MySession.Current?.FullName))
                            {
                                <a href="@Url.Action("Login", "Account")">&middot; Login here</a>
                            }
                        </div>
                    </div>

                    <div class="col-12 main-form-group">
                        <label class="form-label">Verification Notes</label>
                        <textarea class="form-control" name="VerificationNotes" id="verificationNotes" rows="2"></textarea>
                    </div>

                </div>
            </form>

            <div class="capa-actionbar is-plain">
                <span id="submitStatus" class="me-auto small fw-semibold"></span>
                <button type="button" class="btn main-form-save-btn" id="submitBtn" onclick="submitVerification()">Submit Verification</button>
            </div>
        }

    </div>

</div>
@Html.Partial("~/Views/Shared/_PartialView/_AttachmentLightbox.cshtml")

@{
    var photoList = new List<object>();
    if (ViewBag.ItemAttachments != null)
    {
        foreach (var itemPhotoList in ViewBag.ItemAttachments.Values)
        {
            foreach (var att in itemPhotoList)
            {
                photoList.Add(new
                {
                    url = Url.Action("CapaAttachment", "Capa") + "?path=" + Uri.EscapeDataString((string)att.FilePath),
                    caption = (string)att.Caption,
                    fileName = System.IO.Path.GetFileName((string)att.FilePath)
                });
            }
        }
    }
    var photoListJson = Newtonsoft.Json.JsonConvert.SerializeObject(photoList);

    var exportRows = new List<object>();
    foreach (var capaItem in ViewBag.Capa.Items)
    {
        exportRows.Add(new
        {
            reportNumber = (string)ViewBag.Capa.ReportNumber,
            issuedBy = (string)ViewBag.Capa.IssuedBy,
            siteWarehouse = (string)ViewBag.Capa.SiteWarehouseName,
            immediateAction = (string)ViewBag.Capa.ImmediateAction,
            iaPerson = (string)ViewBag.Capa.IaPerson,
            iaTargetDate = ViewBag.Capa.IaTargetDate != null ? ((DateTime)ViewBag.Capa.IaTargetDate).ToString("MMM dd, yyyy") : "",
            rootCause = (string)ViewBag.Capa.RootCause,
            capaActions = (string)ViewBag.Capa.CapaActions,
            capaPerson = (string)ViewBag.Capa.CapaPerson,
            capaTargetDate = ViewBag.Capa.CapaTargetDate != null ? ((DateTime)ViewBag.Capa.CapaTargetDate).ToString("MMM dd, yyyy") : "",
            itemDescription = (string)capaItem.ItemDescription,
            quantity = capaItem.Quantity,
            uom = (string)capaItem.UOMDisplay,
            defect = string.IsNullOrWhiteSpace((string)capaItem.DefectName) ? "Other (Kindly Check Remarks)" : $"{capaItem.DefectName} ({capaItem.DefectCategoryName})",
            utd = capaItem.UsedToDate != null ? ((DateTime)capaItem.UsedToDate).ToString("MMM dd, yyyy") : "",
            remarks = (string)capaItem.Remarks,
            hauler = (string)capaItem.Hauler
        });
    }
    var exportRowsJson = Newtonsoft.Json.JsonConvert.SerializeObject(exportRows);
}

<script>
window.CAPA_VERIFICATION_DATA = {
	responseToken: '@ViewBag.ResponseToken',
	submitEndpoint: '@Url.Action("SubmitVerification", "Capa")',
	attachmentPhotos: @Html.Raw(photoListJson),
	exportRows: @Html.Raw(exportRowsJson)
};
</script>
<script src="~/Scripts/capa/capa-verification.js"></script>
