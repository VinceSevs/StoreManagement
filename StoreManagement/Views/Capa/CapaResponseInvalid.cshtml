@{
    Layout = "~/Views/Shared/_BareLayout.cshtml";
    ViewBag.Title = "Link Not Valid";
}
<link href="~/Content/capa/capa.css" rel="stylesheet" />

<div class="capa-invalid">
    <div class="capa-card">
        <div class="capa-invalid-icon"><i class="fa fa-chain-broken"></i></div>
        <h4>Link Not Valid</h4>
        <p>
            This CAPA link is missing, expired, or no longer valid. Please double-check the link
            you were given, or contact QA if you believe this is a mistake.
        </p>
    </div>
</div>
