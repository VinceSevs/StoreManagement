        </div>
    </div>

    <div class="capa-panel">
        <div class="capa-toolbar">
            <input type="text" id="capaSearch" class="form-control capa-search" placeholder="Search CAR No., issued by">
            <select id="classificationFilter" class="form-select form-select-sm" style="width:auto;">
                <option value="">All Classifications</option>
                <option value="LLII">LLII</option>
                <option value="Supplier">Supplier</option>
                <option value="Trucker">Trucker</option>
                <option value="DCSite">DC Site</option>
            </select>
            <div class="d-flex align-items-center gap-1 ms-auto">
                <label class="small text-secondary mb-0">Created</label>
                <input type="date" id="exportDateFrom" class="form-control form-control-sm" style="width:150px" title="From date">
                <span class="small text-secondary">to</span>
                <input type="date" id="exportDateTo" class="form-control form-control-sm" style="width:150px" title="To date">
                <button type="button" class="btn btn-outline-primary btn-sm" id="exportExcelBtn" onclick="exportToExcel()">
                    <i class="bi bi-file-earmark-excel"></i> Export to Excel
                </button>
            </div>
            <span class="capa-count" id="capaCount"></span>
        </div>

        <div class="table-responsive">
            <table class="table capa-table" id="capaTable">
                <thead>
                    <tr>
                        <th style="cursor:pointer;user-select:none;" onclick="toggleDateIssuedSort()">
                            Date Issued <i class="bi bi-arrow-down-up sort-icon" id="dateIssuedSortIcon" style="font-size:.7rem;"></i>
                        </th>
                        <th style="cursor:pointer;user-select:none;" onclick="toggleCarNoSort()">
                            Car No. <i class="bi bi-arrow-down-up sort-icon" id="carNoSortIcon" style="font-size:.7rem;"></i>
                        </th>
