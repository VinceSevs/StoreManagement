@model List<IsseERP.Models.CapaReportModel>
@using System.Linq
<link href="~/Content/capa/capa.css" rel="stylesheet" />

@{
    int totalCount = Model?.Count ?? 0;
    int awaitingResponseCount = 0;
    int awaitingVerificationCount = 0;
    int closedCount = 0;
    int cancelledCount = 0;

    Func<IsseERP.Models.CapaReportModel, string> computeStatusKey = c => c.StatusKey;

    var itemsByCar = new Dictionary<string, List<object>>();

    if (Model != null)
    {
        foreach (var c in Model)
        {
            switch (computeStatusKey(c))
            {
                case "response": awaitingResponseCount++; break;
                case "verify": awaitingVerificationCount++; break;
                case "closed": closedCount++; break;
                case "cancelled": cancelledCount++;  break;
            }

            itemsByCar[c.ReportNumber] = (c.Items ?? new List<IsseERP.Models.CapaItemModel>())
                .Select(i => (object)new
                {
                    itemCode = i.ItemCode,
                    itemDescription = i.ItemDescription,
                    utd = i.UsedToDate.HasValue ? i.UsedToDate.Value.ToString("MMM dd, yyyy") : "",
                    uom = i.UOMDisplay,
                    quantity = i.Quantity,
                    defectName = i.DefectName
                })
                .ToList();
        }
    }

    var itemsByCarJson = Newtonsoft.Json.JsonConvert.SerializeObject(itemsByCar);

    ViewData["CapaList_ComputeStatusKey"] = computeStatusKey;
}

<div class="main-list-page">

    <!-- =========================================
         CAR HERO BANNER
         ========================================= -->

    <div class="main-hero">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Warehouse logistics" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <div class="main-hero-eyebrow">
                CAR
            </div>

            <h2 class="main-hero-heading">
                Corrective Action Requests
            </h2>

            <p class="main-hero-description">
                Raise, track and verify corrective actions for product quality and food safety findings.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-pencil-square-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Raise a CAR</div>
                        <div class="main-hero-feature-desc">Report a non-conformance</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-clock-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Track Responses</div>
                        <div class="main-hero-feature-desc">Follow every due date</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-check-circle"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Verify &amp; Close</div>
                        <div class="main-hero-feature-desc">Confirm the fix worked</div>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         STATUS SUMMARY
         ========================================= -->

    <div class="capa-stat-grid">
        <button type="button" class="capa-stat is-active" data-status="all">
            <span class="capa-stat-value">@totalCount</span>
            <span class="capa-stat-label">Total</span>
        </button>
        <button type="button" class="capa-stat is-warning" data-status="response">
            <span class="capa-stat-value">@awaitingResponseCount</span>
            <span class="capa-stat-label">Awaiting Response</span>
        </button>
        <button type="button" class="capa-stat is-info" data-status="verify">
            <span class="capa-stat-value">@awaitingVerificationCount</span>
            <span class="capa-stat-label">Awaiting Verification</span>
        </button>
        <button type="button" class="capa-stat is-success" data-status="closed">
            <span class="capa-stat-value">@closedCount</span>
            <span class="capa-stat-label">Closed</span>
        </button>
        <button type="button" class="capa-stat is-brand" data-status="cancelled">
            <span class="capa-stat-value">@cancelledCount</span>
            <span class="capa-stat-label">Cancelled</span>
        </button>
    </div>


    <!-- =========================================
         SEARCH / FILTER
         ========================================= -->

    <div class="main-list-toolbar">

        <div class="main-list-search">

            <div class="input-group">

                <input type="text"
                       id="capaSearch"
                       class="form-control"
                       placeholder="Search CAR No., issued by..."
                       aria-label="Search CAR reports" />

                <span class="input-group-btn">

                    <button type="button"
                            class="btn main-list-search-btn"
                            id="capaSearchBtn"
                            title="Search">

                        <i class="fa fa-search"></i>

                        <span class="main-list-search-btn-text">Search</span>

                    </button>

                </span>

            </div>

        </div>

        <div class="capa-toolbar-filter">
            <select id="classificationFilter" class="form-control" aria-label="Filter by classification">
                <option value="">All Classifications</option>
                <option value="LLII">LLII</option>
                @*<option value="Supplier">Supplier</option>*@
                <option value="Trucker">Trucker</option>
                <option value="DCSite">DC Site</option>
            </select>
        </div>

        <div class="capa-export">
            <label for="exportDateFrom">Created</label>
            <input type="date" id="exportDateFrom" class="form-control" title="From date">
            <label for="exportDateTo">to</label>
            <input type="date" id="exportDateTo" class="form-control" title="To date">
            <button type="button" class="btn main-outline-btn" id="exportExcelBtn" onclick="exportToExcel()">
                <i class="fa fa-file-excel-o"></i> Export to Excel
            </button>
        </div>

        <a href="@Url.Action("Quality", "Capa")" class="btn main-list-add-btn" title="Raise a new CAR">
            <i class="fa fa-plus"></i>
            <span class="main-list-add-btn-text">New CAR</span>
        </a>

    </div>


    <!-- =========================================
         CAR TABLE
         ========================================= -->

    <div class="main-list-table-wrapper">

        @Html.Partial("~/Views/Capa/_PartialView/_CapaListTable.cshtml", Model)

    </div>


    <!-- =========================================
         PAGINATION
         ========================================= -->

    <div class="main-list-pagination" id="capaPaginationBar">

        <div class="main-pagination-summary" id="capaPageInfo"></div>

        <div class="capa-count" id="capaCount"></div>

        <div class="main-pagination-controls" id="capaPagination"></div>

        <div class="capa-page-jump">
            <input type="number" min="1" class="form-control" id="capaPageJumpInput" placeholder="Page #" aria-label="Jump to page">
            <button class="btn main-outline-btn" type="button" id="capaPageJumpBtn">Go</button>
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
	window.CAPA_LIST_DATA = {
		itemsByCar: @Html.Raw(itemsByCarJson),
		totalCount: @totalCount,
		logCapaActionUrl: '@Url.Action("LogCapaAction", "Capa")'
	};
</script>
<script src="~/Scripts/capa/capa-list.js"></script>
