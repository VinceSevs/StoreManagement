@using IsseERP.Models
@{
    Layout = "~/Views/Shared/_BareLayout.cshtml";
    ViewBag.Title = "CAR Response";
}
<link href="~/Content/capa/capa.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="capa-public">

    <!-- =========================================
         CAR RESPONSE HERO BANNER
         ========================================= -->

    <div class="main-hero is-record">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Warehouse logistics" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <div class="main-hero-eyebrow">
                CAR RESPONSE
            </div>

            <div class="main-hero-title-row">

                <h2 class="main-hero-heading">Reference: @ViewBag.Capa.ReportNumber</h2>

                @if (ViewBag.AlreadyResponded != true && ViewBag.Status == "Cancelled")
                {
                    <span class="main-badge is-brand">Already Cancelled</span>
                }

            </div>

            <p class="main-hero-description">
                Review the non-conformance below and send your immediate action, root cause and corrective action.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-user"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Issued By</div>
                        <div class="main-hero-feature-desc">@ViewBag.Capa.IssuedBy</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-building-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Site Warehouse</div>
                        <div class="main-hero-feature-desc">@ViewBag.Capa.SiteWarehouseName</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    @Html.Partial("~/Views/Capa/_PartialView/_CapaResponseSummary.cshtml")

    @if (ViewBag.AlreadyResponded == true)
    {
        <section class="capa-card">
            <div class="main-view-card-header">
                <h4>Your Response</h4>
                <span class="main-badge">Already Submitted</span>
            </div>
            <div class="capa-notice">
                <i class="fa fa-info-circle"></i>
                <span>A response has already been submitted for this CAPA. If you need to make changes, please contact QA directly.</span>
            </div>
            <div class="row g-3 capa-grid">
                <div class="col-12 main-form-group">
                    <label class="form-label">@*Correction /*@ Immediate Action Taken</label>
                    <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.ImmediateAction</textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IaPerson" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Date Completed</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.IaTargetDate != null ? ((DateTime)ViewBag.Capa.IaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                </div>
                <div class="col-12 main-form-group">
                    <label class="form-label">Root Cause Analysis</label>
                    <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.RootCause</textarea>
                </div>
                <div class="col-12 main-form-group">
                    <label class="form-label">@*Corrective /*@ Corrective Action</label>
                    <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.CapaActions</textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.CapaPerson" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Target Completion Date</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.CapaTargetDate != null ? ((DateTime)ViewBag.Capa.CapaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                </div>
            </div>
        </section>
    }
    else if (ViewBag.Status == "Cancelled")
    {
        <section class="capa-card">
            <div class="main-view-card-header">
                <h4>Your Response</h4>
                <span class="main-badge is-brand">Cancelled</span>
            </div>
            <div class="capa-notice is-brand mb-0">
                <i class="fa fa-ban"></i>
                <span>A response cannot be submitted for this CAPA as it has been cancelled. If you have any questions, please contact QA directly.</span>
            </div>
        </section>
    }
    else
    {
        <form id="responseForm" class="capa-card">
            <div class="main-view-card-header">
                <h4>Your Response</h4>
            </div>
            <div class="row g-3 capa-grid">
                <div class="col-12 main-form-group">
                    <label class="form-label">@*Correction /*@ Immediate Action Taken</label>
                    <textarea class="form-control" name="ImmediateAction" id="immediateAction" rows="3" required></textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control capa-autofill" name="IaPerson" id="iaPerson"
                           value="@(!string.IsNullOrEmpty(ViewBag.Capa?.CarClassificationRefEmail) ? ViewBag.Capa?.CarClassificationRefEmail : ViewBag.Capa?.CarClassificationOtherText)"
                           readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Date Completed</label>
                    <input type="date" class="form-control font-mono" name="IaTargetDate" id="iaTargetDate" value="" required>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">Root Cause Analysis</label>
                    <textarea class="form-control" name="RootCause" id="rootCause" rows="3" placeholder="5 Why, Fishbone, Pareto, etc." required></textarea>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">@*Corrective /*@ Corrective Action</label>
                    <textarea class="form-control" name="CapaActions" id="capaActions" rows="3" required></textarea>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Person Responsible</label>
                    <input type="text" class="form-control capa-autofill" name="CapaPerson" id="capaPerson" value="@(!string.IsNullOrEmpty(ViewBag.Capa?.CarClassificationRefEmail) ? ViewBag.Capa?.CarClassificationRefEmail : ViewBag.Capa?.CarClassificationOtherText)" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Target Completion Date</label>
                    <input type="date" class="form-control font-mono" name="CapaTargetDate" id="capaTargetDate" value="" required>
                </div>

                <div class="col-12 main-form-group">
                    <label class="form-label">
                        Supporting Document / Photo <span class="fw-normal fst-italic text-secondary">(optional)</span>
                    </label>
                    <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                        <label for="responseAttachInput" class="btn main-outline-btn mb-0 d-inline-flex align-items-center"><i class="fa fa-paperclip"></i> Add file(s)</label>
                        <input type="file" id="responseAttachInput" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" multiple class="d-none" onchange="handleResponseAttachFiles(event)">
                        <span class="capa-muted">Images, PDF, Word, or Excel &mdash; multiple files allowed.</span>
                    </div>
                    <div id="responseAttachGrid" class="row row-cols-2 row-cols-md-3 g-2"></div>
                </div>
            </div>
        </form>

        <div class="capa-actionbar is-plain">
            <span id="submitStatus" class="me-auto small fw-semibold"></span>
            <button type="button" class="btn main-form-save-btn" id="submitBtn" onclick="submitResponse()">Submit Response</button>
        </div>
    }

</div>

@Html.Partial("~/Views/Shared/_PartialView/_AttachmentLightbox.cshtml")

@{
    var photoList = new List<object>();
    if (ViewBag.Attachments != null)
    {
        foreach (var att in ViewBag.Attachments)
        {
            photoList.Add(new
            {
                url = Url.Action("CapaAttachment", "Capa") + "?path=" + Uri.EscapeDataString((string)att.FilePath),
                caption = (string)att.Caption,
                fileName = System.IO.Path.GetFileName((string)att.FilePath)
            });
        }
    }
    var photoListJson = Newtonsoft.Json.JsonConvert.SerializeObject(photoList);
}

<script>
window.CAPA_RESPONSE_DATA = {
	responseToken: '@ViewBag.ResponseToken',
	submitEndpoint: '@Url.Action("SubmitCapaResponse", "Capa")',
	attachmentPhotos: @Html.Raw(photoListJson)
};
</script>
<script src="~/Scripts/capa/capa-response.js"></script>
