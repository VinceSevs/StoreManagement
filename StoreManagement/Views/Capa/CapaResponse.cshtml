@using IsseERP.Models
<link href="~/Content/capa/capa-response.css" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="container my-4" style="max-width: 760px;">

    <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
        <img src="data:image/png;base64," class="brand-logo" alt="LEAD Logistics Innovations, Inc.">
        <div class="flex-grow-1">
            <div class="text-uppercase small fw-semibold font-mono" style="color:var(--bs-primary);letter-spacing:.08em">CAR Response</div>
            <h1 class="h4 mb-0">Reference: @ViewBag.Capa.ReportNumber</h1>
        </div>

        @if (ViewBag.AlreadyResponded != true && ViewBag.Status == "Cancelled")
        {
            <div class="text-end">
                <span id="capaResponseStatusBadge" class="badge bg-dark px-3 py-2 d-none mb-1">Closed</span>
                <div class="small text-uppercase text-secondary fw-semibold">Already Cancelled</div>
            </div>
        }
        else if (ViewBag.AlreadyResponded != true)
        {
            <div class="text-end">
                <span id="capaResponseStatusBadge" class="badge bg-dark px-3 py-2 d-none mb-1">Closed</span>
            </div>
        }
        else
        {
            <div class="text-end">
                <span id="capaResponseStatusBadge" class="badge bg-dark px-3 py-2 d-none mb-1">Closed</span>
            </div>
        }

    </div>

    <div class="card mb-3">
        <div class="card-header bg-white fw-semibold">Non-conformance Summary</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">Issued By</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IssuedBy" readonly>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">Site Warehouse</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.SiteWarehouseName" readonly>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">Report Due</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@ViewBag.Capa.ReportDueDate.ToString("MMM dd, yyyy")" readonly>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary">CAR Due</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@ViewBag.Capa.ReportDueDate.ToString("MMM dd, yyyy")" readonly>
                </div>
                <div class="col-12">
                    @{ int itemNumber = 0; int photoIndex = 0; }
                    @foreach (var capaItem in ViewBag.Capa.Items)
                    {
                        itemNumber++;
                        int lineNumber = (int)capaItem.LineNumber;
                        var itemPhotos = ViewBag.ItemAttachments.ContainsKey(lineNumber) ? ViewBag.ItemAttachments[lineNumber] : null;
                        <div class="border rounded p-3 mb-2">
                            <div class="fw-semibold text-uppercase small mb-2" style="color:var(--bs-primary)">Item @itemNumber</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Item</label>
                                    <input type="text" class="form-control readonly-field" value="@capaItem.ItemDescription" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Quantity</label>
                                    <input type="text" class="form-control readonly-field" value="@capaItem.Quantity" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Unit of Measure</label>
                                    <input type="text" class="form-control readonly-field" value="@capaItem.UOMDisplay" readonly>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small text-uppercase text-secondary">Defect</label>
                                    @{ 
                                        var defectDisplay = string.IsNullOrWhiteSpace(capaItem.DefectName)
                                            ? "Other (Kindly Check Remarks)"
                                            : $"{capaItem.DefectName} ({capaItem.DefectCategoryName})";
                                    }

                                    <input type="text" class="form-control readonly-field" value="@defectDisplay" readonly>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small text-uppercase text-secondary">Remarks</label>
                                    <textarea class="form-control readonly-field" rows="2" readonly>@capaItem.Remarks</textarea>
                                </div>
                                @if (itemPhotos != null && itemPhotos.Count > 0)
                                {
                                    <div class="col-12">
                                        <label class="form-label small text-uppercase text-secondary">Attached Photos</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            @foreach (var att in itemPhotos)
                                            {
                                                if (!string.IsNullOrEmpty(att.ContentType) && att.ContentType.StartsWith("image/"))
                                                {
                                                    <button type="button" class="attach-thumb-btn" onclick="openLightbox(@photoIndex)">
                                                        <img src="@Url.Action("CapaAttachment", "Capa")?path=@Uri.EscapeDataString(att.FilePath)"
                                                             style="width:140px;height:105px;object-fit:cover;border:1px solid #e2d3d0;border-radius:8px;" alt="Attachment">
                                                    </button>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("CapaAttachment", "Capa")?path=@Uri.EscapeDataString(att.FilePath)" target="_blank"
                                                       class="d-flex flex-column align-items-center justify-content-center text-decoration-none text-secondary"
                                                       style="width:140px;height:105px;border:1px solid #e2d3d0;border-radius:8px;background:#f6efee;">
                                                        <span style="font-size:1.6rem;line-height:1;">@(System.IO.Path.GetExtension(att.FilePath).TrimStart('.').ToUpperInvariant())</span>
                                                        <small class="text-truncate px-2" style="max-width:90%;">@System.IO.Path.GetFileName(att.FilePath)</small>
                                                    </a>
                                                }
                                                photoIndex++;
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (ViewBag.AlreadyResponded == true)
    {
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold d-flex align-items-center justify-content-between">
                <span>Your Response</span>
                <span class="badge bg-secondary fw-normal">Already Submitted</span>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary small mb-3">
                    A response has already been submitted for this CAPA. If you need to make changes, please contact QA directly.
                </div>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">@*Correction /*@ Immediate Action Taken</label>
                        <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.ImmediateAction</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Person Responsible</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IaPerson" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Date Completed</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.IaTargetDate != null ? ((DateTime)ViewBag.Capa.IaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">Root Cause Analysis</label>
                        <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.RootCause</textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">@*Corrective /*@ Corrective Action</label>
                        <textarea class="form-control readonly-field" rows="3" readonly>@ViewBag.Capa.CapaActions</textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Person Responsible</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.CapaPerson" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Target Completion Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.CapaTargetDate != null ? ((DateTime)ViewBag.Capa.CapaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (ViewBag.Status == "Cancelled")
    {
        <div class="card mb-3">
            <div class="card-header bg-white fw-semibold d-flex align-items-center justify-content-between">
                <span>Your Response</span>
                <span class="badge @*bg-danger*@ fw-normal" style="background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-dark) 200%);">Cancelled</span>
            </div>
            <div class="card-body">
                <div class="alert alert-danger small mb-3" style="background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-dark) 200%);">
                    A response cannot be submitted for this CAPA as it has been cancelled. If you have any questions, please contact QA directly.
                </div>

            </div>
        </div>
    }
    else
    {
        <form id="responseForm" class="card mb-3">
            <div class="card-header bg-white fw-semibold">Your Response</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">@*Correction /*@ Immediate Action Taken</label>
                        <textarea class="form-control" name="ImmediateAction" id="immediateAction" rows="3" required></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Person Responsible</label>
                        <input type="text" class="form-control" name="IaPerson" id="iaPerson" style="background-color:#f4e2e0"
                               value="@(!string.IsNullOrEmpty(ViewBag.Capa?.CarClassificationRefEmail) ? ViewBag.Capa?.CarClassificationRefEmail : ViewBag.Capa?.CarClassificationOtherText)"
                               readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Date Completed</label>
                        <input type="date" class="form-control font-mono" name="IaTargetDate" id="iaTargetDate" value="" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">Root Cause Analysis</label>
                        <textarea class="form-control" name="RootCause" id="rootCause" rows="3" placeholder="5 Why, Fishbone, Pareto, etc." required></textarea>
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">@*Corrective /*@ Corrective Action</label>
                        <textarea class="form-control" name="CapaActions" id="capaActions" rows="3" required></textarea>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Person Responsible</label>
                        <input type="text" class="form-control" style="background-color:#f4e2e0" name="CapaPerson" id="capaPerson" value="@(!string.IsNullOrEmpty(ViewBag.Capa?.CarClassificationRefEmail) ? ViewBag.Capa?.CarClassificationRefEmail : ViewBag.Capa?.CarClassificationOtherText)" readonly>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small text-uppercase text-secondary">Target Completion Date</label>
                        <input type="date" class="form-control font-mono" name="CapaTargetDate" id="capaTargetDate" value="" required>
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-uppercase text-secondary">
                            Supporting Document / Photo <span class="fw-normal fst-italic text-lowercase">(optional)</span>
                        </label>
                        <div class="d-flex align-items-center gap-3 mb-2 flex-wrap">
                            <label for="responseAttachInput" class="btn btn-outline-primary btn-sm mb-0">+ Add file(s)</label>
                            <input type="file" id="responseAttachInput" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" multiple class="d-none" onchange="handleResponseAttachFiles(event)">
                            <span class="small text-secondary fst-italic">Images, PDF, Word, or Excel &mdash; multiple files allowed.</span>
                        </div>
                        <div id="responseAttachGrid" class="row row-cols-2 row-cols-md-3 g-2"></div>
                    </div>
                </div>
            </div>
        </form>

        <div class="d-flex align-items-center gap-2">
            <span id="submitStatus" class="me-auto small fw-semibold"></span>
            <button type="button" class="btn btn-primary" id="submitBtn" onclick="submitResponse()">Submit Response</button>
        </div>
    }

</div>

<div class="lightbox-overlay" id="lightboxOverlay" onclick="handleOverlayClick(event)">
    <span class="lightbox-counter" id="lightboxCounter"></span>
    <button type="button" class="lightbox-btn lightbox-prev" id="lightboxPrev" onclick="showLightboxPhoto(currentLightboxIndex - 1)" title="Previous">&#8249;</button>
    <img id="lightboxImage" class="lightbox-img" src="" alt="Attachment preview">
    <button type="button" class="lightbox-btn lightbox-next" id="lightboxNext" onclick="showLightboxPhoto(currentLightboxIndex + 1)" title="Next">&#8250;</button>
    <a id="lightboxDownload" class="lightbox-btn lightbox-download" href="#" download title="Download">&#8681;</a>
    <button type="button" class="lightbox-btn lightbox-close" onclick="closeLightbox()" title="Close">&#10005;</button>
    <div class="lightbox-caption" id="lightboxCaption"></div>
</div>

@{
    var photoList = new List<object>();
    if (ViewBag.Attachments != null)
    {
        foreach (var att in ViewBag.Attachments)
        {
            photoList.Add(new
            {
                url = Url.Action("CapaAttachment", "Capa") + "?path=" + Uri.EscapeDataString((string)att.FilePath),
                caption = (string)att.Caption,
                fileName = System.IO.Path.GetFileName((string)att.FilePath)
            });
        }
    }
    var photoListJson = Newtonsoft.Json.JsonConvert.SerializeObject(photoList);
}

<script>
window.CAPA_RESPONSE_DATA = {
	responseToken: '@ViewBag.ResponseToken',
	submitEndpoint: '@Url.Action("SubmitCapaResponse", "Capa")',
	closeIfOverdueEndpoint: '@Url.Action("CloseIfOverdue", "Capa")',
	attachmentPhotos: @Html.Raw(photoListJson)
};
</script>
<script src="~/Scripts/capa/capa-response.js"></script>
