<link href="~/Content/capa/capa.css" rel="stylesheet" />

@{
    string ImmediateAction = (string)ViewBag.Capa.ImmediateAction;
    string RootCause = (string)ViewBag.Capa.RootCause;
    string CapaActions = (string)ViewBag.Capa.CapaActions;
    string IaVerifiedBy = (string)ViewBag.Capa.IaVerifiedBy;
    string CapaVerifiedBy = (string)ViewBag.Capa.CapaVerifiedBy;
    bool step2Done = !string.IsNullOrWhiteSpace(ImmediateAction);
    bool step2Verified = !string.IsNullOrWhiteSpace(IaVerifiedBy);
    bool step3Done = !string.IsNullOrWhiteSpace(RootCause);
    bool step4Done = !string.IsNullOrWhiteSpace(CapaActions);
    bool step4Verified = !string.IsNullOrWhiteSpace(CapaVerifiedBy);
    string overallStatus;
    string overallBadgeClass;
    switch ((string)ViewBag.Capa.StatusKey)
    {
        case "cancelled":
            overallStatus = "Cancelled";
            overallBadgeClass = "is-brand";
            break;
        case "response":
            overallStatus = "Awaiting Response";
            overallBadgeClass = "is-warning";
            break;
        case "verify":
            overallStatus = "Awaiting QA Verification";
            overallBadgeClass = "is-info";
            break;
        default:
            overallStatus = "Closed";
            overallBadgeClass = "is-success";
            break;
    }
}

@{
    bool isAwaitingVerification = overallStatus == "Awaiting QA Verification";
    bool isCancel = overallStatus == "Awaiting Response";
}

<div class="main-list-page">

    <!-- =========================================
         CAR STATUS HERO BANNER
         ========================================= -->

    <div class="main-hero is-record d-print-none">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Warehouse logistics" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("CapaList", "Capa")"
                   class="main-hero-back"
                   title="Back to CAR Reports"
                   aria-label="Back to CAR Reports">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <a href="@Url.Action("CapaList", "Capa")">CAR</a>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span>Status</span>
            </nav>

            <div class="main-hero-title-row">

                <h2 class="main-hero-heading">Reference: @ViewBag.Capa.ReportNumber</h2>

                <span class="main-badge @overallBadgeClass">@overallStatus</span>

            </div>

            <p class="main-hero-description">
                Follow this report from filing to response, QA verification and closure.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-user"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Issued By</div>
                        <div class="main-hero-feature-desc">@ViewBag.Capa.IssuedBy</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-building-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Site Warehouse</div>
                        <div class="main-hero-feature-desc">@ViewBag.Capa.SiteWarehouseName</div>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="capa-sheet capa-actionbar is-plain is-end d-print-none">
        @if (isAwaitingVerification)
        {
            <a href="@Url.Action("CapaVerification", "Capa")?token=@ViewBag.Capa.ResponseToken" class="btn main-form-save-btn">
                <i class="fa fa-check-square-o"></i> Verify
            </a>
        }
        else if (isCancel)
        {
            <button type="button" class="btn main-form-save-btn" id="cancelCarBtn" onclick="cancelCar()">
                Cancel CAR
            </button>
        }
        <button type="button" class="btn main-outline-btn" id="downloadPdfBtn" onclick="downloadCapaStatusPdf()">
            <i class="fa fa-download"></i> Download PDF
        </button>
        <button type="button" class="btn main-outline-btn" id="printPalletTagsBtn" onclick="printPalletTags()">
            <i class="fa fa-tags"></i> Print Pallet Tags
        </button>
    </div>

    <div class="capa-sheet" id="capaStatusPrintArea">

        <div class="capa-sheet-head">
            <img src="@Url.Content("~/Content/images/icon-dark-LLII.png")" alt="LEAD Logistics Innovations, Inc.">
            <div class="capa-sheet-title">
                <div class="capa-sheet-eyebrow">CAR Status</div>
                <h3>Reference: @ViewBag.Capa.ReportNumber</h3>
            </div>
            <span class="main-badge @overallBadgeClass">@overallStatus</span>
        </div>

        <section class="capa-card stage-card capa-stage">
            <div class="main-view-card-header">
                <h4><span class="capa-step">1</span>Filing Details</h4>
                <span class="main-badge stage-badge">Filed</span>
            </div>
            <div class="row g-3 capa-grid">
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Issued By</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IssuedBy" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Issued To</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IssuedToDepartmentName" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Site Warehouse</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.SiteWarehouseName" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Ref. No. (QAR / PNCR)</label>
                    <input type="text" class="form-control readonly-field font-mono" value="@ViewBag.Capa.RefNo" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">Type of Non-conformance</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.NonconformanceType" readonly>
                </div>
                <div class="col-md-6 main-form-group">
                    <label class="form-label">CAR Classification</label>
                    <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.CarClassificationType &mdash; @(!string.IsNullOrWhiteSpace((string)ViewBag.Capa.CarClassificationRefName) ? ViewBag.Capa.CarClassificationRefName : ViewBag.Capa.CarClassificationOtherText)" readonly>
                </div>
                @if (step4Verified || step2Verified)
                {
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Stock Movement</label>
                        <input type="text" class="form-control readonly-field" value="@(string.IsNullOrWhiteSpace((string)ViewBag.Capa.IaVerifiedBy) ? "Not yet set" : (ViewBag.Capa.StockEventID == 2 ? "AUDIT" : ViewBag.Capa.StockEventID == 1 ? "OUT RIGHT" : "SA OUT"))" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Accredited Hauler</label>
                        <input type="text" class="form-control readonly-field" value="@(ViewBag.Capa.Items.Count > 0 ? ViewBag.Capa.Items[0].Hauler : null)" readonly>
                    </div>
                }
            </div>
        </section>

        <section class="capa-card stage-card capa-stage">
            <div class="main-view-card-header">
                <h4><span class="capa-step">2</span>Immediate Action</h4>
                @if (step2Done)
                {
                    <span class="main-badge is-success stage-badge">Submitted</span>
                }
                else
                {
                    <span class="main-badge is-warning stage-badge">Awaiting Response</span>
                }
            </div>
            @if (step2Done)
            {
                <div class="row g-3 capa-grid">
                    <div class="col-12 main-form-group">
                        <textarea class="form-control readonly-field" rows="3" readonly>@ImmediateAction</textarea>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Person Responsible</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.IaPerson" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Date Completed</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.IaTargetDate != null ? ((DateTime)ViewBag.Capa.IaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-12">
                        <div class="capa-verify-line">
                            <span class="capa-verify-label">QA Verification</span>
                            @if (step2Verified)
                            {
                                <div>Verified by <strong>@IaVerifiedBy</strong> on <span class="font-mono">@(ViewBag.Capa.IaVerifiedDate != null ? ((DateTime)ViewBag.Capa.IaVerifiedDate).ToString("MMM dd, yyyy") : "")</span></div>
                            }
                            else
                            {
                                <div class="capa-muted">Awaiting QA verification.</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="capa-muted">No response submitted yet.</div>
            }
        </section>

        <section class="capa-card stage-card capa-stage">
            <div class="main-view-card-header">
                <h4><span class="capa-step">3</span>Root Cause Analysis</h4>
                @if (step3Done)
                {
                    <span class="main-badge is-success stage-badge">Submitted</span>
                }
                else
                {
                    <span class="main-badge is-warning stage-badge">Awaiting Response</span>
                }
            </div>
            @if (step3Done)
            {
                <textarea class="form-control readonly-field" rows="3" readonly>@RootCause</textarea>
            }
            else
            {
                <div class="capa-muted">No root cause analysis submitted yet.</div>
            }
        </section>

        <section class="capa-card stage-card capa-stage">
            <div class="main-view-card-header">
                <h4><span class="capa-step">4</span>Corrective Action</h4>
                @if (step4Done)
                {
                    <span class="main-badge is-success stage-badge">Submitted</span>
                }
                else
                {
                    <span class="main-badge is-warning stage-badge">Awaiting Response</span>
                }
            </div>
            @if (step4Done)
            {
                <div class="row g-3 capa-grid">
                    <div class="col-12 main-form-group">
                        <textarea class="form-control readonly-field" rows="3" readonly>@CapaActions</textarea>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Person Responsible</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.CapaPerson" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Target Completion Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.CapaTargetDate != null ? ((DateTime)ViewBag.Capa.CapaTargetDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-12">
                        <div class="capa-verify-line">
                            <span class="capa-verify-label">QA Verification</span>
                            @if (step4Verified)
                            {
                                <div>Verified by <strong>@CapaVerifiedBy</strong> on <span class="font-mono">@(ViewBag.Capa.CapaVerifiedDate != null ? ((DateTime)ViewBag.Capa.CapaVerifiedDate).ToString("MMM dd, yyyy") : "")</span></div>
                            }
                            else
                            {
                                <div class="capa-muted">Awaiting QA verification.</div>
                            }
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="capa-muted">No corrective action submitted yet.</div>
            }
        </section>

        @Html.Partial("~/Views/Capa/_PartialView/_CapaStatusDispositionCard.cshtml")

        <section class="capa-card stage-card capa-stage">
            <div class="main-view-card-header">
                <h4><span class="capa-step">6</span>QA Verification</h4>
                @if (!step2Verified || !step4Verified)
                {
                    <span class="main-badge stage-badge">Pending</span>
                }
                else
                {
                    <span class="main-badge is-success stage-badge">Closed</span>
                }
            </div>
            @if (!step2Verified && !step4Verified)
            {
                <div class="capa-muted">Awaiting QA verification.</div>
            }
            else
            {
                <div class="row g-3 capa-grid">

                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Verified By</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.VerifiedByName" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Verified Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.VerifiedDate != null ? ((DateTime)ViewBag.Capa.VerifiedDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Approved By</label>
                        <input type="text" class="form-control readonly-field" value="@ViewBag.Capa.ApprovedByName" readonly>
                    </div>
                    <div class="col-md-6 main-form-group">
                        <label class="form-label">Approved Date</label>
                        <input type="text" class="form-control readonly-field font-mono" value="@(ViewBag.Capa.ApprovedDate != null ? ((DateTime)ViewBag.Capa.ApprovedDate).ToString("MMM dd, yyyy") : "")" readonly>
                    </div>
                    <div class="col-12 main-form-group">
                        <label class="form-label">Verification Notes</label>
                        <textarea class="form-control readonly-field" rows="2" readonly>@ViewBag.Capa.VerificationNotes</textarea>
                    </div>
                </div>
            }
        </section>

    </div>

</div>

@Html.Partial("~/Views/Shared/_PartialView/_AttachmentLightbox.cshtml")

@{
    var photoList = new List<object>();
    if (ViewBag.Attachments != null)
    {
        foreach (var att in ViewBag.Attachments)
        {
            photoList.Add(new
            {
                url = Url.Action("CapaAttachment", "Capa") + "?path=" + Uri.EscapeDataString((string)att.FilePath),
                caption = (string)att.Caption,
                fileName = System.IO.Path.GetFileName((string)att.FilePath)
            });
        }
    }
    var photoListJson = Newtonsoft.Json.JsonConvert.SerializeObject(photoList);
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
window.CAPA_STATUS_DATA = {
	cancelEndpoint: '@Url.Action("Cancel", "Capa")',
	cancelToken: '@ViewBag.Capa.ResponseToken',
	attachmentPhotos: @Html.Raw(photoListJson)
};
</script>
<script src="~/Scripts/capa/capa-status.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
window.CAPA_STATUS_PDF_DATA = {
	reportNumber: '@ViewBag.Capa.ReportNumber',
	overallStatus: '@overallStatus',
	logCapaActionUrl: '@Url.Action("LogCapaAction", "Capa")'
};
</script>
<script src="~/Scripts/capa/capa-status-pdf.js"></script>

@{
    var palletTagItems = new List<object>();
    foreach (var capaItem in ViewBag.Capa.Items)
    {
        palletTagItems.Add(new
        {
            itemDescription = (string)capaItem.ItemDescription,
            defect = string.IsNullOrWhiteSpace((string)capaItem.DefectName) ? "Other (Kindly Check Remarks)" : $"{capaItem.DefectName} ({capaItem.DefectCategoryName})",
            defectCategory = string.IsNullOrWhiteSpace((string)capaItem.DefectCategoryName) ? "Other" : (string)capaItem.DefectCategoryName,
            quantity = capaItem.Quantity ?? 0
        });
    }
    var palletTagItemsJson = Newtonsoft.Json.JsonConvert.SerializeObject(palletTagItems);
    var palletTagStatusUrl = Url.Action("CapaStatus", "Capa", new { token = (string)ViewBag.Capa.ResponseToken }, Request.Url.Scheme);
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
window.CAPA_STATUS_PALLET_TAG_DATA = {
	palletTagItems: @Html.Raw(palletTagItemsJson),
	palletTagStatusUrl: '@Html.Raw(palletTagStatusUrl)',
	reportNumber: '@ViewBag.Capa.ReportNumber',
	dateCreated: '@(ViewBag.Capa.DateCreated != null ? ((DateTime)ViewBag.Capa.DateCreated).ToString("MMM dd, yyyy") : "")'
};
</script>
<script src="~/Scripts/capa/capa-status-pallet-tags.js"></script>
