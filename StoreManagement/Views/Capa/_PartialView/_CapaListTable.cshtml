@model List<IsseERP.Models.CapaReportModel>
@using System.Linq
@{
    Func<IsseERP.Models.CapaReportModel, string> computeStatusKey = (Func<IsseERP.Models.CapaReportModel, string>)ViewData["CapaList_ComputeStatusKey"];
    int dueCount = Model == null ? 0 : Model.Count(c => c.IsResponseDue);
}
        @if (dueCount > 0)
        {
            <div class="capa-due-bar" role="status">
                <span class="capa-due-bar-text">
                    <i class="fa fa-exclamation-triangle"></i>
                    <strong>@dueCount</strong> CAR@(dueCount == 1 ? "" : "s") still awaiting a response past the @IsseERP.Models.CapaReportModel.ResponseDueWorkingDays working-day due date
                </span>
                <button type="button" class="btn btn-sm capa-due-toggle" id="capaDueToggle" aria-haspopup="dialog">Show due CARs</button>
            </div>

            <div class="capa-modal-overlay" id="capaDueModal" role="dialog" aria-modal="true" aria-labelledby="capaDueModalTitle">
                <div class="capa-modal">
                    <div class="capa-modal-header">
                        <h5 class="capa-modal-title" id="capaDueModalTitle"><i class="fa fa-exclamation-triangle"></i> CARs due for response</h5>
                        <button type="button" class="capa-modal-close" id="capaDueModalClose" aria-label="Close">&times;</button>
                    </div>
                    <div class="capa-modal-body">
                        <div class="table-responsive">
                            <table class="table main-list-table capa-table">
                                <thead>
                                    <tr>
                                        <th>DUE DATE</th>
                                        <th>CAR NO.</th>
                                        <th>DATE ISSUED</th>
                                        <th>DESCRIPTION</th>
                                        <th>SITE WAREHOUSE</th>
                                        <th>CAR CLASSIFICATION</th>
                                        <th class="main-actions-sticky">ACTIONS</th>
                                    </tr>
                                </thead>
                                <tbody id="capaDueModalBody">
                                    @foreach (var due in Model.Where(c => c.IsResponseDue).OrderBy(c => c.ResponseDueDate).ThenBy(c => c.ReportNumber))
                                    {
                                        var dueFirstItem = due.Items != null && due.Items.Count > 0 ? due.Items[0] : null;
                                        <tr>
                                            <td class="main-tabular fw-semibold">@(due.ResponseDueDate.Value.ToString("MMM dd, yyyy"))</td>
                                            <td class="main-tabular">
                                                <span class="main-chip">@due.ReportNumber</span>
                                                @if (due.Items != null && due.Items.Count > 1)
                                                {
                                                    <span class="main-badge">+@(due.Items.Count - 1) more</span>
                                                }
                                            </td>
                                            <td class="main-tabular">@(due.DateCreated.HasValue ? due.DateCreated.Value.ToString("MMM dd, yyyy") : "")</td>
                                            <td>@(string.IsNullOrWhiteSpace(dueFirstItem?.ItemDescription) ? "-" : dueFirstItem.ItemDescription)</td>
                                            <td>@(string.IsNullOrWhiteSpace(due.SiteWarehouseName) ? "-" : due.SiteWarehouseName)</td>
                                            <td>@due.CarClassificationType</td>
                                            <td class="main-actions-sticky">
                                                <a href="@Url.Action("CapaStatus", "Capa")?token=@due.ResponseToken" class="btn btn-primary btn-sm" target="_blank" title="View CAR" aria-label="View CAR @due.ReportNumber">View</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="capa-modal-footer">
                        <span class="main-pagination-summary" id="capaDueModalInfo"></span>
                        <div class="main-pagination-controls" id="capaDueModalPager"></div>
                    </div>
                </div>
            </div>
        }
        <div class="table-responsive">
            <table class="table main-list-table capa-table" id="capaTable">
                <thead>
                    <tr>
                        <th class="is-sortable" onclick="toggleStatusSort()">
                            STATUS <i class="fa fa-sort sort-icon" id="statusSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleDateIssuedSort()">
                            DATE ISSUED <i class="fa fa-sort sort-icon" id="dateIssuedSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleCarNoSort()">
                            CAR NO. <i class="fa fa-sort sort-icon" id="carNoSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleStockMovementSort()">
                            STOCK MOVEMENT <i class="fa fa-sort sort-icon" id="stockMovementSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleItemCodeSort()">
                            ITEM CODE <i class="fa fa-sort sort-icon" id="itemCodeSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleDescriptionSort()">
                            DESCRIPTION <i class="fa fa-sort sort-icon" id="descriptionSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleUTDSort()">
                            UTD <i class="fa fa-sort sort-icon" id="utdSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleUOMSort()">
                            UOM <i class="fa fa-sort sort-icon" id="uomSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleQuantitySort()">
                            QUANTITY <i class="fa fa-sort sort-icon" id="quantitySortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleNatureOfDefectSort()">
                            NATURE OF DEFECT <i class="fa fa-sort sort-icon" id="natureOfDefectSortIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleSiteWarehouseSort()">
                            SITE WAREHOUSE <i class="fa fa-sort sort-icon" id="siteWarehouseIcon"></i>
                        </th>
                        <th class="is-sortable" onclick="toggleCarClassificationSort()">
                            CAR CLASSIFICATION <i class="fa fa-sort sort-icon" id="carClassificationSortIcon"></i>
                        </th>
                        <th class="main-actions-sticky">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || Model.Count == 0)
            {
                        <tr class="main-empty-row">
                            <td colspan="13">
                                <div class="main-empty-state">
                                    <div class="main-empty-state-icon"><i class="fa fa-clipboard"></i></div>
                                    <div class="main-empty-state-title">No CAR reports yet</div>
                                    <div class="main-empty-state-text">Filed reports will show up here.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var capa in Model)
                        {
                            string statusKey = computeStatusKey(capa);
        string statusText, badgeTone;

                            switch (statusKey)
                            {
                                case "response":
                                    statusText = "Awaiting Response"; badgeTone = "is-warning"; break;
                                case "verify":
                                    statusText = "Awaiting Verification"; badgeTone = "is-info"; break;
                                case "cancelled":
                                    statusText = "Cancelled"; badgeTone = "is-brand"; break;
                                default:
                                    statusText = "Closed"; badgeTone = "is-success"; break;
                            }

    string allItemsText = capa.Items != null
        ? string.Join(" ", capa.Items.Select(i => $"{i.ItemDescription} {i.DefectListDisplay} {i.DefectCategoryName}"))
        : "";

    string searchText = $"{capa.ReportNumber} {capa.IssuedBy} {capa.SiteWarehouseName} {capa.CarClassificationType} {capa.CarClassificationRefName} {allItemsText}".ToLower();

    var carItems = capa.Items ?? new List<IsseERP.Models.CapaItemModel>();
    var firstItem = carItems.Count > 0 ? carItems[0] : null;
    bool hasMultipleItems = carItems.Count > 1;
    bool isDue = capa.IsResponseDue;

                <tr class="@(hasMultipleItems ? "has-items-expand" : "") @(isDue ? "capa-row-due" : "")" data-due="@(isDue ? "1" : "0")" data-status="@statusKey" data-classification="@capa.CarClassificationType" data-created="@(capa.DateCreated.HasValue ? capa.DateCreated.Value.ToString("yyyy-MM-dd") : "")" data-search="@searchText" data-report-number="@capa.ReportNumber" onclick="toggleItemDetails(this, event)">
                    <td>
                        <span class="main-badge @badgeTone"><i class="fa fa-circle"></i>@statusText</span>
                    </td>
                    <td class="main-tabular fw-semibold">@(capa.DateCreated.HasValue ? capa.DateCreated.Value.ToString("MMM dd, yyyy") : "")</td>
                    <td class="main-tabular">
                        <span class="capa-car-no">
                            @if (hasMultipleItems)
                            {
                                <i class="fa fa-chevron-right expand-icon"></i>
                            }
                            <span class="main-chip">@capa.ReportNumber</span>
                            @if (hasMultipleItems)
                            {
                                <span class="main-badge" title="This CAR has @carItems.Count items — click the row to see them all">+@(carItems.Count - 1) more item@(carItems.Count > 2 ? "s" : "")</span>
                            }
                            @if (isDue)
                            {
                                <span class="main-badge is-brand" title="No response yet. It was due @(capa.ResponseDueDate.Value.ToString("MMM dd, yyyy")) (@(IsseERP.Models.CapaReportModel.ResponseDueWorkingDays) working days, counting the day it was @(capa.LoopNumber > 0 && capa.LastSentBackDate.HasValue ? "sent back" : "filed"))"><i class="fa fa-exclamation-triangle"></i> Due</span>
                            }
                            @if (capa.LoopNumber > 0)
                            {
                                <span class="main-badge is-warning" title="Sent back to Awaiting Response @capa.LoopNumber time(s) after failing an effectiveness check"><i class="fa fa-repeat"></i> @capa.LoopNumber</span>
                            }
                        </span>
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(capa.IaVerifiedBy) ? "-" : (capa.StockEventID == 2 ? "AUDIT" : capa.StockEventID == 1 ? "OUT RIGHT" : "SA OUT"))</td>
                    <td class="main-tabular">@(string.IsNullOrWhiteSpace(firstItem?.ItemCode) ? "-" : firstItem?.ItemCode)</td>
                    <td>@(string.IsNullOrWhiteSpace(firstItem?.ItemDescription) ? "-" : firstItem?.ItemDescription)</td>
                    <td class="main-tabular">@(firstItem?.UsedToDate != null && firstItem.UsedToDate.Value.Year > 1900 ? firstItem.UsedToDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                    <td>@(string.IsNullOrWhiteSpace(firstItem?.UOMDisplay) ? "-" : firstItem?.UOMDisplay)</td>
                    <td class="main-tabular">@((firstItem?.Quantity ?? 0) == 0 ? "-" : firstItem?.Quantity.ToString())</td>
                    <td>@(string.IsNullOrWhiteSpace(firstItem?.DefectListDisplay) ? "-" : firstItem?.DefectListDisplay)</td>
                    <td>@(string.IsNullOrWhiteSpace(capa.SiteWarehouseName) ? "-" : capa.SiteWarehouseName)</td>
                    <td>@capa.CarClassificationType</td>

                    <td class="main-actions-sticky">
                        <a href="@Url.Action("CapaStatus", "Capa")?token=@capa.ResponseToken" class="btn btn-primary btn-sm" target="_blank" title="View CAR" aria-label="View CAR @capa.ReportNumber">View</a>
                    </td>
                </tr>
                        if (hasMultipleItems)
                        {
                <tr class="item-detail-row d-none">
                    <td colspan="13">
                        <table class="table capa-subtable">
                            <thead>
                                <tr>
                                    <th>Item Code</th>
                                    <th>Description</th>
                                    <th>UTD</th>
                                    <th>UOM</th>
                                    <th>Quantity</th>
                                    <th>Nature of Defect</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var carItem in carItems)
                                {
                                    <tr>
                                        <td class="main-tabular">@carItem.ItemCode</td>
                                        <td>@carItem.ItemDescription</td>
                                        <td class="main-tabular">@(carItem.UsedToDate.HasValue && carItem.UsedToDate.Value.Year > 1900 ? carItem.UsedToDate.Value.ToString("MMM dd, yyyy") : "-")</td>
                                        <td>@carItem.UOMDisplay</td>
                                        <td class="main-tabular">@carItem.Quantity</td>
                                        <td>@carItem.DefectListDisplay</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </td>
                </tr>
                        }
                        }
                    }
                </tbody>
            </table>
        </div>
