            <template id="capaItemTemplate">
                <div class="capa-item-block">
                    <section class="capa-card">
                        <div class="main-view-card-header">
                            <h4><span class="capa-step">1</span>Details of the Non-conformance</h4>
                            <button type="button" class="btn capa-remove-btn remove-item-btn">Remove item</button>
                        </div>
                        <div>
                            <div class="row g-3 capa-grid">
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Item Description <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <div class="autocomplete-wrap item-search-wrap">
                                        <input type="text" class="form-control item-search" autocomplete="off"
                                               placeholder="Start typing, e.g. &ldquo;mini apple&rdquo;&hellip;" required>
                                        <input type="hidden" class="item-field" data-field="item_id">
                                        <div class="list-group ac-dropdown item-ac-dropdown shadow-sm"></div>
                                    </div>
                                    <select class="form-control item-vendor-select d-none">
                                        <option value="" disabled selected>Select item&hellip;</option>
                                    </select>
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Item Code <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <input type="text" class="form-control font-mono item-code-display" placeholder="Auto-fills from selection" readonly>
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Quantity of Affected Items <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <input type="number" min="0" class="form-control item-field" data-field="quantity" required>
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Unit of Measure <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <select class="form-control item-field" data-field="uom_id" required>
                                        @foreach (var u in ViewBag.UOM)
                                        {
                                            if (string.Equals((string)u.Text, "Case", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@u.UOMID" selected>@u.Text - @u.IsoCode</option>
                                            }
                                            else
                                            {
                                                <option value="@u.UOMID">@u.Text - @u.IsoCode</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Defect Description <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <select class="form-control item-field defect-select" data-field="defect_category_id" required>
                                        <option value="" disabled selected>Loading&hellip;</option>
                                    </select>
                                    <input type="text" class="form-control mt-2 d-none defect-other-input" placeholder="Specify the defect">
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">Defect Category <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <input type="text" class="form-control font-mono defect-category-display" placeholder="Auto-fills from selection" readonly>
                                </div>
                                <div class="col-md-6 main-form-group">
                                    <label class="form-label">UTD <span class="optional-hint d-none fw-normal text-secondary">(optional)</span></label>
                                    <input type="date" class="form-control item-field" data-field="used_to_date" required>
                                </div>
                            </div>
                            <div class="main-form-group mt-3 mb-0">
                                <label class="form-label">Remarks</label>
                                <textarea class="form-control item-field" data-field="remarks" rows="4" placeholder="Describe what happened, when and where it was discovered, and which product, batch, or shipment is affected&hellip;" required></textarea>
                            </div>
                        </div>
                    </section>

                    <section class="capa-card">
                        <div class="main-view-card-header">
                            <h4><span class="capa-step">2</span>Photo / Document Attachments</h4>
                            <span class="capa-card-note">Evidence photos, supporting documents, etc.</span>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                                <label class="btn main-outline-btn mb-0 d-inline-flex align-items-center">
                                    <i class="fa fa-paperclip"></i> Add file(s)
                                    <input type="file" accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" multiple class="d-none item-attach-input">
                                </label>
                                <span class="capa-muted">Images, PDF, Word, or Excel &mdash; multiple files allowed. Stored only in this open page &mdash; nothing is uploaded anywhere.</span>
                            </div>
                            <div class="item-attach-empty capa-attach-empty">No attachments added yet.</div>
                            <div class="item-attach-grid row row-cols-2 row-cols-md-3 g-3"></div>
                        </div>
                    </section>
                </div>
            </template>
