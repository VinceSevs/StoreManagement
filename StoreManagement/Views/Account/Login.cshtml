@model StoreManagement.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
}

<style>
    :root {
        --login-primary: #7d1f27;
        --login-primary-dark: #5e161f;
        --login-border: #e8dcda;
        --login-muted: #8a7472;
    }

    .login-shell {
        display: flex;
        min-height: 100vh;
    }

    /* ---------- Brand panel (flat, no gradient) ---------- */
    .login-brand-panel {
        flex: 0 0 42%;
        background: var(--login-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }

    .login-brand-inner {
        text-align: center;
        color: #fff;
    }

    .login-logo-ring {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 132px;
        height: 132px;
        border-radius: 50%;
        background: #fff;
        margin-bottom: 1.6rem;
    }

    .login-logo-ring::before,
    .login-logo-ring::after {
        content: "";
        position: absolute;
        inset: -10px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.45);
        animation: loginRingPulse 2.6s ease-out infinite;
    }

    .login-logo-ring::after {
        animation-delay: 1.3s;
    }

    @@keyframes loginRingPulse {
        0%   { transform: scale(1);   opacity: .7; }
        100% { transform: scale(1.35); opacity: 0; }
    }

    .login-logo-ring img {
        height: 72px;
        width: auto;
        position: relative;
        z-index: 1;
    }

    .login-brand-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.35rem;
        line-height: 1.3;
        margin-bottom: .5rem;
    }

    .login-brand-sub {
        font-size: .88rem;
        color: rgba(255,255,255,.75);
        letter-spacing: .02em;
    }

    /* ---------- Form panel ---------- */
    .login-form-panel {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: #fff;
        padding: 2rem 1.25rem 1.25rem;
    }

    .login-form-center {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .login-form-box {
        width: 100%;
        max-width: 380px;
        background: #fff;
        border: 1px solid var(--login-border);
        border-radius: 18px;
        box-shadow: 0 12px 32px rgba(36,19,22,.08);
        padding: 2.2rem 2rem;
        box-sizing: border-box;
        opacity: 0;
        transform: translateY(14px);
        animation: loginBoxIn .5s cubic-bezier(.22,1,.36,1) forwards;
    }

    .login-form-box.shake {
        opacity: 1;
        animation: loginShake .4s ease;
    }

    @@keyframes loginBoxIn {
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes loginShake {
        10%, 90% { transform: translateX(-2px); }
        20%, 80% { transform: translateX(4px); }
        30%, 50%, 70% { transform: translateX(-7px); }
        40%, 60% { transform: translateX(7px); }
    }

    .login-title {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.4rem;
        color: #241316;
        margin-bottom: .2rem;
    }

    .login-subtitle {
        font-size: .88rem;
        color: var(--login-muted);
        margin-bottom: 1.7rem;
    }

    #loginServerError {
        background: #fdf1f0;
        border: 1px solid #f2c9c6;
        border-radius: 10px;
        padding: .6rem .8rem;
    }

    .login-field {
        margin-bottom: 1.1rem;
    }

    .login-field label {
        font-size: .78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--login-muted);
        margin-bottom: .35rem;
        display: block;
    }

    .login-input-group {
        position: relative;
        display: flex;
        align-items: center;
    }

    .login-input-group .field-icon {
        position: absolute;
        left: 14px;
        color: #b89694;
        font-size: 1rem;
        pointer-events: none;
    }

    .login-input-group input.form-control {
        padding-left: 2.6rem;
        border-radius: 10px;
        border: 1px solid var(--login-border);
        background: #fdfbfa;
        height: 46px;
        transition: border-color .15s ease, box-shadow .15s ease, background-color .15s ease;
    }

    .login-input-group input.form-control:focus {
        border-color: var(--login-primary);
        box-shadow: 0 0 0 .2rem rgba(125,31,39,.12);
        background: #fff;
    }

    .login-input-group.has-toggle input.form-control {
        padding-right: 2.6rem;
    }

    /* Hide the browser's own built-in password-reveal icon (Edge/IE) so it
       doesn't sit on top of our custom eye toggle. */
    input[type="password"]::-ms-reveal,
    input[type="password"]::-ms-clear {
        display: none;
    }

    .password-toggle-btn {
        position: absolute;
        right: 10px;
        background: none;
        border: none;
        color: #b89694;
        font-size: 1.05rem;
        padding: 4px 6px;
        line-height: 1;
        cursor: pointer;
        transition: color .15s ease;
    }

    .password-toggle-btn:hover {
        color: var(--login-primary);
    }

    #capsLockWarning {
        display: none;
        align-items: center;
        gap: .35rem;
        font-size: .78rem;
        font-weight: 600;
        color: #92620a;
        background: #fff6e6;
        border: 1px solid #f2dba6;
        border-radius: 8px;
        padding: .35rem .6rem;
        margin-top: .5rem;
    }

    #capsLockWarning.show {
        display: flex;
    }

    .login-remember {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin-bottom: .3rem;
    }

    .login-remember label {
        font-size: .85rem;
        color: #5a4a48;
        margin: 0;
        cursor: pointer;
    }

    .login-remember-hint {
        font-size: .74rem;
        color: #a68d8a;
        margin: 0 0 1.3rem 0;
    }

    .login-submit-btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: .7rem 1rem;
        font-weight: 600;
        font-size: .95rem;
        color: #fff;
        background: var(--login-primary);
        transition: background-color .15s ease, transform .15s ease;
    }

    .login-submit-btn:hover:not(:disabled) {
        background: var(--login-primary-dark);
        transform: translateY(-1px);
    }

    .login-submit-btn:disabled {
        opacity: .75;
        cursor: default;
    }

    .login-footer-link {
        text-align: center;
        margin-top: 1.3rem;
        font-size: .85rem;
    }

    .login-footer-link a {
        color: var(--login-primary);
        font-weight: 600;
        text-decoration: none;
    }

    .login-footer-link a:hover {
        text-decoration: underline;
    }

    /* ---------- Truck & warehouse scene ---------- */
    .login-scene {
        position: relative;
        width: 100%;
        max-width: 640px;
        height: 130px;
        margin-top: 1.6rem;
        overflow: hidden;
    }

    .login-scene-centered {
        align-self: center;
        margin-top: 0;
    }

    .login-scene-ground {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 28px;
        border-top: 2px dashed var(--login-border);
    }

    .login-scene-warehouse {
        position: absolute;
        right: 8px;
        bottom: 28px;
        width: 104px;
    }

    .warehouse-roof {
        width: 0;
        height: 0;
        border-left: 55px solid transparent;
        border-right: 55px solid transparent;
        border-bottom: 22px solid var(--login-primary-dark);
        margin-left: -3px;
    }

    .warehouse-body {
        position: relative;
        width: 104px;
        height: 64px;
        background: var(--login-primary);
        border-radius: 3px 3px 0 0;
    }

    .warehouse-door {
        position: absolute;
        left: 50%;
        bottom: 0;
        width: 28px;
        height: 42px;
        transform: translateX(-50%);
        background: var(--login-primary-dark);
        border-radius: 3px 3px 0 0;
    }

    .warehouse-window {
        position: absolute;
        top: 13px;
        width: 15px;
        height: 15px;
        background: #fdfbfa;
        border-radius: 3px;
        opacity: .85;
    }

    .warehouse-window:nth-of-type(2) { left: 11px; }
    .warehouse-window:nth-of-type(3) { right: 11px; }

    .login-scene-truck {
        position: absolute;
        bottom: 28px;
        left: 0;
        width: 87px;
        height: 48px;
        animation: truckDrive 9s linear infinite;
    }

    .login-scene-truck-2 {
        animation-delay: -4.5s;
    }

    @@keyframes truckDrive {
        from { transform: translateX(-100px); }
        to   { transform: translateX(680px); }
    }

    .truck-cargo {
        position: absolute;
        left: 0;
        bottom: 11px;
        width: 53px;
        height: 34px;
        background: var(--login-muted);
        border-radius: 3px;
    }

    .truck-cab {
        position: absolute;
        left: 50px;
        bottom: 11px;
        width: 31px;
        height: 25px;
        background: var(--login-primary);
        border-radius: 3px 7px 0 0;
    }

    .truck-window {
        position: absolute;
        top: 4px;
        left: 6px;
        width: 17px;
        height: 11px;
        background: #fdfbfa;
        border-radius: 2px;
        opacity: .9;
    }

    .truck-wheel {
        position: absolute;
        bottom: 3px;
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: #241316;
        animation: wheelSpin .5s linear infinite;
    }

    .truck-wheel-1 { left: 8px; }
    .truck-wheel-2 { left: 59px; }

    /* Desktop: give the scene noticeably more road to drive on */
    @@media (min-width: 1200px) {
        .login-scene {
            max-width: 900px;
        }

        @@keyframes truckDrive {
            from { transform: translateX(-100px); }
            to   { transform: translateX(960px); }
        }
    }

    @@keyframes wheelSpin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .login-scene-truck,
        .truck-wheel {
            animation: none;
        }
    }

    /* ---------- Responsive ---------- */
    html, body {
        overflow-x: hidden;
    }

    /* Tablets: keep the side-by-side layout but tighten it up */
    @@media (max-width: 991.98px) {
        .login-brand-panel {
            flex-basis: 38%;
            padding: 1.75rem;
        }

        .login-form-panel {
            padding: 1.75rem 1.25rem;
        }
    }

    /* Phones (and narrow tablets in portrait): stack the panels */
    @@media (max-width: 899.98px) {
        .login-shell {
            flex-direction: column;
            min-height: 100vh;
        }

        .login-brand-panel {
            flex: 0 0 auto;
            padding: 1.75rem 1rem 1.4rem;
        }

        .login-form-panel {
            flex: 1 1 auto;
            padding: 1.5rem 1rem 2rem;
        }

        .login-logo-ring {
            width: 84px;
            height: 84px;
            margin-bottom: .85rem;
        }

        .login-logo-ring img {
            height: 46px;
        }

        .login-brand-title {
            font-size: 1.05rem;
        }

        .login-brand-sub {
            font-size: .8rem;
        }

        .login-form-box {
            max-width: 420px;
            padding: 1.75rem 1.5rem;
        }
    }

    /* Small phones */
    @@media (max-width: 420px) {
        .login-brand-panel {
            padding: 1.4rem .75rem 1.1rem;
        }

        .login-form-panel {
            padding: 1rem .75rem 1.75rem;
        }

        .login-form-box {
            padding: 1.4rem 1.1rem;
            border-radius: 14px;
        }

        .login-title {
            font-size: 1.2rem;
        }

        .login-input-group input.form-control {
            height: 44px;
        }

        .login-scene {
            height: 76px;
            transform: scale(.88);
            transform-origin: top center;
        }
    }

    /* Large / widescreen desktops: don't let the brand panel or form box
       stretch too wide */
    @@media (min-width: 1600px) {
        .login-brand-panel {
            flex-basis: 34%;
        }

        .login-form-box {
            max-width: 400px;
        }
    }

    /* ---------- Success overlay ---------- */
    .login-success-overlay {
        position: fixed;
        inset: 0;
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        opacity: 0;
        visibility: hidden;
        transition: opacity .35s ease;
    }

    .login-success-overlay.show {
        opacity: 1;
        visibility: visible;
    }

    .success-check-svg {
        width: 96px;
        height: 96px;
    }

    .success-check-circle {
        stroke: var(--login-primary);
        stroke-width: 3;
        stroke-dasharray: 226;
        stroke-dashoffset: 226;
    }

    .success-check-path {
        stroke: var(--login-primary);
        stroke-width: 4;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 48;
        stroke-dashoffset: 48;
    }

    .login-success-overlay.show .success-check-circle {
        animation: successDrawCircle .5s ease forwards;
    }

    .login-success-overlay.show .success-check-path {
        animation: successDrawPath .35s .45s ease forwards;
    }

    @@keyframes successDrawCircle {
        to { stroke-dashoffset: 0; }
    }

    @@keyframes successDrawPath {
        to { stroke-dashoffset: 0; }
    }

    .success-message {
        margin-top: 1.2rem;
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 1.1rem;
        color: #241316;
        opacity: 0;
        transform: translateY(6px);
    }

    .login-success-overlay.show .success-message {
        animation: successMessageIn .4s .7s ease forwards;
    }

    @@keyframes successMessageIn {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="login-shell">
    <div class="login-brand-panel">
        <div class="login-brand-inner">
            <div class="login-logo-ring">
                <img src="data:image/png;base64," alt="LEAD Logistics Innovations, Inc.">
            </div>
            <div class="login-brand-title">Lead Logistics<br>Innovation, Inc.</div>
            <div class="login-brand-sub">Corrective Action Report System</div>
        </div>
    </div>

    <div class="login-form-panel">
      <div class="login-form-center">
        <div class="login-form-box" id="loginFormBox">
            <div class="login-title">Welcome back</div>
            <div class="login-subtitle">Sign in to continue</div>

            @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm" }))
            {
                @Html.AntiForgeryToken()

                <div id="loginServerError" class="text-danger small mb-3" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
                    @Html.ValidationSummary(true, "", new { })
                </div>

                <div class="login-field">
                    @Html.LabelFor(m => m.Username)
                    <div class="login-input-group">
                        <i class="bi bi-person-fill field-icon"></i>
                        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Enter your username" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                </div>

                <div class="login-field">
                    @Html.LabelFor(m => m.Password)
                    <div class="login-input-group has-toggle">
                        <i class="bi bi-lock-fill field-icon"></i>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "passwordInput", autocomplete = "current-password", placeholder = "Enter your password" })
                        <button type="button" class="password-toggle-btn" id="togglePasswordBtn" aria-label="Show password">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <div id="capsLockWarning">
                        <i class="bi bi-exclamation-triangle-fill"></i> Caps Lock is on
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>

                <div class="login-remember">
                    @Html.CheckBoxFor(m => m.RememberMe, new { id = "rememberMeCheck", @class = "form-check-input" })
                    @Html.LabelFor(m => m.RememberMe, "Remember me", new { @for = "rememberMeCheck" })
                </div>
                <div class="login-remember-hint">Stay signed in on this device for up to 48 hours.</div>

                <button type="submit" class="login-submit-btn" id="loginSubmitBtn">
                    <span id="loginBtnLabel">Login</span>
                </button>
            }

            @*<div class="login-footer-link">
                @Html.ActionLink("Register a new account", "Register", "Account")
            </div>*@
        </div>
      </div>

        <div class="login-scene login-scene-centered" aria-hidden="true">
            <div class="login-scene-ground"></div>

            <div class="login-scene-warehouse">
                <div class="warehouse-roof"></div>
                <div class="warehouse-body">
                    <div class="warehouse-door"></div>
                    <div class="warehouse-window"></div>
                    <div class="warehouse-window"></div>
                </div>
            </div>

            <div class="login-scene-truck">
                <div class="truck-cargo"></div>
                <div class="truck-cab">
                    <div class="truck-window"></div>
                </div>
                <div class="truck-wheel truck-wheel-1"></div>
                <div class="truck-wheel truck-wheel-2"></div>
            </div>

            <div class="login-scene-truck login-scene-truck-2">
                <div class="truck-cargo"></div>
                <div class="truck-cab">
                    <div class="truck-window"></div>
                </div>
                <div class="truck-wheel truck-wheel-1"></div>
                <div class="truck-wheel truck-wheel-2"></div>
            </div>
        </div>
    </div>
</div>

<div class="login-success-overlay" id="loginSuccessOverlay">
    <svg class="success-check-svg" viewBox="0 0 80 80">
        <circle class="success-check-circle" cx="40" cy="40" r="36" fill="none"></circle>
        <path class="success-check-path" fill="none" d="M22 41 L34 53 L58 27"></path>
    </svg>
    <div class="success-message">Signed in! Redirecting...</div>
</div>

@section scripts {
<script>
    (function () {
        var toggleBtn = document.getElementById('togglePasswordBtn');
        var toggleIcon = document.getElementById('togglePasswordIcon');
        var passwordInput = document.getElementById('passwordInput');
        var capsLockWarning = document.getElementById('capsLockWarning');

        if (passwordInput && capsLockWarning) {
            var checkCapsLock = function (e) {
                if (typeof e.getModifierState !== 'function') return;
                var isOn = e.getModifierState('CapsLock');
                capsLockWarning.classList.toggle('show', isOn);
            };
            passwordInput.addEventListener('keydown', checkCapsLock);
            passwordInput.addEventListener('keyup', checkCapsLock);
            passwordInput.addEventListener('blur', function () {
                capsLockWarning.classList.remove('show');
            });
        }

        if (toggleBtn && passwordInput) {
            toggleBtn.addEventListener('click', function () {
                var isHidden = passwordInput.type === 'password';
                passwordInput.type = isHidden ? 'text' : 'password';
                toggleIcon.classList.toggle('bi-eye', !isHidden);
                toggleIcon.classList.toggle('bi-eye-slash', isHidden);
                toggleBtn.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
            });
        }

        var form = document.getElementById('loginForm');
        var submitBtn = document.getElementById('loginSubmitBtn');
        var btnLabel = document.getElementById('loginBtnLabel');
        var serverErrorBox = document.getElementById('loginServerError');
        var formBox = document.getElementById('loginFormBox');
        var overlay = document.getElementById('loginSuccessOverlay');

        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();

            submitBtn.disabled = true;
            btnLabel.textContent = 'Signing in...';
            serverErrorBox.style.display = 'none';

            fetch(form.action, {
                method: 'POST',
                headers: { 'X-Requested-With': 'XMLHttpRequest' },
                body: new FormData(form)
            })
                .then(function (response) {
                    return response.json().catch(function () { return null; }).then(function (data) {
                        return { ok: response.ok, data: data };
                    });
                })
                .then(function (result) {
                    if (result.ok && result.data && result.data.success) {
                        overlay.classList.add('show');
                        setTimeout(function () {
                            window.location.href = result.data.redirectUrl || '/';
                        }, 1150);
                        return;
                    }

                    var message = (result.data && result.data.message) || 'Invalid username or password.';
                    serverErrorBox.textContent = message;
                    serverErrorBox.style.display = 'block';

                    formBox.classList.remove('shake');
                    void formBox.offsetWidth;
                    formBox.classList.add('shake');

                    submitBtn.disabled = false;
                    btnLabel.textContent = 'Login';
                })
                .catch(function () {
                    serverErrorBox.textContent = 'Network error — please try again.';
                    serverErrorBox.style.display = 'block';
                    submitBtn.disabled = false;
                    btnLabel.textContent = 'Login';
                });
        });
    })();
</script>
}
