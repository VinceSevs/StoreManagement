@model StoreManagement.Models.LoginViewModel
@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Sign In";
}

<div class="auth-card-header">
    <h2>Sign In</h2>
    <p>Enter your username and password to continue.</p>
</div>

<div id="loginServerError" class="auth-alert auth-alert-error" style="@(ViewData.ModelState.IsValid ? "display:none;" : "")">
    <i class="fa fa-exclamation-circle"></i>
    <span id="loginServerErrorText">@Html.ValidationSummary(true, "", new { })</span>
</div>

@using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "loginForm", @class = "auth-form" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Username)
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username", placeholder = "Enter your username", autofocus = "autofocus" })
        @Html.ValidationMessageFor(m => m.Username)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Password)
        <div class="auth-input-group has-toggle">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", id = "passwordInput", autocomplete = "current-password", placeholder = "Enter your password" })
            <button type="button" class="password-toggle-btn" id="togglePasswordBtn" aria-label="Show password">
                <i class="bi bi-eye" id="togglePasswordIcon"></i>
            </button>
        </div>
        <div id="capsLockWarning">
            <i class="fa fa-exclamation-triangle"></i> Caps Lock is on
        </div>
        @Html.ValidationMessageFor(m => m.Password)
    </div>

    <div class="form-row-inline">
        <label class="remember-me">
            @Html.CheckBoxFor(m => m.RememberMe, new { id = "rememberMeCheck" })
            Remember me
        </label>
    </div>
    <div class="auth-hint">Stay signed in on this device for up to 48 hours.</div>

    <button type="submit" class="btn-auth" id="loginSubmitBtn">
        <span id="loginBtnLabel">Sign In</span>
    </button>
}

@section overlay {
    <div class="login-success-overlay" id="loginSuccessOverlay">
        <svg class="success-check-svg" viewBox="0 0 80 80">
            <circle class="success-check-circle" cx="40" cy="40" r="36" fill="none"></circle>
            <path class="success-check-path" fill="none" d="M22 41 L34 53 L58 27"></path>
        </svg>
        <div class="success-message">Signed in! Redirecting...</div>
    </div>
}

@section scripts {
    <script src="~/Scripts/account/login.js"></script>
}
