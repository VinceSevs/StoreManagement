@model IEnumerable<StoreManagement.Models.Pcr>

@{
    ViewBag.Title = "Product Complaint Report";
}

<link href="~/Content/complaintreport/index.css" rel="stylesheet" />

<div class="lead-page-header">
    <div class="lead-page-icon"><i class="bi bi-file-earmark-text"></i></div>
    <div>
        <div class="lead-eyebrow">Complaint Report</div>
        <h1>Product Complaint Report</h1>
    </div>
</div>

<div class="card shadow-sm pcr-filter-card mb-3">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-lg-4 col-md-6">
                <label class="pcr-filter-label" for="pcrSearch">Search</label>
                <input type="text" id="pcrSearch" class="form-control lead-search" placeholder="PCR No., store, item, vendor..." autocomplete="off" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="pcr-filter-label" for="pcrStatusFilter">Status</label>
                <select id="pcrStatusFilter" class="form-select">
                    <option value="">All Statuses</option>
                    <option value="1">Transmitted</option>
                    <option value="2">Closed</option>
                    <option value="3">Re-opened</option>
                    @*<option value="4">Valid</option>
                    <option value="5">Invalid</option>
                    <option value="6">For Further Investigation</option>
                    <option value="7">Revalidated</option>
                    <option value="8">Lead Responsibility</option>
                    <option value="9">GADC Responsibility</option>
                    <option value="10">AutoValid</option>
                    <option value="11">Cancelled</option>*@
                </select>
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="pcr-filter-label" for="pcrDateFrom">Date From</label>
                <input type="date" id="pcrDateFrom" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-6">
                <label class="pcr-filter-label" for="pcrDateTo">Date To</label>
                <input type="date" id="pcrDateTo" class="form-control" />
            </div>
            <div class="col-lg-2 col-md-12">
                <button type="button" id="pcrClearFilters" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-x-circle"></i> Clear Filters
                </button>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm pcr-list-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <span class="fw-semibold text-secondary small text-uppercase" style="letter-spacing:.04em"></span>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-secondary" id="pcrResultCount"></span>
            <button type="button" id="pcrExportBtn" class="btn btn-outline-primary btn-sm">
                <i class="bi bi-file-earmark-excel"></i> Export to Excel
            </button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 lead-table" id="pcrTable">
            <thead>
                <tr>
                    <th class="pcr-sortable" data-col="0">Status <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="1">Create Date <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="2">PCR No. <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="3">Store Name <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="4">Item <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="5">Complaint Issue <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="6">Vendor <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="7">Vendor Remarks <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="pcr-sortable" data-col="8">QA Remarks <i class="bi bi-arrow-down-up sort-icon"></i></th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int filterStatus = item.PcrStatus == 0 ? 1 : item.PcrStatus;
                    <tr class="pcr-row" data-status="@filterStatus" data-date="@item.DateCreated.ToString("yyyy-MM-dd")">
                        <td>
                            @{
                                string badgeClass = "bg-info";
                                string badgeText = "TRANSMITTED";
                                switch (item.PcrStatus)
                                {
                                    case 2: badgeClass = "bg-primary"; badgeText = "CLOSED"; break;
                                    case 3: badgeClass = "bg-info"; badgeText = "RE-OPENED"; break;
                                        //case 4: badgeClass = "bg-primary"; badgeText = "VALID"; break;
                                        //case 5: badgeClass = "bg-danger"; badgeText = "INVALID"; break;
                                        //case 6: badgeClass = "bg-danger"; badgeText = "FOR FURTHER INVESTIGATION"; break;
                                        //case 7: badgeClass = "bg-danger"; badgeText = "REVALIDATED"; break;
                                        //case 8: badgeClass = "bg-danger"; badgeText = "LEAD RESPONSIBILITY"; break;
                                        //case 9: badgeClass = "bg-danger"; badgeText = "GADC RESPONSIBILITY"; break;
                                        //case 10: badgeClass = "bg-danger"; badgeText = "AUTOVALID"; break;
                                        //case 11: badgeClass = "bg-secondary"; badgeText = "CANCELLED"; break;
                                }
                            }
                            <span class="badge @badgeClass">@badgeText</span>
                        </td>
                        <td>@item.DateCreated.ToString("MMM dd yyyy")</td>
                        <td class="font-mono fw-semibold" style="color:var(--lead-primary)">@item.PcrNumber</td>
                        <td>@item.StoreName</td>
                        <td>@item.ItemID</td>
                        <td>@item.ComplaintIssueDesc</td>
                        <td>@item.VendorName</td>
                        <td>@item.SupplierRemarksDesc</td>
                        <td>@item.QARemarksDesc</td>
                        <td class="text-end">
                            <a href="@Url.Action("Details", "ComplaintReport", new { docId = item.DocID })" class="btn btn-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 mt-2 border-top">
        <span class="small text-secondary" id="pcrPageInfo"></span>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <ul class="pagination pagination-sm mb-0" id="pcrPagination"></ul>
            <div class="input-group input-group-sm" style="width:150px;">
                <input type="number" min="1" class="form-control" id="pcrPageJumpInput" placeholder="Page #">
                <button class="btn btn-outline-primary" type="button" id="pcrPageJumpBtn">Go</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

<script src="~/Scripts/complaintreport/index.js"></script>
