@model StoreManagement.Models.Pcr
@using System.Linq
@using System.Configuration

@{
    //ViewBag.Title = "PCR Details";

    string statusBadgeClass = "is-info"; string statusBadgeText = "TRANSMITTED";
    switch (Model.PcrStatus)
    {
        case 2: statusBadgeClass = "is-success"; statusBadgeText = "CLOSED"; break;
        case 3: statusBadgeClass = "is-warning"; statusBadgeText = "RE-OPENED"; break;
        case 4: statusBadgeClass = "is-success"; statusBadgeText = "VALID"; break;
        case 5: statusBadgeClass = "is-brand"; statusBadgeText = "INVALID"; break;
        case 6: statusBadgeClass = "is-warning"; statusBadgeText = "FOR FURTHER INVESTIGATION"; break;
        case 7: statusBadgeClass = "is-info"; statusBadgeText = "REVALIDATED"; break;
        case 8: statusBadgeClass = "is-success"; statusBadgeText = "LEAD RESPONSIBILITY"; break;
        case 9: statusBadgeClass = "is-success"; statusBadgeText = "GADC RESPONSIBILITY"; break;
        case 10: statusBadgeClass = "is-success"; statusBadgeText = "AUTOVALID"; break;
        case 11: statusBadgeClass = ""; statusBadgeText = "CANCELLED"; break;
    }
}

<link href="~/Content/complaints/complaints.css" rel="stylesheet" />

<div class="main-list-page">

    <!-- =========================================
         PCR RECORD HERO BANNER
         ========================================= -->

    <div class="main-hero is-record">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Product complaint" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("Index", "ComplaintReport")"
                   class="main-hero-back"
                   title="Back to Product Complaint Report"
                   aria-label="Back to Product Complaint Report">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <span>Complaints</span>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <a href="@Url.Action("Index", "ComplaintReport")">Product Complaint Report</a>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span>@Model.PcrNumber</span>
            </nav>

            <div class="main-hero-title-row">
                <h2 class="main-hero-heading">PCR No: @Model.PcrNumber</h2>
                <span class="main-badge @statusBadgeClass">@statusBadgeText</span>
            </div>

            <p class="main-hero-description">
                Complaint details with vendor, QA and GADC remarks and findings.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-building-o" aria-hidden="true"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Store</div>
                        <div class="main-hero-feature-desc">@Model.StoreNumber - @Model.StoreName</div>
                    </div>
                </div>

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-user-o" aria-hidden="true"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Filed By</div>
                        <div class="main-hero-feature-desc">@Model.FiledBy</div>
                    </div>
                </div>

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-calendar-o" aria-hidden="true"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Created</div>
                        <div class="main-hero-feature-desc">@Model.DateCreated.ToString("MM/dd/yyyy hh:mm tt")</div>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <div class="complaints-actions no-print">
        <a href="@Url.Action("Index", "ComplaintReport")" class="btn main-form-cancel-btn">
            <i class="fa fa-arrow-left me-2"></i>Back to List
        </a>
        <button type="button" class="btn main-outline-btn" onclick="printPcrDetails()">
            <i class="fa fa-print"></i>Print
        </button>
    </div>

    <section class="complaints-card">
        <div class="main-view-card-header">
            <h4><span class="main-view-card-icon"><i class="fa fa-info-circle"></i></span>Main Details</h4>
        </div>
        <dl class="row gx-3 main-view-fields">
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Create Date/Time</dt>
                <dd>@Model.DateCreated.ToString("MM/dd/yyyy hh:mm tt")</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Store</dt>
                <dd>@Model.StoreNumber - @Model.StoreName</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Manager-In-Charge</dt>
                <dd>@Model.ManagerInCharge</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Filed By</dt>
                <dd>@Model.FiledBy</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Store Contact</dt>
                <dd>@Model.StoreContact</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-5 main-view-field">
                <dt>Store Email</dt>
                <dd>@Model.StoreEmail</dd>
            </div>
        </dl>
    </section>

    <section class="complaints-card">
        <div class="main-view-card-header">
            <h4><span class="main-view-card-icon"><i class="fa fa-cube"></i></span>Product Being Complained</h4>
        </div>
        <dl class="row gx-3 main-view-fields">
            <div class="col-12 col-md-6 col-lg-2 main-view-field">
                <dt>Incident Date</dt>
                <dd>@Model.IncidentDate.ToString("MM/dd/yyyy")</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-2 main-view-field">
                <dt>Delivery Date</dt>
                <dd>@(Model.DeliveryDate.HasValue ? Model.DeliveryDate.Value.ToString("MM/dd/yyyy") : "-")</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-3 main-view-field">
                <dt>Complaint Issue</dt>
                <dd>@Model.ComplaintIssueDesc</dd>
            </div>
            <div class="col-12 col-md-6 col-lg-5 main-view-field">
                <dt>Particulars</dt>
                <dd>@Model.Particulars</dd>
            </div>
        </dl>

        <div class="main-list-table-wrapper complaints-items">
            <div class="table-responsive">
                <table class="table main-list-table">
                    <thead>
                        <tr>
                            <th>ITEM CODE</th>
                            <th>DESCRIPTION</th>
                            <th class="is-num">QTY</th>
                            <th>UOM</th>
                            <th>BATCH CODE</th>
                            <th>UTD</th>
                            <th>VENDOR</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.ItemID</td>
                            <td>@Model.ItemDesc</td>
                            <td class="is-num">@Model.Qty</td>
                            <td>@Model.UOM</td>
                            <td>@Model.BatchCode</td>
                            <td>@Model.UTD.ToString("MM/dd/yyyy")</td>
                            <td>@Model.VendorName</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="main-form-group">
            <span class="main-form-label">Additional Message</span>
            <textarea class="form-control complaints-findings-readonly" rows="6" disabled>@Model.Remarks</textarea>
        </div>
    </section>

    @Html.Partial("~/Views/ComplaintReport/_PartialView/_DetailsAttachments.cshtml", Model)

    @if (Model.ComFlag == 0)
    {
        string vBadgeClass = "is-info"; string vBadgeText = "TRANSMITTED";
        switch (Model.SupplierRemarks)
        {
            case 4: vBadgeClass = "is-success"; vBadgeText = "VALID"; break;
            case 5: vBadgeClass = "is-warning"; vBadgeText = "INVALID"; break;
            case 6: vBadgeClass = "is-info"; vBadgeText = "FOR FURTHER INVESTIGATION"; break;
        }

        <section class="complaints-card">
            <div class="main-view-card-header">
                <h4><span class="main-view-card-icon"><i class="fa fa-truck"></i></span>Vendor Remarks / Findings</h4>
                <span class="main-badge main-view-readonly-tag"><i class="fa fa-lock"></i> View only</span>
            </div>
            <div class="complaints-remarks">
                <div class="complaints-remarks-side">
                    <span class="main-badge @vBadgeClass">@vBadgeText</span>
                    <div class="main-view-field">
                        <dl class="mb-0">
                            <dt>Response Date</dt>
                            <dd>@(Model.SupplierResDate.HasValue ? Model.SupplierResDate.Value.ToString("MM/dd/yyyy hh:mm tt") : "-")</dd>
                        </dl>
                    </div>
                </div>
                <div class="complaints-remarks-main">
                    <div class="main-form-group">
                        <span class="main-form-label">Findings</span>
                        <textarea class="form-control complaints-findings-readonly" rows="6" disabled>@Model.SupplierFindings</textarea>
                    </div>
                </div>
            </div>
        </section>
    }

    @{
        string qBadgeClass = "is-info"; string qBadgeText = "TRANSMITTED";
        switch (Model.QARemarks)
        {
            case 5: qBadgeClass = "is-warning"; qBadgeText = "INVALID"; break;
            case 6: qBadgeClass = "is-info"; qBadgeText = "FOR FURTHER INVESTIGATION"; break;
            case 7: qBadgeClass = "is-info"; qBadgeText = "REVALIDATED"; break;
            case 8: qBadgeClass = "is-success"; qBadgeText = "LEAD RESPONSIBILITY"; break;
            case 9: qBadgeClass = "is-success"; qBadgeText = "GADC RESPONSIBILITY"; break;
            case 10: qBadgeClass = "is-success"; qBadgeText = "AUTOVALID"; break;
        }
    }

    <section class="complaints-card">
        <div class="main-view-card-header">
            <h4><span class="main-view-card-icon"><i class="fa fa-check-circle"></i></span>LLII QA Remarks / Findings</h4>
        </div>
        <div class="complaints-remarks">
            <div class="complaints-remarks-side">
                <span class="main-badge @qBadgeClass">@qBadgeText</span>
                <div class="main-view-field">
                    <dl class="mb-0">
                        <dt>Response Date</dt>
                        <dd>@(Model.QAResDate.HasValue ? Model.QAResDate.Value.ToString("MM/dd/yyyy hh:mm tt") : "-")</dd>
                    </dl>
                </div>

                @if (Model.PcrStatus != 2)
                {
                    <div class="main-form-group no-print">
                        <label for="QARemarks">New Remarks</label>
                        <select class="form-control" id="QARemarks">
                            <option value="6">For Further Investigation</option>
                            <option value="10">AutoValid</option>
                            <option value="7">Revalidated</option>
                            <option value="5">Invalid</option>
                            <option value="8">Lead Responsibility</option>
                            <option value="9">GADC Responsibility</option>
                        </select>
                    </div>
                }
            </div>
            <div class="complaints-remarks-main">
                <div class="main-form-group">
                    <span class="main-form-label">Latest Findings</span>
                    <textarea class="form-control complaints-findings-readonly" rows="6" disabled>@Model.QAFindings</textarea>
                </div>

                @if (Model.PcrStatus != 2)
                {
                    <div class="main-form-group no-print">
                        <label for="QAFindings">Add Findings</label>
                        <textarea class="form-control complaints-findings-input" id="QAFindings" rows="4" placeholder="Add your findings..."></textarea>
                    </div>
                    <input type="hidden" id="DocID" value="@Model.DocID" />
                    <button id="saveQAFindings" class="btn main-form-save-btn no-print">
                        <i class="fa fa-paper-plane"></i>Update Findings
                    </button>
                }
                else
                {
                    <div class="main-inline-alert is-warning mt-3">
                        <i class="fa fa-exclamation-triangle"></i>
                        <span>This PCR has been finalized. You cannot edit the QA Remarks/Findings.</span>
                    </div>
                }
            </div>
        </div>
    </section>

    @if (Model.ComFlag == 0)
    {
        string gBadgeClass = "is-info"; string gBadgeText = "TRANSMITTED";
        switch (Model.GADCRemarks)
        {
            case 5: gBadgeClass = "is-warning"; gBadgeText = "INVALID"; break;
            case 6: gBadgeClass = "is-info"; gBadgeText = "FOR FURTHER INVESTIGATION"; break;
            case 7: gBadgeClass = "is-info"; gBadgeText = "REVALIDATED"; break;
            case 8: gBadgeClass = "is-success"; gBadgeText = "LEAD RESPONSIBILITY"; break;
            case 9: gBadgeClass = "is-success"; gBadgeText = "GADC RESPONSIBILITY"; break;
            case 10: gBadgeClass = "is-success"; gBadgeText = "AUTOVALID"; break;
        }

        <section class="complaints-card">
            <div class="main-view-card-header">
                <h4><span class="main-view-card-icon"><i class="fa fa-shield"></i></span>GADC Remarks / Findings</h4>
                <span class="main-badge main-view-readonly-tag"><i class="fa fa-lock"></i> View only</span>
            </div>
            <div class="complaints-remarks">
                <div class="complaints-remarks-side">
                    <span class="main-badge @gBadgeClass">@gBadgeText</span>
                    <div class="main-view-field">
                        <dl class="mb-0">
                            <dt>Response Date</dt>
                            <dd>@(Model.GADCResDate.HasValue ? Model.GADCResDate.Value.ToString("MM/dd/yyyy hh:mm tt") : "-")</dd>
                        </dl>
                    </div>
                </div>
                <div class="complaints-remarks-main">
                    <div class="main-form-group">
                        <span class="main-form-label">Findings</span>
                        <textarea class="form-control complaints-findings-readonly" rows="6" disabled>@Model.GADCFindings</textarea>
                    </div>
                </div>
            </div>
        </section>
    }

</div>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script>
    window.COMPLAINT_REPORT_DETAILS = {
        respondUrl: '@Url.Action("Respond", "ComplaintReport")'
    };
</script>
<script src="~/Scripts/complaintreport/details.js"></script>
