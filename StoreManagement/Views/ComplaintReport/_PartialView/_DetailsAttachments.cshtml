@model StoreManagement.Models.Pcr
@using System.Linq
@using System.Configuration

@{
    string attachmentsBaseUrl = ConfigurationManager.AppSettings["PCRAttachmentsBaseUrl"] ?? "";
    // "~/..." resolves inside this app (works under an IIS virtual directory); full URLs pass through unchanged.
    if (attachmentsBaseUrl.StartsWith("~/"))
    {
        attachmentsBaseUrl = Url.Content(attachmentsBaseUrl);
    }
}

<section class="complaints-card">
    <div class="main-view-card-header">
        <h4><span class="main-view-card-icon"><i class="fa fa-paperclip"></i></span>Attachments</h4>
    </div>
    @{
        var attachments = new[] { Model.Attachment1, Model.Attachment2, Model.Attachment3, Model.Attachment4 };
        var labels = new[] { "Attachment 1", "Attachment 2", "Attachment 3", "Attachment 4" };
        bool hasAny = attachments.Any(a => !string.IsNullOrEmpty(a));
    }
    @if (hasAny && !string.IsNullOrEmpty(attachmentsBaseUrl))
    {
        <div class="row g-3">
            @{
                var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".heic", ".heif" };
                var videoExtensions = new[] { ".mp4", ".webm", ".ogg" };
            }
            @for (int i = 0; i < attachments.Length; i++)
            {
                var file = attachments[i];
                if (string.IsNullOrEmpty(file)) { continue; }
                var filePath = attachmentsBaseUrl.TrimEnd('/') + "/" + file;
                var extension = System.IO.Path.GetExtension(file)?.ToLower() ?? "";
                var fileTypeLabel = extension.TrimStart('.').ToUpper();

                <div class="col-12 col-md-6">
                    <div class="complaints-attachment">
                        <h6 class="complaints-attachment-label">@labels[i]</h6>
                        @if (imageExtensions.Contains(extension))
                        {
                            <img src="@filePath" class="complaints-attachment-file img-fluid" alt="@labels[i]"
                                 onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                            <div class="complaints-attachment-placeholder" style="display:none;">
                                <i class="fa fa-file-image-o"></i>
                                <span>Preview not available@(extension == ".heic" || extension == ".heif" ? " (HEIC/HEIF isn't supported by most browsers)" : "")</span>
                                <a href="@filePath" target="_blank" class="btn main-outline-btn"><i class="fa fa-external-link"></i>Open File</a>
                            </div>
                        }
                        else if (extension == ".pdf")
                        {
                            <embed src="@filePath" type="application/pdf" class="complaints-attachment-embed" />
                        }
                        else if (videoExtensions.Contains(extension))
                        {
                            <video class="complaints-attachment-embed" controls
                                   onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <source src="@filePath" type="video/@extension.Replace(".", "")" />
                            </video>
                            <div class="complaints-attachment-placeholder" style="display:none;">
                                <i class="fa fa-file-video-o"></i>
                                <span>Preview not available</span>
                                <a href="@filePath" target="_blank" class="btn main-outline-btn"><i class="fa fa-external-link"></i>Open File</a>
                            </div>
                        }
                        else
                        {
                            <div class="complaints-attachment-placeholder">
                                <i class="fa fa-file-text-o"></i>
                                <span>@(string.IsNullOrEmpty(fileTypeLabel) ? "File" : fileTypeLabel + " file")</span>
                                <a href="@filePath" target="_blank" class="btn main-outline-btn"><i class="fa fa-external-link"></i>Open File</a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else if (hasAny)
    {
        <span class="complaints-attachment-note">Attachments exist for this PCR, but the attachments file server URL has not been configured yet. Set "PCRAttachmentsBaseUrl" in Web.config.</span>
    }
    else
    {
        <div class="main-empty">No attachments</div>
    }
</section>
