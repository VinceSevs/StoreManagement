@model IEnumerable<StoreManagement.Models.Ncr>

<div class="main-list-table-wrapper">

    <div class="table-responsive">

        <table class="table main-list-table complaints-table" id="ncrTable">
            <thead>
                <tr>
                    <th class="ncr-sortable" data-col="0">
                        <div class="th-content">
                            <span class="th-label">STATUS</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Status"><i class="fa fa-sort sort-icon" aria-hidden="true"></i></button>
                        </div>
                    </th>
                    <th class="ncr-sortable" data-col="1">
                        <div class="th-content">
                            <span class="th-label">CREATE DATE</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Create Date"><i class="fa fa-sort sort-icon" aria-hidden="true"></i></button>
                        </div>
                    </th>
                    <th class="ncr-sortable" data-col="2">
                        <div class="th-content">
                            <span class="th-label">NCR NO.</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by NCR No."><i class="fa fa-sort sort-icon" aria-hidden="true"></i></button>
                        </div>
                    </th>
                    <th class="ncr-sortable" data-col="3">
                        <div class="th-content">
                            <span class="th-label">STORE NAME</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Store Name"><i class="fa fa-sort sort-icon" aria-hidden="true"></i></button>
                        </div>
                    </th>
                    <th class="ncr-sortable" data-col="4">
                        <div class="th-content">
                            <span class="th-label">FILED BY</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Filed By"><i class="fa fa-sort sort-icon" aria-hidden="true"></i></button>
                        </div>
                    </th>
                    <th class="main-actions-sticky">ACTION</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    int filterStatus = item.NcrStatus == 0 ? 20 : item.NcrStatus;
                    <tr class="ncr-row" data-status="@filterStatus" data-date="@item.DateCreated.ToString("yyyy-MM-dd")">
                        <td>
                            @{
                                string badgeClass = "is-info";
                                string badgeText = "TRANSMITTED";
                                switch (item.NcrStatus)
                                {
                                    case 23: badgeClass = "is-warning"; badgeText = "FOR FURTHER INVESTIGATION"; break;
                                    case 24: badgeClass = "is-success"; badgeText = "CLOSED"; break;
                                    case 29: badgeClass = ""; badgeText = "CANCELLED"; break;
                                }
                            }
                            <span class="main-badge @badgeClass">@badgeText</span>
                        </td>
                        <td>@item.DateCreated.ToString("MMM dd yyyy")</td>
                        <td><span class="main-chip">@item.NcrNumber</span></td>
                        <td>@item.StoreName</td>
                        <td>@item.FiledBy</td>
                        <td class="main-actions-sticky">
                            <a href="@Url.Action("Details", "Ncr", new { docId = item.DocID })" class="btn btn-primary btn-sm">View</a>
                        </td>
                    </tr>
                }
                <tr class="main-empty-row" id="ncrEmptyRow" hidden>
                    <td colspan="6">
                        <div class="main-empty-state">
                            <div class="main-empty-state-icon"><i class="fa fa-search"></i></div>
                            <div class="main-empty-state-title">No non-conformance reports found</div>
                            <div class="main-empty-state-text">Try a different search or clear the filters.</div>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>

    </div>

</div>

<div class="main-list-pagination">

    <div class="main-pagination-size">
        <span>Show</span>

        <select id="ncrPageSize" class="form-control" aria-label="Rows per page">
            <option value="10">10</option>
            <option value="25">25</option>
            <option value="50">50</option>
            <option value="100">100</option>
        </select>

        <span class="main-pagination-entries">entries</span>
    </div>

    <div class="main-pagination-summary" id="ncrPageInfo">
        Showing 0 entries
    </div>

    <div class="complaints-pagination-end">

        <div class="main-pagination-controls" id="ncrPagination">
            <!-- Rendered by index.js -->
        </div>

        <div class="complaints-page-jump">
            <span>Go to</span>
            <input type="number" min="1" class="form-control" id="ncrPageJumpInput" placeholder="Page #" aria-label="Page number">
            <button class="btn main-pagination-btn" type="button" id="ncrPageJumpBtn">Go</button>
        </div>

    </div>

</div>
