@model StoreManagement.Models.Ncr
@using System.Linq
@using System.Configuration

@{
    ViewBag.Title = "NCR Details";
    string attachmentsBaseUrl = ConfigurationManager.AppSettings["NCRAttachmentsBaseUrl"] ?? "";

    string statusBadgeClass = "bg-info"; string statusBadgeText = "TRANSMITTED";
    switch (Model.NcrStatus)
    {
        case 23: statusBadgeClass = "bg-warning"; statusBadgeText = "FOR FURTHER INVESTIGATION"; break;
        case 24: statusBadgeClass = "bg-primary"; statusBadgeText = "CLOSED"; break;
        case 29: statusBadgeClass = "bg-secondary"; statusBadgeText = "CANCELLED"; break;
    }
}

<link href="~/Content/ncr/details.css" rel="stylesheet" />

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3 no-print">
    <a href="@Url.Action("Index", "Ncr")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Back to List
    </a>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-outline-primary btn-sm" onclick="printNcrDetails()">
            <i class="bi bi-printer"></i> Print
        </button>
        <span class="badge @statusBadgeClass px-3 py-2">@statusBadgeText</span>
    </div>
</div>

<div class="d-none d-print-block mb-3">
    <span class="badge @statusBadgeClass px-3 py-2">@statusBadgeText</span>
</div>

<div class="lead-page-header">
    <div class="lead-page-icon"><i class="bi bi-exclamation-diamond"></i></div>
    <div>
        <div class="lead-eyebrow">Complaint Report / Non-Conformance Report</div>
        <h1>NCR No: @Model.NcrNumber</h1>
    </div>
</div>

<div class="card shadow-sm ncr-card mb-4">
    <div class="ncr-section-header"><i class="bi bi-info-circle"></i> Main Details</div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="ncr-field">
                    <span class="ncr-field-label">Create Date/Time</span>
                    <span class="ncr-field-value">@Model.DateCreated.ToString("MM/dd/yyyy hh:mm tt")</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ncr-field">
                    <span class="ncr-field-label">Store</span>
                    <span class="ncr-field-value">@Model.StoreNumber - @Model.StoreName</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ncr-field">
                    <span class="ncr-field-label">Manager-In-Charge</span>
                    <span class="ncr-field-value">@Model.ManagerInCharge</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ncr-field">
                    <span class="ncr-field-label">Filed By</span>
                    <span class="ncr-field-value">@Model.FiledBy</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="ncr-field">
                    <span class="ncr-field-label">Store Contact</span>
                    <span class="ncr-field-value">@Model.StoreContact</span>
                </div>
            </div>
            <div class="col-md-5">
                <div class="ncr-field">
                    <span class="ncr-field-label">Store Email</span>
                    <span class="ncr-field-value">@Model.StoreEmail</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm ncr-card mb-4">
    <div class="ncr-section-header"><i class="bi bi-card-text"></i> Complaint</div>
    <div class="card-body">
        <div class="row g-4 mb-3">
            <div class="col-md-4">
                <div class="ncr-field">
                    <span class="ncr-field-label">Complaint Issue</span>
                    <span class="ncr-field-value">@Model.ComplaintIssueDesc</span>
                </div>
            </div>
            <div class="col-md-8">
                <div class="ncr-field">
                    <span class="ncr-field-label">Subject</span>
                    <span class="ncr-field-value">@Model.Subject</span>
                </div>
            </div>
        </div>

        <div class="ncr-field">
            <span class="ncr-field-label">Message</span>
            <textarea class="form-control ncr-findings-readonly" rows="6" disabled>@Model.Remarks</textarea>
        </div>
    </div>
</div>

<div class="card shadow-sm ncr-card mb-4">
    <div class="ncr-section-header"><i class="bi bi-paperclip"></i> Attachments</div>
    <div class="card-body">
        @{
            var attachments = new[] { Model.Attachment1, Model.Attachment2, Model.Attachment3, Model.Attachment4 };
            var labels = new[] { "Attachment 1", "Attachment 2", "Attachment 3", "Attachment 4" };
            bool hasAny = attachments.Any(a => !string.IsNullOrEmpty(a));
            var imageExtensions = new[] { ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".webp", ".heic", ".heif" };
            var videoExtensions = new[] { ".mp4", ".webm", ".ogg" };
        }
        @if (hasAny && !string.IsNullOrEmpty(attachmentsBaseUrl))
        {
            <div class="row g-3">
                @for (int i = 0; i < attachments.Length; i++)
                {
                    var file = attachments[i];
                    if (string.IsNullOrEmpty(file)) { continue; }
                    var filePath = attachmentsBaseUrl.TrimEnd('/') + "/" + file;
                    var extension = System.IO.Path.GetExtension(file)?.ToLower() ?? "";
                    var fileTypeLabel = extension.TrimStart('.').ToUpper();

                    <div class="col-md-6 col-sm-6 text-center">
                        <div class="attachment-box p-2 border rounded shadow-sm">
                            <h6 class="small text-uppercase text-secondary fw-semibold">@labels[i]</h6>
                            @if (imageExtensions.Contains(extension))
                            {
                                <img src="@filePath" class="attachment-file img-fluid" alt="@labels[i]"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                                <div class="attachment-placeholder" style="display:none;">
                                    <i class="bi bi-file-earmark-image"></i>
                                    <span>Preview not available@(extension == ".heic" || extension == ".heif" ? " (HEIC/HEIF isn't supported by most browsers)" : "")</span>
                                    <a href="@filePath" target="_blank" class="btn btn-sm btn-outline-primary mt-1">Open File</a>
                                </div>
                            }
                            else if (extension == ".pdf")
                            {
                                <embed src="@filePath" type="application/pdf" class="attachment-file" style="width:100%;height:220px;" />
                            }
                            else if (videoExtensions.Contains(extension))
                            {
                                <video class="attachment-file" style="width:100%;height:220px;object-fit:cover;" controls
                                       onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                    <source src="@filePath" type="video/@extension.Replace(".", "")" />
                                </video>
                                <div class="attachment-placeholder" style="display:none;">
                                    <i class="bi bi-file-earmark-play"></i>
                                    <span>Preview not available</span>
                                    <a href="@filePath" target="_blank" class="btn btn-sm btn-outline-primary mt-1">Open File</a>
                                </div>
                            }
                            else
                            {
                                <div class="attachment-placeholder">
                                    <i class="bi bi-file-earmark-text"></i>
                                    <span>@(string.IsNullOrEmpty(fileTypeLabel) ? "File" : fileTypeLabel + " file")</span>
                                    <a href="@filePath" target="_blank" class="btn btn-sm btn-outline-primary mt-1">Open File</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else if (hasAny)
        {
            <span class="text-muted">Attachments exist for this NCR, but the attachments file server URL has not been configured yet. Set "NCRAttachmentsBaseUrl" in Web.config.</span>
        }
        else
        {
            <span class="text-muted">No attachments</span>
        }
    </div>
</div>

<div class="card shadow-sm ncr-card mb-4">
    <div class="ncr-section-header"><i class="bi bi-headset"></i> LLII Customer Care Remarks / Findings</div>
    <div class="row g-0">
        <div class="col-md-3 p-3 ncr-status-panel">
            @{
                string csBadgeClass = "bg-info"; string csBadgeText = "TRANSMITTED";
                switch (Model.CSRemarks)
                {
                    case 21: csBadgeClass = "bg-success"; csBadgeText = "VALID"; break;
                    case 22: csBadgeClass = "bg-warning"; csBadgeText = "INVALID"; break;
                    case 23: csBadgeClass = "bg-primary"; csBadgeText = "FOR FURTHER INVESTIGATION"; break;
                }
            }
            <span class="badge @csBadgeClass">@csBadgeText</span>
            <div class="ncr-field mt-3">
                <span class="ncr-field-label">Response Date</span>
                <span class="ncr-field-value">@(Model.CSResDate.HasValue ? Model.CSResDate.Value.ToString("MM/dd/yyyy hh:mm tt") : "-")</span>
            </div>

            @if (Model.NcrStatus != 24)
            {
                <div class="mt-3 no-print">
                    <span class="ncr-field-label">New Remarks</span>
                    <select class="form-select form-select-sm" id="CSRemarks">
                        <option value="21">Valid</option>
                        <option value="22">Invalid</option>
                        <option value="23">For Further Investigation</option>
                    </select>
                </div>
            }
        </div>
        <div class="col-md-9 p-3">
            <div class="ncr-field">
                <span class="ncr-field-label">Latest Findings</span>
                <textarea class="form-control ncr-findings-readonly" rows="6" disabled>@Model.CSFindings</textarea>
            </div>

            @if (Model.NcrStatus != 24)
            {
                <div class="ncr-field mt-3 no-print">
                    <span class="ncr-field-label">Add Findings</span>
                    <textarea class="form-control" id="CSFindings" rows="4" placeholder="Add your findings..."></textarea>
                </div>
                <input type="hidden" id="DocID" value="@Model.DocID" />
                <button id="saveCSFindings" class="btn btn-primary btn-sm mt-2 no-print">
                    <i class="bi bi-send-check"></i> Update Findings
                </button>
            }
            else
            {
                <div class="alert alert-warning mt-3 mb-0 py-2 small">
                    This NCR has been finalized. You cannot edit the Customer Care Remarks/Findings.
                </div>
            }
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script>
    window.NCR_DETAILS = {
        respondUrl: '@Url.Action("Respond", "Ncr")'
    };
</script>
<script src="~/Scripts/ncr/details.js"></script>
