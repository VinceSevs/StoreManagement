@model IEnumerable<StoreManagement.Models.Store>

<link href="~/Content/store/index.css" rel="stylesheet" />

<div class="lead-page-header">
    <div class="lead-page-icon"><i class="bi bi-shop"></i></div>
    <div>
        <div class="lead-eyebrow">Store Management</div>
        <h1>Store List</h1>
    </div>
</div>

<div class="card shadow-sm store-list-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="fw-semibold text-secondary small text-uppercase" style="letter-spacing:.04em">All Stores</span>

        @using (Html.BeginForm("Index", "Store", FormMethod.Get))
        {
            <div class="position-relative" style="width: 280px;">
                <input type="text" id="search" name="search" value="@ViewBag.Search" autocomplete="off"
                       class="form-control lead-search"
                       placeholder="Search stores, cities..."
                       aria-label="Search" />

                <div id="searchSuggestions" class="list-group position-absolute w-100 shadow-sm mt-1"
                     style="display:none; z-index:1000; max-height: 250px; overflow-y: auto;">
                </div>
            </div>
        }
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 lead-table" id="storeTable">
            <thead>
                <tr>
                    <th>Store Number</th>
                    <th>Store Name</th>
                    <th>City Name</th>
                    <th>Coordinates</th>
                    <th>State</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var store in Model)
                {
                    <tr class="store-row">
                        <td class="font-mono fw-semibold" style="color:var(--lead-primary)">@store.StoreNumber</td>
                        <td>@store.StoreName</td>
                        <td>@store.CityName</td>
                        <td>@store.Coordinates</td>
                        <td>@store.StateName</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button onclick="openModal('@Url.Action("Details", new { id = store.StoreID })')"
                                        class="btn btn-primary">View</button>
                                <button onclick="openModal('@Url.Action("Edit", new { id = store.StoreID })')"
                                        class="btn btn-outline-primary">Update</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 pt-3 mt-2 border-top">
        <span class="small text-secondary" id="storePageInfo"></span>
        <div class="d-flex align-items-center flex-wrap gap-2">
            <ul class="pagination pagination-sm mb-0" id="storePagination"></ul>
            <div class="input-group input-group-sm" style="width:150px;">
                <input type="number" min="1" class="form-control" id="storePageJumpInput" placeholder="Page #">
                <button class="btn btn-outline-primary" type="button" id="storePageJumpBtn">Go</button>
            </div>
        </div>
    </div>
</div>

<!-- for modals -->

<div id="modalOverlay" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1050;">
    <div id="modalBox" class="shadow" style="background:#fff; width:100%; max-width:450px; margin:80px auto; border-radius:8px; overflow:hidden;">
    </div>
</div>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>

<script>
    window.STORE_INDEX_DATA = { suggestionsUrl: '@Url.Action("Suggestions", "Store")' };
</script>
<script src="~/Scripts/store/index.js"></script>
