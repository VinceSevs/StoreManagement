@model IEnumerable<StoreManagement.Models.Store>

<link href="~/Content/store/store.css" rel="stylesheet" />

<div class="main-list-page">

    <div class="main-hero">
        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Store management" />
        <div class="main-hero-gradient"></div>
        <div class="main-hero-content">
            <div class="main-hero-eyebrow">STORE MANAGEMENT</div>
            <h2 class="main-hero-heading">Stores</h2>
            <p class="main-hero-description">
                Browse store records and keep their city and location details up to date.
            </p>
            <div class="main-hero-features">
                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-building-o"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Store Directory</div>
                        <div class="main-hero-feature-desc">Every branch in one list</div>
                    </div>
                </div>
                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-map-marker"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Locations</div>
                        <div class="main-hero-feature-desc">Cities and coordinates</div>
                    </div>
                </div>
                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-pencil-square-o"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Quick Updates</div>
                        <div class="main-hero-feature-desc">Edit details in a click</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main-list-toolbar">
        @using (Html.BeginForm("Index", "Store", FormMethod.Get, new { @class = "main-list-search store-search-form" }))
        {
            <div class="input-group">
                <input type="text" id="search" name="search" value="@ViewBag.Search" autocomplete="off"
                       class="form-control"
                       placeholder="Search stores, cities..."
                       aria-label="Search" />
                <button type="submit" class="btn main-list-search-btn" title="Search">
                    <i class="fa fa-search"></i>
                    <span class="main-list-search-btn-text">Search</span>
                </button>
            </div>

            <div id="searchSuggestions" class="list-group store-suggestions" style="display:none;"></div>
        }
    </div>

    <div class="main-list-table-wrapper">
        <div class="table-responsive">
            <table class="table main-list-table" id="storeTable">
                <thead>
                    <tr>
                        <th>STORE NUMBER</th>
                        <th class="main-col-primary" data-column="store">STORE NAME</th>
                        <th>CITY NAME</th>
                        <th>COORDINATES</th>
                        <th>STATE</th>
                        <th class="actions-column main-actions-sticky" data-column="actions">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var store in Model)
                    {
                        <tr class="store-row">
                            <td><span class="main-chip">@store.StoreNumber</span></td>
                            <td data-column="store"><div class="main-row-title">@store.StoreName</div></td>
                            <td><div class="main-row-detail">@store.CityName</div></td>
                            <td><div class="main-row-detail main-tabular">@store.Coordinates</div></td>
                            <td><div class="main-row-detail">@store.StateName</div></td>
                            <td data-column="actions" class="main-actions-sticky">
                                <div class="btn-group btn-group-sm" role="group">
                                    <button type="button" class="btn btn-primary"
                                            onclick="openModal('@Url.Action("Details", new { id = store.StoreID })')">View</button>
                                    <button type="button" class="btn btn-outline-primary"
                                            onclick="openModal('@Url.Action("Edit", new { id = store.StoreID })')">Update</button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr class="main-empty-row">
                            <td colspan="6">
                                <div class="main-empty-state">
                                    <div class="main-empty-state-icon"><i class="fa fa-building-o"></i></div>
                                    <div class="main-empty-state-title">No stores found</div>
                                    <div class="main-empty-state-text">Try a different search term.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="main-list-pagination">
        <div class="main-pagination-size">
            <span>Show</span>
            <select id="storePageSize" class="form-control" aria-label="Rows per page">
                <option value="8" selected>8</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
            <span class="main-pagination-entries">entries</span>
        </div>
        <div class="main-pagination-summary" id="storePageInfo">Showing 0 entries</div>
        <div class="main-pagination-controls" id="storePagination"></div>
    </div>

</div>

<!-- Modal shell: the Details / Edit / Confirm partials load into #modalBox -->
<div id="modalOverlay" class="main-form-overlay" style="display:none;" aria-hidden="true">
    <div id="modalBox" class="main-form-modal is-auto is-sm" role="dialog" aria-modal="true"></div>
</div>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>

<script>
    window.STORE_INDEX_DATA = { suggestionsUrl: '@Url.Action("Suggestions", "Store")' };
</script>
<script src="~/Scripts/store/index.js"></script>
