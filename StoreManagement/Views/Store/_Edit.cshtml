@model StoreManagement.Models.Store
@{
    string selectedCityText = "";
    foreach (SelectListItem item in (SelectList)ViewBag.Cities)
    {
        if (item.Value == Model.CityID.ToString())
        {
            selectedCityText = item.Text;
            break;
        }
    }
}

<div class="main-form-header">
    <div class="main-form-title-wrapper">
        <div class="main-form-icon"><i class="fa fa-pencil-square-o"></i></div>
        <div>
            <h3>Edit @Model.StoreName</h3>
            <p>Store #@Model.StoreNumber</p>
        </div>
    </div>
    <button type="button" class="main-form-close" onclick="closeModal()" aria-label="Close">
        <i class="fa fa-times"></i>
    </button>
</div>
<form id="editForm" class="main-form-pinned">
    @Html.HiddenFor(m => m.StoreID)
    @Html.HiddenFor(m => m.StoreNumber)
    @Html.HiddenFor(m => m.StoreName)

    <div class="main-form-body store-edit-body">
        <div class="main-form-group position-relative" id="cityFieldWrap">
            @Html.LabelFor(m => m.CityID, "City Name")
            <input type="text" class="form-control" id="citySearchInput" placeholder="Search city..." autocomplete="off" value="@selectedCityText" />
            <div id="citySuggestions" class="list-group store-suggestions" style="display:none;"></div>
            @Html.DropDownListFor(m => m.CityID, (SelectList)ViewBag.Cities, new { @class = "form-select d-none" })
        </div>
        <div class="main-form-group">
            @Html.LabelFor(m => m.Coordinates)
            @Html.TextBoxFor(m => m.Coordinates, new { @class = "form-control" })
        </div>
    </div>
    <div class="main-form-footer">
        <button type="button" onclick="closeModal()" class="btn main-form-cancel-btn">Cancel</button>
        <button type="button" onclick="postToModal('@Url.Action("Confirm")', '#editForm')" class="btn main-form-save-btn">Update</button>
    </div>
</form>

<script>
    (function () {
        var $search = $('#citySearchInput');
        var $box = $('#citySuggestions');
        var $select = $('#CityID');

        function renderMatches(query) {
            var q = $.trim(query).toLowerCase();
            $box.empty();

            var $options = $select.find('option').filter(function () {
                return $(this).text().toLowerCase().indexOf(q) !== -1;
            }).slice(0, 8);

            if ($options.length === 0) {
                $box.append('<div class="list-group-item text-muted small">No matching city</div>');
                $box.show();
                return;
            }

            $options.each(function () {
                var text = $(this).text().trim();
                var value = $(this).val();
                $('<button type="button" class="list-group-item list-group-item-action"></button>')
                    .text(text)
                    .on('click', function () {
                        $select.val(value);
                        $search.val(text);
                        $box.hide().empty();
                    })
                    .appendTo($box);
            });
            $box.show();
        }

        $search.on('focus click input', function () {
            renderMatches($(this).val());
        });

        $(document).off('click.cityFieldWrap').on('click.cityFieldWrap', function (e) {
            if (!$(e.target).closest('#cityFieldWrap').length) {
                $box.hide();
            }
        });
    })();
</script>
