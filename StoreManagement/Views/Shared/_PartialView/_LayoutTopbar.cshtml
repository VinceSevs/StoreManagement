@{
    var currentUserProfile = StoreManagement.Models.UserAccess.Current(Context);
    string userDisplayName = currentUserProfile != null ? currentUserProfile.DisplayName : User.Identity.Name;
    string userRoleTitle = currentUserProfile != null ? currentUserProfile.RoleJobTitle : "";
    string userInitial = !string.IsNullOrWhiteSpace(userDisplayName) ? userDisplayName.Trim().Substring(0, 1).ToUpper() : "?";
}

<header class="top-header">

    <button type="button" class="sidebar-toggle active" id="sidebarToggle" aria-label="Toggle sidebar">
        <span class="sidebar-toggle-burger" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </span>
    </button>

    <div class="top-header-right">

        <div class="user-profile" id="userProfileToggle">

            <div class="user-avatar">@userInitial</div>

            <div class="user-info">
                <strong>@userDisplayName</strong>
                @if (!string.IsNullOrWhiteSpace(userRoleTitle))
                {
                    <span>@userRoleTitle</span>
                }
            </div>

            <i class="fa fa-chevron-down user-arrow"></i>

            <div class="user-dropdown-menu" id="userDropdownMenu">
                @Html.ActionLink("Account", "Account", "Account", null, new { @class = "user-dropdown-item" })
                @using (Html.BeginForm("Logout", "Account", FormMethod.Post, new { id = "logoutForm" }))
                {
                    <a href="javascript:void(0)" class="user-dropdown-item" onclick="document.getElementById('logoutForm').submit();">Sign Out</a>
                }
            </div>

        </div>

    </div>

</header>
