@{
        string currentController = (string)ViewContext.RouteData.Values["controller"];
        string currentAction = (string)ViewContext.RouteData.Values["action"];
        Func<string, string, string> navClass = (c, a) => "app-sidebar-link" +
            (string.Equals(currentController, c, System.StringComparison.OrdinalIgnoreCase)
                && string.Equals(currentAction, a, System.StringComparison.OrdinalIgnoreCase)
                ? " active" : "");
        bool isCarSectionActive = string.Equals(currentController, "Capa", System.StringComparison.OrdinalIgnoreCase);
        bool isNncrSectionActive = string.Equals(currentController, "Nncr", System.StringComparison.OrdinalIgnoreCase);
        bool isComplaintSectionActive = string.Equals(currentController, "ComplaintReport", System.StringComparison.OrdinalIgnoreCase)
    || string.Equals(currentController, "Ncr", System.StringComparison.OrdinalIgnoreCase);

        var currentUserProfile = StoreManagement.Models.UserAccess.Current(Context);
        bool canDashboard = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Dashboard);
        bool canCar = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Car);
        bool canComplaint = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.ComplaintReport);
        bool canPdfReceipt = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.PdfReceipt);
}

            <aside class="app-sidebar" id="appSidebar">
                @if (canDashboard || canCar || canComplaint)
                {
                <div class="app-sidebar-section">
                    <i class="bi bi-patch-check-fill"></i> Quality Assurance
                </div>
                }
                @if (canDashboard)
                {
                <ul class="app-sidebar-nav mb-2">
                    <li class="nav-item">
                        <a class="@navClass("Dashboard", "Index")" href="@Url.Action("Index", "Dashboard")">
                            <span class="icon-chip"><i class="bi bi-speedometer2"></i></span>
                            Dashboard
                        </a>
                    </li>
                </ul>
                }


                @*<ul class="app-sidebar-nav">
            <li class="nav-item">
                <a class="@navClass("Store", "Index")" href="@Url.Action("Index", "Store")"><i class="bi bi-shop"></i>Store List</a>
            </li>
        </ul>*@

                @if (canCar)
                {
                <ul class="app-sidebar-nav mt-2">
                    <li class="nav-item">
                        <a class="app-sidebar-link app-sidebar-toggle@(isCarSectionActive ? "" : " collapsed")" href="#" id="carSubmenuToggle" onclick="toggleCarSubmenu(event)" aria-expanded="@(isCarSectionActive ? "false" : "true")" aria-controls="carSubmenu">
                            <span class="icon-chip"><i class="bi bi-folder2-open"></i></span>
                            CAR
                            <i class="bi bi-chevron-down app-sidebar-chevron"></i>
                        </a>
                        <ul class="app-sidebar-nav app-sidebar-submenu@(isCarSectionActive ? " open" : "")" id="carSubmenu">
                            <li class="nav-item">
                                <a class="@navClass("Capa", "CapaList")" href="@Url.Action("CapaList", "Capa")">
                                    <span class="icon-chip"><i class="bi bi-clipboard-data"></i></span>
                                    CAR List
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Capa", "Quality")" href="@Url.Action("Quality", "Capa")">
                                    <span class="icon-chip"><i class="bi bi-file-earmark-plus"></i></span>
                                    CAR Report Form
                                </a>
                            </li>
                        </ul>

                        <a class="app-sidebar-link app-sidebar-toggle@(isNncrSectionActive ? "" : " collapsed")" href="#" id="nncrSubmenuToggle" onclick="toggleNncrSubmenu(event)" aria-expanded="@(isNncrSectionActive ? "false" : "true")" aria-controls="nncrSubmenu">
                            <span class="icon-chip"><i class="bi bi-folder2-open"></i></span>
                            NNCR
                            <i class="bi bi-chevron-down app-sidebar-chevron"></i>
                        </a>
                        <ul class="app-sidebar-nav app-sidebar-submenu@(isNncrSectionActive ? " open" : "")" id="nncrSubmenu">
                            <li class="nav-item">
                                <a class="@navClass("Nncr", "NncrList")" href="@Url.Action("NncrList", "Nncr")">
                                    <span class="icon-chip"><i class="bi bi-clipboard-data"></i></span>
                                    NNCR List
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Nncr", "Quality")" href="@Url.Action("Quality", "Nncr")">
                                    <span class="icon-chip"><i class="bi bi-file-earmark-plus"></i></span>
                                    NNCR Report Form
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                }

                @if (canComplaint)
                {
                <ul class="app-sidebar-nav mt-2">
                    <li class="nav-item">
                        <a class="app-sidebar-link app-sidebar-toggle@(isComplaintSectionActive ? "" : " collapsed")" href="#" id="complaintSubmenuToggle" onclick="toggleComplaintSubmenu(event)" aria-expanded="@(isComplaintSectionActive ? "false" : "true")" aria-controls="complaintSubmenu">
                            <span class="icon-chip"><i class="bi bi-clipboard-x"></i></span>
                            Complaint Report
                            <i class="bi bi-chevron-down app-sidebar-chevron"></i>
                        </a>
                        <ul class="app-sidebar-nav app-sidebar-submenu@(isComplaintSectionActive ? " open" : "")" id="complaintSubmenu">
                            <li class="nav-item">
                                <a class="@navClass("ComplaintReport", "Index")" href="@Url.Action("Index", "ComplaintReport")">
                                    <span class="icon-chip"><i class="bi bi-file-earmark-text"></i></span>
                                    Product Complaint Report
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Ncr", "Index")" href="@Url.Action("Index", "Ncr")">
                                    <span class="icon-chip"><i class="bi bi-exclamation-diamond"></i></span>
                                    Non-Conformance Report
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
                }

                @if (canPdfReceipt)
                {
                <ul class="app-sidebar-nav mt-2">
                    <li class="nav-item">
                        <a class="@navClass("Finance", "PdfReceipt")" href="@Url.Action("PdfReceipt", "Finance")">
                            <span class="icon-chip"><i class="bi bi-receipt"></i></span>
                            PDF Receipt
                        </a>
                    </li>
                </ul>
                }
            </aside>
