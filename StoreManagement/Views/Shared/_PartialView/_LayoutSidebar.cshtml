@{
    var currentController = ViewContext.RouteData.Values["controller"] != null ? ViewContext.RouteData.Values["controller"].ToString() : "";
    var currentAction = ViewContext.RouteData.Values["action"] != null ? ViewContext.RouteData.Values["action"].ToString() : "";

    Func<string, string, string> subActive = (c, a) =>
        string.Equals(currentController, c, System.StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, a, System.StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    bool isDashboardActive = string.Equals(currentController, "Dashboard", System.StringComparison.OrdinalIgnoreCase);
    bool isCarSectionActive = string.Equals(currentController, "Capa", System.StringComparison.OrdinalIgnoreCase);
    bool isNncrSectionActive = string.Equals(currentController, "Nncr", System.StringComparison.OrdinalIgnoreCase);
    bool isComplaintSectionActive = string.Equals(currentController, "ComplaintReport", System.StringComparison.OrdinalIgnoreCase)
        || string.Equals(currentController, "Ncr", System.StringComparison.OrdinalIgnoreCase);
    bool isFinanceActive = string.Equals(currentController, "Finance", System.StringComparison.OrdinalIgnoreCase);

    var currentUserProfile = StoreManagement.Models.UserAccess.Current(Context);
    bool canDashboard = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Dashboard);
    bool canCar = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Car);
    bool canNncr = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.Nncr);
    bool canComplaint = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.ComplaintReport);
    bool canPdfReceipt = StoreManagement.Models.UserAccess.CanAccess(currentUserProfile, StoreManagement.Models.AppSection.PdfReceipt);
}

<aside class="sidebar" id="mainSidebar">

    <!-- LOGO -->
    <div class="sidebar-brand">
        <img src="@Url.Content("~/Content/images/icon-dark-LLII.png")" alt="LEAD Logo" class="brand-logo brand-logo-full">
        <img src="@Url.Content("~/Content/icon/favicon.ico")" alt="LEAD" class="brand-logo brand-logo-icon">
    </div>

    <!-- NAVIGATION -->
    <nav class="sidebar-nav">

        @if (canDashboard)
        {
            <a href="@Url.Action("Index", "Dashboard")"
               class="sidebar-link @(isDashboardActive ? "active" : "")">
                <span class="sidebar-icon"><i class="fa fa-tachometer"></i></span>
                <span class="sidebar-label">Dashboard</span>
            </a>
        }

        @if (canCar)
        {
            <div class="sidebar-group @(isCarSectionActive ? "open" : "")">
                <div class="sidebar-link sidebar-parent @(isCarSectionActive ? "has-active-child" : "")">
                    <a href="@Url.Action("CapaList", "Capa")" class="sidebar-parent-link">
                        <span class="sidebar-icon"><i class="fa fa-folder-open-o"></i></span>
                        <span class="sidebar-label">CAR</span>
                    </a>
                    <button type="button" class="sidebar-caret" aria-label="Toggle CAR menu"
                            aria-expanded="@(isCarSectionActive ? "true" : "false")" aria-controls="carSubmenu">
                        <i class="fa fa-angle-down"></i>
                    </button>
                </div>
                <div class="sidebar-submenu" id="carSubmenu">
                    <a href="@Url.Action("CapaList", "Capa")" class="sidebar-sublink @subActive("Capa", "CapaList")">CAR List</a>
                    <a href="@Url.Action("Quality", "Capa")" class="sidebar-sublink @subActive("Capa", "Quality")">CAR Report Form</a>
                </div>
            </div>
        }

        @if (canNncr)
        {
            <div class="sidebar-group @(isNncrSectionActive ? "open" : "")">
                <div class="sidebar-link sidebar-parent @(isNncrSectionActive ? "has-active-child" : "")">
                    <a href="@Url.Action("NncrList", "Nncr")" class="sidebar-parent-link">
                        <span class="sidebar-icon"><i class="fa fa-clipboard"></i></span>
                        <span class="sidebar-label">NNCR</span>
                    </a>
                    <button type="button" class="sidebar-caret" aria-label="Toggle NNCR menu"
                            aria-expanded="@(isNncrSectionActive ? "true" : "false")" aria-controls="nncrSubmenu">
                        <i class="fa fa-angle-down"></i>
                    </button>
                </div>
                <div class="sidebar-submenu" id="nncrSubmenu">
                    <a href="@Url.Action("NncrList", "Nncr")" class="sidebar-sublink @subActive("Nncr", "NncrList")">NNCR List</a>
                    <a href="@Url.Action("Quality", "Nncr")" class="sidebar-sublink @subActive("Nncr", "Quality")">NNCR Report Form</a>
                </div>
            </div>
        }

        @if (canComplaint)
        {
            <div class="sidebar-group @(isComplaintSectionActive ? "open" : "")">
                <div class="sidebar-link sidebar-parent @(isComplaintSectionActive ? "has-active-child" : "")">
                    <a href="@Url.Action("Index", "ComplaintReport")" class="sidebar-parent-link">
                        <span class="sidebar-icon"><i class="fa fa-exclamation-triangle"></i></span>
                        <span class="sidebar-label">Complaints</span>
                    </a>
                    <button type="button" class="sidebar-caret" aria-label="Toggle Complaints menu"
                            aria-expanded="@(isComplaintSectionActive ? "true" : "false")" aria-controls="complaintSubmenu">
                        <i class="fa fa-angle-down"></i>
                    </button>
                </div>
                <div class="sidebar-submenu" id="complaintSubmenu">
                    <a href="@Url.Action("Index", "ComplaintReport")" class="sidebar-sublink @subActive("ComplaintReport", "Index")">Product Complaint</a>
                    <a href="@Url.Action("Index", "Ncr")" class="sidebar-sublink @subActive("Ncr", "Index")">Non-Conformance</a>
                </div>
            </div>
        }

        @if (canPdfReceipt)
        {
            <a href="@Url.Action("PdfReceipt", "Finance")"
               class="sidebar-link @(isFinanceActive ? "active" : "")">
                <span class="sidebar-icon"><i class="fa fa-file-pdf-o"></i></span>
                <span class="sidebar-label">PDF Receipt</span>
            </a>
        }

    </nav>

    <!-- BOTTOM DECORATION -->
    <div class="sidebar-decoration">
        <div class="decoration-shape decoration-one"></div>
        <div class="decoration-shape decoration-two"></div>
        <div class="decoration-shape decoration-three"></div>
    </div>

</aside>
