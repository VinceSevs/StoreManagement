<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title Store Management</title>
    @Styles.Render("~/Content/bootstrap.min.css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/Content/lead-theme.css" rel="stylesheet">
    @Scripts.Render("~/bundles/modernizr")

    <style>
        :root {
            --app-primary: #7d1f27;
            --app-primary-dark: #5e161f;
            --app-primary-light: #f4e2e0;
            --app-sidebar-bg: #fffaf9;
            --app-border: #e8dcda;
            --app-navbar-height: 56px;
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
        }

        /* ---------- Top navbar ---------- */
        .app-navbar {
            background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-dark) 100%);
            box-shadow: 0 2px 12px rgba(36,19,22,.18);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .app-navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .55rem 1.25rem;
            gap: 1rem;
        }

        .app-brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-decoration: none;
            color: #fff;
        }

            .app-brand:hover {
                color: #fff;
            }

        .app-brand-logo {
            height: 34px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 2px;
        }

        .app-brand-text {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: .01em;
        }

        .sidebar-toggle-btn {
            background: rgba(255,255,255,.12);
            border: none;
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: background-color .15s ease;
        }

            .sidebar-toggle-btn:hover {
                background: rgba(255,255,255,.22);
            }

        .app-user-chip {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: #f4e2e0;
            font-size: .82rem;
            font-weight: 500;
        }

        .app-logout-btn {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.35);
            color: #fff;
            border-radius: 999px;
            padding: .35rem 1rem;
            font-size: .82rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            transition: background-color .15s ease, transform .15s ease;
        }

            .app-logout-btn:hover {
                background: rgba(255,255,255,.22);
                transform: translateY(-1px);
                color: #fff;
            }

        /* ---------- Layout shell ---------- */
        .app-shell {
            display: flex;
            align-items: stretch;
            min-height: calc(100vh - var(--app-navbar-height));
        }

        /* ---------- Sidebar ---------- */
        .app-sidebar {
            width: 248px;
            flex: none;
            position: sticky;
            top: var(--app-navbar-height);
            align-self: flex-start;
            height: calc(100vh - var(--app-navbar-height));
            overflow-y: auto;
            background: var(--app-sidebar-bg);
            border-right: 1px solid var(--app-border);
            padding: 1.25rem 1rem;
            transition: transform .25s ease, width .25s ease;
        }

        .app-sidebar-section {
            display: flex;
            align-items: center;
            gap: .45rem;
            text-transform: uppercase;
            font-size: .68rem;
            letter-spacing: .08em;
            font-weight: 700;
            color: #a68d8a;
            padding: 0 .6rem;
            margin-bottom: .9rem;
        }

        .app-sidebar-nav {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: .2rem;
        }

            .app-sidebar-nav .nav-item {
                opacity: 0;
                animation: sidebarItemIn .35s ease forwards;
            }

                .app-sidebar-nav .nav-item:nth-child(1) { animation-delay: .03s; }
                .app-sidebar-nav .nav-item:nth-child(2) { animation-delay: .08s; }
                .app-sidebar-nav .nav-item:nth-child(3) { animation-delay: .13s; }
                .app-sidebar-nav .nav-item:nth-child(4) { animation-delay: .18s; }
                .app-sidebar-nav .nav-item:nth-child(5) { animation-delay: .23s; }

        @@keyframes sidebarItemIn {
            from { opacity: 0; transform: translateX(-8px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .app-sidebar-link {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .5rem .6rem;
            border-radius: 12px;
            color: #4a3a38;
            font-size: .88rem;
            font-weight: 500;
            text-decoration: none;
            transition: background-color .18s ease, color .18s ease, transform .12s ease;
        }

            .app-sidebar-link .icon-chip {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                flex: none;
                width: 32px;
                height: 32px;
                border-radius: 9px;
                background: rgba(125, 31, 39, .07);
                color: var(--app-primary);
                font-size: 1rem;
                transition: background-color .18s ease, color .18s ease;
            }

            .app-sidebar-link .app-sidebar-chevron {
                margin-left: auto;
                color: #a68d8a;
            }

            .app-sidebar-link:hover {
                background: var(--app-primary-light);
                color: var(--app-primary-dark);
                transform: translateX(2px);
                text-decoration: none;
            }

                .app-sidebar-link:hover .icon-chip {
                    background: #fff;
                    color: var(--app-primary);
                }

            .app-sidebar-link.active {
                background: var(--app-primary);
                color: #fff;
                font-weight: 600;
            }

                .app-sidebar-link.active .icon-chip {
                    background: rgba(255,255,255,.16);
                    color: #fff;
                }

        .app-sidebar-toggle {
            cursor: pointer;
            user-select: none;
        }

        .app-sidebar-chevron {
            font-size: .7rem !important;
            transition: transform .2s ease;
        }

            .app-sidebar-toggle.collapsed .app-sidebar-chevron {
                transform: rotate(-90deg);
            }

        .app-sidebar-submenu {
            display: none;
            flex-direction: column;
            gap: .2rem;
            margin: .3rem 0 .2rem .95rem;
            padding-left: .85rem;
            border-left: 2px solid var(--app-border);
        }

            .app-sidebar-submenu.open {
                display: flex;
            }

            .app-sidebar-submenu .app-sidebar-link {
                padding: .45rem .55rem;
                font-size: .84rem;
            }

            .app-sidebar-submenu .icon-chip {
                width: 28px;
                height: 28px;
                font-size: .92rem;
            }

        .app-sidebar-overlay {
            display: none;
            position: fixed;
            top: var(--app-navbar-height);
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(36,19,22,.35);
            z-index: 1020;
        }

        /* Large desktops: a little extra breathing room */
        @@media (min-width: 1400px) {
            .app-sidebar {
                width: 272px;
                padding: 1.5rem 1.1rem;
            }
        }

        /* Small laptops / tablets in landscape: keep the sidebar docked but tighten it */
        @@media (min-width: 992px) and (max-width: 1199.98px) {
            .app-sidebar {
                width: 212px;
                padding: 1rem .7rem;
            }

            .app-sidebar-link {
                font-size: .84rem;
                padding: .45rem .5rem;
            }

            .app-sidebar-link .icon-chip {
                width: 28px;
                height: 28px;
                font-size: .92rem;
            }
        }

        /* Tablets in portrait and phones: off-canvas drawer */
        @@media (max-width: 991.98px) {
            .app-sidebar {
                position: fixed;
                top: var(--app-navbar-height);
                left: 0;
                bottom: 0;
                width: min(78vw, 288px);
                height: auto;
                z-index: 1025;
                transform: translateX(-100%);
                box-shadow: 6px 0 24px rgba(36,19,22,.18);
            }

                .app-sidebar.open {
                    transform: translateX(0);
                }

            .app-sidebar-overlay.show {
                display: block;
            }
        }

        /* Small phones: trim the drawer's own padding a touch */
        @@media (max-width: 420px) {
            .app-sidebar {
                width: min(84vw, 260px);
                padding: 1rem .85rem;
            }
        }

        .app-content {
            flex: 1 1 auto;
            min-width: 0;
        }
    </style>
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        string currentController = (string)ViewContext.RouteData.Values["controller"];
        string currentAction = (string)ViewContext.RouteData.Values["action"];
        Func<string, string, string> navClass = (c, a) => "app-sidebar-link" +
            (string.Equals(currentController, c, System.StringComparison.OrdinalIgnoreCase)
                && string.Equals(currentAction, a, System.StringComparison.OrdinalIgnoreCase)
                ? " active" : "");
        bool isCarSectionActive = string.Equals(currentController, "Capa", System.StringComparison.OrdinalIgnoreCase);

        <nav class="app-navbar navbar-dark">
            <div class="app-navbar-inner">
                <div class="d-flex align-items-center gap-2">
                    <button class="sidebar-toggle-btn d-lg-none" id="sidebarToggleBtn" type="button" aria-label="Toggle menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="app-brand" href="@Url.Action("CapaList", "Capa")">
                        <i class="bi bi-boxes" style="font-size:1.3rem;"></i>
                        @*<span class="app-brand-text">Store Management</span>*@
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="app-user-chip d-none d-sm-inline-flex">
                        <i class="bi bi-person-circle"></i> @User.Identity.Name
                    </span>
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                    {
                        <button type="submit" class="app-logout-btn"><i class="bi bi-box-arrow-right"></i> Logout</button>
                    }
                </div>
            </div>
        </nav>

        <div class="app-shell">
            <div class="app-sidebar-overlay" id="sidebarOverlay"></div>
            <aside class="app-sidebar" id="appSidebar">
                <div class="app-sidebar-section">
                    <i class="bi bi-patch-check-fill"></i> Quality Assurance
                </div>
                @*<ul class="app-sidebar-nav">
                    <li class="nav-item">
                        <a class="@navClass("Store", "Index")" href="@Url.Action("Index", "Store")"><i class="bi bi-shop"></i>Store List</a>
                    </li>
                </ul>*@

                <ul class="app-sidebar-nav mt-2">
                    <li class="nav-item">
                        <a class="app-sidebar-link app-sidebar-toggle@(isCarSectionActive ? "" : " collapsed")" href="#" id="carSubmenuToggle" onclick="toggleCarSubmenu(event)" aria-expanded="@(isCarSectionActive ? "false" : "true")" aria-controls="carSubmenu">
                            <span class="icon-chip"><i class="bi bi-folder2-open"></i></span>
                            CAR
                            <i class="bi bi-chevron-down app-sidebar-chevron"></i>
                        </a>
                        <ul class="app-sidebar-nav app-sidebar-submenu@(isCarSectionActive ? " open" : "")" id="carSubmenu">
                            <li class="nav-item">
                                <a class="@navClass("Capa", "CapaList")" href="@Url.Action("CapaList", "Capa")">
                                    <span class="icon-chip"><i class="bi bi-clipboard-data"></i></span>
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="@navClass("Capa", "Quality")" href="@Url.Action("Quality", "Capa")">
                                    <span class="icon-chip"><i class="bi bi-file-earmark-plus"></i></span>
                                    CAR Report Form
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </aside>

            <div class="app-content container-fluid body-content p-4">
                @RenderBody()
                <hr />
                <footer>
                    <p>&copy; @DateTime.Now.Year Corrective Action Report</p>
                </footer>
            </div>
        </div>

        <script>
            sessionStorage.setItem('Username', @Html.Raw(Json.Encode(User.Identity.Name)));

            (function () {
                var sidebar = document.getElementById('appSidebar');
                var overlay = document.getElementById('sidebarOverlay');
                var toggleBtn = document.getElementById('sidebarToggleBtn');

                function openSidebar() {
                    sidebar.classList.add('open');
                    overlay.classList.add('show');
                }
                function closeSidebar() {
                    sidebar.classList.remove('open');
                    overlay.classList.remove('show');
                }

                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function () {
                        sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
                    });
                }
                if (overlay) {
                    overlay.addEventListener('click', closeSidebar);
                }
            })();

            function toggleCarSubmenu(event) {
                event.preventDefault();
                var toggle = document.getElementById('carSubmenuToggle');
                var submenu = document.getElementById('carSubmenu');
                var isOpen = submenu.classList.toggle('open');
                toggle.classList.toggle('collapsed', !isOpen);
                toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }
        </script>
    }
    @if (!User.Identity.IsAuthenticated)
    {
        <nav class="app-navbar navbar-dark">
            <div class="app-navbar-inner">
                <a class="app-brand" href="@Url.Action("Login", "Account")">
                    <i class="bi bi-boxes" style="font-size:1.3rem;"></i>
                    <span class="app-brand-text">Corrective Action Report</span>
                </a>
            </div>
        </nav>
        <div class="container body-content">
            <footer>
                @RenderBody()
                <hr />
                <p>&copy; @DateTime.Now.Year Corrective Action Report</p>
            </footer>
        </div>

        <script>
            sessionStorage.removeItem('Username');
        </script>
    }
</body>
</html>
