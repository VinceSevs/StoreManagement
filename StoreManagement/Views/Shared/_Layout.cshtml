<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title Store Management</title>
    @Styles.Render("~/Content/bootstrap.min.css")
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link href="~/Content/lead-theme.css" rel="stylesheet">
    @Scripts.Render("~/bundles/modernizr")

    <style>
        :root {
            --app-primary: #7d1f27;
            --app-primary-dark: #5e161f;
            --app-primary-light: #f4e2e0;
            --app-sidebar-bg: #fffaf9;
            --app-border: #e8dcda;
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
        }

        /* ---------- Top navbar ---------- */
        .app-navbar {
            background: linear-gradient(135deg, var(--app-primary) 0%, var(--app-primary-dark) 100%);
            box-shadow: 0 2px 12px rgba(36,19,22,.18);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .app-navbar-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: .55rem 1.25rem;
            gap: 1rem;
        }

        .app-brand {
            display: flex;
            align-items: center;
            gap: .6rem;
            text-decoration: none;
            color: #fff;
        }

            .app-brand:hover {
                color: #fff;
            }

        .app-brand-logo {
            height: 34px;
            width: auto;
            border-radius: 6px;
            background: #fff;
            padding: 2px;
        }

        .app-brand-text {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 1.05rem;
            letter-spacing: .01em;
        }

        .sidebar-toggle-btn {
            background: rgba(255,255,255,.12);
            border: none;
            color: #fff;
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            transition: background-color .15s ease;
        }

            .sidebar-toggle-btn:hover {
                background: rgba(255,255,255,.22);
            }

        .app-user-chip {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            color: #f4e2e0;
            font-size: .82rem;
            font-weight: 500;
        }

        .app-logout-btn {
            background: rgba(255,255,255,.1);
            border: 1px solid rgba(255,255,255,.35);
            color: #fff;
            border-radius: 999px;
            padding: .35rem 1rem;
            font-size: .82rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            transition: background-color .15s ease, transform .15s ease;
        }

            .app-logout-btn:hover {
                background: rgba(255,255,255,.22);
                transform: translateY(-1px);
                color: #fff;
            }

        /* ---------- Layout shell ---------- */
        .app-shell {
            display: flex;
            align-items: stretch;
            min-height: calc(100vh - 56px);
        }

        /* ---------- Sidebar ---------- */
        .app-sidebar {
            width: 232px;
            flex: none;
            position: sticky;
            background: var(--app-sidebar-bg);
            border-right: 1px solid var(--app-border);
            padding: 1.1rem .8rem;
            transition: transform .25s ease, width .25s ease;
        }

        .app-sidebar-section {
            text-transform: uppercase;
            font-size: .68rem;
            letter-spacing: .08em;
            font-weight: 700;
            color: #a68d8a;
            padding: 0 .6rem;
            margin-bottom: .6rem;
        }

        .app-sidebar-nav {
            list-style: none;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: .2rem;
        }

            .app-sidebar-nav .nav-item {
                opacity: 0;
                animation: sidebarItemIn .35s ease forwards;
            }

                .app-sidebar-nav .nav-item:nth-child(1) { animation-delay: .03s; }
                .app-sidebar-nav .nav-item:nth-child(2) { animation-delay: .08s; }
                .app-sidebar-nav .nav-item:nth-child(3) { animation-delay: .13s; }
                .app-sidebar-nav .nav-item:nth-child(4) { animation-delay: .18s; }
                .app-sidebar-nav .nav-item:nth-child(5) { animation-delay: .23s; }

        @@keyframes sidebarItemIn {
            from { opacity: 0; transform: translateX(-8px); }
            to { opacity: 1; transform: translateX(0); }
        }

        .app-sidebar-link {
            display: flex;
            align-items: center;
            gap: .65rem;
            padding: .55rem .7rem;
            border-radius: 10px;
            color: #4a3a38;
            font-size: .88rem;
            font-weight: 500;
            text-decoration: none;
            border-left: 3px solid transparent;
            transition: background-color .15s ease, color .15s ease, transform .15s ease, border-color .15s ease;
        }

            .app-sidebar-link i {
                font-size: 1.02rem;
                width: 20px;
                text-align: center;
                color: #a68d8a;
                transition: color .15s ease, transform .15s ease;
            }

            .app-sidebar-link:hover {
                background: var(--app-primary-light);
                color: var(--app-primary-dark);
                transform: translateX(3px);
                text-decoration: none;
            }

                .app-sidebar-link:hover i {
                    color: var(--app-primary);
                    transform: scale(1.08);
                }

            .app-sidebar-link.active {
                background: var(--app-primary-light);
                border-left-color: var(--app-primary);
                color: var(--app-primary-dark);
                font-weight: 700;
            }

                .app-sidebar-link.active i {
                    color: var(--app-primary);
                }

        .app-sidebar-overlay {
            display: none;
            position: fixed;
            top: 56px;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(36,19,22,.35);
            z-index: 1020;
        }

        @@media (max-width: 991.98px) {
            .app-sidebar {
                position: fixed;
                top: 56px;
                left: 0;
                bottom: 0;
                z-index: 1025;
                transform: translateX(-100%);
                box-shadow: 6px 0 24px rgba(36,19,22,.18);
            }

                .app-sidebar.open {
                    transform: translateX(0);
                }

            .app-sidebar-overlay.show {
                display: block;
            }
        }

        .app-content {
            flex: 1 1 auto;
            min-width: 0;
        }
    </style>
</head>
<body>
    @if (User.Identity.IsAuthenticated)
    {
        string currentController = (string)ViewContext.RouteData.Values["controller"];
        string currentAction = (string)ViewContext.RouteData.Values["action"];
        Func<string, string, string> navClass = (c, a) => "app-sidebar-link" +
            (string.Equals(currentController, c, System.StringComparison.OrdinalIgnoreCase)
                && string.Equals(currentAction, a, System.StringComparison.OrdinalIgnoreCase)
                ? " active" : "");

        <nav class="app-navbar navbar-dark">
            <div class="app-navbar-inner">
                <div class="d-flex align-items-center gap-2">
                    <button class="sidebar-toggle-btn d-lg-none" id="sidebarToggleBtn" type="button" aria-label="Toggle menu">
                        <i class="bi bi-list"></i>
                    </button>
                    <a class="app-brand" href="@Url.Action("CapaList", "Capa")">
                        <i class="bi bi-boxes" style="font-size:1.3rem;"></i>
                        @*<span class="app-brand-text">Store Management</span>*@
                    </a>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="app-user-chip d-none d-sm-inline-flex">
                        <i class="bi bi-person-circle"></i> @User.Identity.Name
                    </span>
                    @using (Html.BeginForm("Logout", "Account", FormMethod.Post))
                    {
                        <button type="submit" class="app-logout-btn"><i class="bi bi-box-arrow-right"></i> Logout</button>
                    }
                </div>
            </div>
        </nav>

        <div class="app-shell">
            <div class="app-sidebar-overlay" id="sidebarOverlay"></div>
            <aside class="app-sidebar" id="appSidebar">
                <div class="app-sidebar-section">Store Management</div>
                <ul class="app-sidebar-nav">
                    <li class="nav-item">
                        <a class="@navClass("Capa", "CapaList")" href="@Url.Action("CapaList", "Capa")"><i class="bi bi-clipboard-data"></i>Dashboard</a>
                    </li>

                    <li class="nav-item">
                        <a class="@navClass("Capa", "Quality")" href="@Url.Action("Quality", "Capa")"><i class="bi bi-file-earmark-plus"></i>CAR Report Form</a>
                    </li>
                    <li class="nav-item">
                        <a class="@navClass("Store", "Index")" href="@Url.Action("Index", "Store")"><i class="bi bi-shop"></i>Store List</a>
                    </li>
                </ul>
            </aside>

            <div class="app-content container-fluid body-content p-4">
                @RenderBody()
                <hr />
                <footer>
                    <p>&copy; @DateTime.Now.Year Store Management</p>
                </footer>
            </div>
        </div>

        <script>
            sessionStorage.setItem('Username', @Html.Raw(Json.Encode(User.Identity.Name)));

            (function () {
                var sidebar = document.getElementById('appSidebar');
                var overlay = document.getElementById('sidebarOverlay');
                var toggleBtn = document.getElementById('sidebarToggleBtn');

                function openSidebar() {
                    sidebar.classList.add('open');
                    overlay.classList.add('show');
                }
                function closeSidebar() {
                    sidebar.classList.remove('open');
                    overlay.classList.remove('show');
                }

                if (toggleBtn) {
                    toggleBtn.addEventListener('click', function () {
                        sidebar.classList.contains('open') ? closeSidebar() : openSidebar();
                    });
                }
                if (overlay) {
                    overlay.addEventListener('click', closeSidebar);
                }
            })();
        </script>
    }
    @if (!User.Identity.IsAuthenticated)
    {
        <nav class="app-navbar navbar-dark">
            <div class="app-navbar-inner">
                <a class="app-brand" href="@Url.Action("Login", "Account")">
                    <i class="bi bi-boxes" style="font-size:1.3rem;"></i>
                    <span class="app-brand-text">Store Management</span>
                </a>
            </div>
        </nav>
        <div class="container body-content">
            <footer>
                @RenderBody()
                <hr />
                <p>&copy; @DateTime.Now.Year Store Management</p>
            </footer>
        </div>

        <script>
            sessionStorage.removeItem('Username');
        </script>
    }
</body>
</html>
