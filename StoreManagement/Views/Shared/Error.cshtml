<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Error</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@700&family=Inter:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', Arial, sans-serif;
            background: #f1e9e7;
            color: #241316;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
        }

        .error-card {
            background: #fff;
            border: 1px solid #e8dcda;
            border-radius: 16px;
            padding: 2.5rem 3rem;
            text-align: center;
            max-width: 420px;
            box-shadow: 0 12px 32px rgba(36,19,22,.08);
        }

        h1 {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            color: #7d1f27;
            margin-bottom: .5rem;
        }

        h2 {
            font-size: 1rem;
            font-weight: 500;
            color: #8f7d7b;
            margin: 0;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <hgroup>
            <h1>Error.</h1>
            <h2>An error occurred while processing your request.</h2>
        </hgroup>
    </div>
</body>
</html>
