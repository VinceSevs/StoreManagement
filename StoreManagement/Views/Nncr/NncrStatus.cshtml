@model StoreManagement.Models.NncrReport
@using StoreManagement.Models
@{
    ViewBag.Title = "NNCR Status";
    bool isResponded = Model.HasSupplierResponse;
    bool isClosed = Model.Status == NncrStatuses.Closed;
    bool canClose = (ViewBag.CanClose as bool? ?? false) && Model.IsReadyToClose;
    var email = ViewBag.SupplierEmail as IsseERP.Services.NncrNotificationService.EmailMessage;

    string badgeText = Model.StatusLabel;
    string badgeClass = Model.StatusKey == "awaiting" ? "is-info"
        : Model.StatusKey == "overdue" ? "is-brand"
        : Model.StatusKey == "approved" ? "is-success"
        : Model.StatusKey == "rejected" ? "is-warning" : "";

    // Quick facts shown in the hero; empty values are skipped
    var heroMeta = new[]
    {
        new { Icon = "fa-truck", Label = "Supplier", Value = Model.SupplierName },
        new { Icon = "fa-building-o", Label = "Site Warehouse", Value = Model.SiteWarehouseName },
        new { Icon = "fa-calendar", Label = "Response Due", Value = Model.DueDate.HasValue ? Model.DueDate.Value.ToString("MMM dd, yyyy") : "" },
        new { Icon = "fa-user", Label = "Issued By", Value = Model.IssuedByName }
    }
    .Where(m => !string.IsNullOrWhiteSpace(m.Value))
    .ToList();

    // Progress strip: Filed is always done; the first step not done is "current".
    string step1Class = "is-done";
    string step2Class = isResponded ? "is-done" : "is-current";
    string step3Class = isClosed ? "is-done" : (isResponded ? "is-current" : "");

    var jsonSettings = new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml };
    var pageConfig = Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        reportNumber = Model.ReportNumber,
        statusLabel = badgeText,
        responseToken = Model.ResponseToken,
        closeEndpoint = Url.Action("CloseNncr", "Nncr"),
        sendEmailEndpoint = Url.Action("SendSupplierEmail", "Nncr"),
        canSendEmail = Model.IsAwaitingResponse,
        email
    }, jsonSettings);
}


<link href="@Url.Content("~/Content/nncr/nncr.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/nncr/nncr.css")).Ticks" rel="stylesheet" />
<link href="@Url.Content("~/Content/css/attachments.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/css/attachments.css")).Ticks" rel="stylesheet" />

<div class="main-list-page">

    <!-- =========================================
         NNCR STATUS HERO BANNER
         ========================================= -->

    <div class="main-hero is-record">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Logistics operations" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("NncrList", "Nncr")"
                   class="main-hero-back"
                   title="Back to NNCR Reports"
                   aria-label="Back to NNCR Reports">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <a href="@Url.Action("NncrList", "Nncr")">NNCR</a>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span>Status</span>
            </nav>

            <div class="main-hero-title-row">
                <h2 class="main-hero-heading">NNCR Status</h2>
                <span class="main-chip">@Model.ReportNumber</span>
                <span class="main-badge @badgeClass"><i class="fa fa-circle"></i>@badgeText</span>
            </div>

            <p class="main-hero-description">
                Follow this non-conformance from filing to the supplier's response and closure.
            </p>

            @if (heroMeta.Any())
            {
                <div class="main-hero-features">
                    @foreach (var meta in heroMeta)
                    {
                        <div class="main-hero-feature">
                            <div class="main-hero-feature-icon">
                                <i class="fa @meta.Icon" aria-hidden="true"></i>
                            </div>
                            <div class="main-hero-feature-text">
                                <div class="main-hero-feature-label">@meta.Label</div>
                                <div class="main-hero-feature-desc">@meta.Value</div>
                            </div>
                        </div>
                    }
                </div>
            }

        </div>

    </div>


    <div class="nncr-actions nncr-status-actions">
        <a href="@Url.Action("NncrList", "Nncr")" class="btn main-form-cancel-btn nncr-actions-lead">
            <i class="fa fa-arrow-left"></i> Back to list
        </a>
        <button type="button" class="btn main-form-cancel-btn" id="supplierEmailBtn">
            <i class="fa fa-envelope-o"></i> Supplier email
        </button>
        <button type="button" class="btn main-outline-btn" id="downloadPdfBtn">
            <i class="fa fa-download"></i> Download PDF
        </button>
        @if (canClose)
        {
            <button type="button" class="btn main-form-save-btn" id="closeNncrBtn">
                <i class="fa fa-check-circle-o"></i> Close NNCR
            </button>
        }
    </div>

    <div class="nncr-doc nncr-status-page" id="nncrStatusPrintArea">

        <div class="nncr-doc-header">
            <img src="@Url.Content("~/Content/images/nncr-logo.png")" class="nncr-doc-logo" alt="LEAD Logistics Innovations, Inc." />
            <div class="nncr-doc-meta">
                <div class="nncr-doc-eyebrow">NNCR Status</div>
                <h1 class="nncr-doc-title">Reference: @Model.ReportNumber</h1>
            </div>
            <span class="main-badge @badgeClass"><i class="fa fa-circle"></i>@badgeText</span>
        </div>

        <div class="nncr-card">
            <ol class="nncr-progress" aria-label="NNCR progress">
                <li class="nncr-progress-step @step1Class">
                    <span class="nncr-progress-dot">1</span>
                    <div class="nncr-progress-title">Filed</div>
                    <div class="nncr-progress-meta">by @Model.IssuedByName</div>
                </li>
                <li class="nncr-progress-step @step2Class">
                    <span class="nncr-progress-dot">2</span>
                    <div class="nncr-progress-title">@(Model.Status == NncrStatuses.Rejected ? "Supplier Rejected" : isResponded ? "Supplier Approved" : "Supplier Response")</div>
                    <div class="nncr-progress-meta">
                        @if (isResponded)
                        {
                            <span class="nncr-mono">@(Model.AcknowledgeDate?.ToString("MMM dd, yyyy"))</span>
                        }
                        else
                        {
                            <span class="@(Model.IsOverdue ? "is-overdue" : "")">Due @(Model.DueDate?.ToString("MMM dd, yyyy"))</span>
                        }
                    </div>
                </li>
                <li class="nncr-progress-step @step3Class">
                    <span class="nncr-progress-dot">3</span>
                    <div class="nncr-progress-title">Closed</div>
                    <div class="nncr-progress-meta">
                        @if (isClosed)
                        {
                            <span class="nncr-mono">@(Model.ClosedDate?.ToString("MMM dd, yyyy"))</span>
                        }
                        else
                        {
                            <span>Not yet closed</span>
                        }
                    </div>
                </li>
            </ol>
        </div>

        @Html.Partial("~/Views/Nncr/_PartialView/_NncrDetails.cshtml", Model)

        <div class="nncr-card">
            <div class="main-view-card-header">
                <h4><span class="nncr-step-num">6</span>Supplier Response</h4>
                @if (isResponded)
                {
                    <span class="main-badge is-success">Submitted</span>
                }
                else
                {
                    <span class="main-badge @badgeClass">@badgeText</span>
                }
            </div>
            @if (isResponded)
            {
                @Html.Partial("~/Views/Nncr/_PartialView/_NncrSupplierResponse.cshtml", Model)
            }
            else
            {
                <div class="main-empty is-boxed">Awaiting supplier response &mdash; due @(Model.DueDate?.ToString("MMM dd, yyyy")) (@Model.DueText).</div>
            }
        </div>

        <div class="nncr-card">
            <div class="main-view-card-header">
                <h4><span class="nncr-step-num">7</span>Closing</h4>
                @if (isClosed)
                {
                    <span class="main-badge is-success">Closed</span>
                }
            </div>
            @if (isClosed)
            {
                <dl class="row main-view-fields">
                    <div class="col-12 col-sm-6 main-view-field">
                        <dt>Closed By</dt>
                        <dd>@Model.ClosedByName</dd>
                    </div>
                    <div class="col-12 col-sm-6 main-view-field">
                        <dt>Closed Date</dt>
                        <dd class="nncr-mono">@(Model.ClosedDate?.ToString("MMM dd, yyyy hh:mm tt"))</dd>
                    </div>
                </dl>
            }
            else if (isResponded)
            {
                <div class="nncr-muted">
                    The supplier has responded. @(canClose ? "Review the response, then use Close NNCR above." : "An authorized user will review and close this NNCR.")
                </div>
            }
            else
            {
                <div class="main-empty is-boxed">Can be closed once the supplier has responded.</div>
            }
        </div>

    </div>

    @if (ViewBag.CanViewLog == true)
    {
    <div class="nncr-doc nncr-log-wrap d-print-none">
        <div class="nncr-card" id="nncrActivityLog">
            <div class="main-view-card-header">
                <h4><span class="nncr-step-num"><i class="fa fa-history"></i></span>Activity Log</h4>
                <div class="nncr-log-tools d-print-none">
                    <span class="nncr-card-note">@Model.Logs.Count @(Model.Logs.Count == 1 ? "entry" : "entries")</span>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="logExcelBtn"><i class="fa fa-file-excel-o"></i> Export to Excel</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" id="logPdfBtn"><i class="fa fa-download"></i> Download PDF</button>
                </div>

            </div>
            @if (Model.Logs == null || Model.Logs.Count == 0)
            {
                <div class="main-empty is-boxed">No activity recorded yet.</div>
            }
            else
            {
                <div class="main-history-list">
                    @foreach (var log in Model.Logs)
                    {
                        string logIcon = log.Action == NncrLogActions.Filed ? "fa-file-text-o"
                            : log.Action == NncrLogActions.Emailed ? "fa-envelope-o"
                            : log.Action == NncrLogActions.EmailFailed ? "fa-exclamation-triangle"
                            : log.Action == NncrLogActions.Approved ? "fa-thumbs-o-up"
                            : log.Action == NncrLogActions.Rejected ? "fa-thumbs-o-down"
                            : log.Action == NncrLogActions.Closed ? "fa-check-circle-o"
                            : "fa-circle-o";
                        <div class="main-history-row">
                            <span class="main-history-icon @(log.Action == NncrLogActions.EmailFailed ? "is-error" : "")"><i class="fa @logIcon"></i></span>
                            <div class="main-history-text">
                                <div>
                                    <span class="main-history-user">@(string.IsNullOrWhiteSpace(log.UserName) ? "System" : log.UserName)</span>
                                    &mdash; @log.Description
                                </div>
                                <div class="nncr-log-time">@log.LogDate.ToString("MMM dd, yyyy hh:mm tt")</div>
                            </div>
                            <span class="main-badge @(log.Action == NncrLogActions.Approved ? "is-success" : log.Action == NncrLogActions.Rejected ? "is-warning" : log.Action == NncrLogActions.EmailFailed ? "is-brand" : log.Action == NncrLogActions.Closed ? "" : "is-info")">@log.Action</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    }

</div>

@Html.Partial("~/Views/Shared/_PartialView/_AttachmentLightbox.cshtml")
<script src="@Url.Content("~/Scripts/shared/lightbox.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/shared/lightbox.js")).Ticks"></script>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    window.NNCR_STATUS_DATA = @Html.Raw(pageConfig);
</script>
@if (ViewBag.CanViewLog == true)
{
<script>
    window.NNCR_LOG = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        reportNumber = Model.ReportNumber,
        supplier = Model.SupplierName,
        entries = (Model.Logs ?? new List<NncrLogEntry>()).Select(l => new
        {
            date = l.LogDate.ToString("MMM dd, yyyy hh:mm tt"),
            user = string.IsNullOrWhiteSpace(l.UserName) ? "System" : l.UserName,
            action = l.Action,
            description = l.Description
        })
    }, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }));
</script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="@Url.Content("~/Scripts/nncr/nncr-log.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/nncr/nncr-log.js")).Ticks"></script>
}
<script src="@Url.Content("~/Scripts/nncr/nncr-status.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/nncr/nncr-status.js")).Ticks"></script>