@model List<StoreManagement.Models.NncrReport>
@using System.Linq
@using StoreManagement.Models
<link href="@Url.Content("~/Content/nncr/nncr.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/nncr/nncr.css")).Ticks" rel="stylesheet" />

@{
    ViewBag.Title = "NNCR Reports";
    var reports = Model ?? new List<NncrReport>();
    int totalCount = reports.Count;
    int awaitingCount = reports.Count(r => r.StatusKey == "awaiting");
    int overdueCount = reports.Count(r => r.StatusKey == "overdue");
    int approvedCount = reports.Count(r => r.StatusKey == "approved");
    int rejectedCount = reports.Count(r => r.StatusKey == "rejected");
    int closedCount = reports.Count(r => r.StatusKey == "closed");

    var suppliers = reports
        .Select(r => r.SupplierName)
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(s => s, StringComparer.OrdinalIgnoreCase)
        .ToList();

    Func<DateTime?, string> fmtDate = d => d.HasValue ? d.Value.ToString("MMM dd, yyyy") : "";
    Func<DateTime?, string> fmtDateTime = d => d.HasValue ? d.Value.ToString("MMM dd, yyyy hh:mm tt") : "";

    // Index-aligned with the table rows (data-index) — used by the Excel export.
    var exportRows = reports.Select(r => new
    {
        reportNumber = r.ReportNumber ?? "",
        status = r.StatusLabel ?? "",
        dateOfIncident = fmtDate(r.DateOfIncident),
        dateFiled = fmtDate(r.DateFiled),
        dueDate = fmtDate(r.DueDate),
        issuedBy = r.IssuedByName ?? "",
        supplier = r.SupplierName ?? "",
        siteWarehouse = r.SiteWarehouseName ?? "",
        nonconformanceType = r.NonconformanceType ?? "",
        interception = r.NonconformanceInterception ?? "",
        details = r.DetailsOfNonconformance ?? "",
        qaRemarks = r.QARemarks ?? "",
        supplierDecision = r.SupplierDecision ?? "",
        vendorRemarks = r.VendorRemarks ?? "",
        respondedBy = r.RespondedEmail ?? "",
        respondedDate = fmtDateTime(r.AcknowledgeDate),
        closedBy = r.ClosedByName ?? "",
        closedDate = fmtDateTime(r.ClosedDate)
    }).ToList();

    var jsonSettings = new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml };
    var exportRowsJson = Newtonsoft.Json.JsonConvert.SerializeObject(exportRows, jsonSettings);
}

<div class="main-list-page">

    <!-- =========================================
         NNCR HERO BANNER
         ========================================= -->

    <div class="main-hero">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Logistics operations" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <div class="main-hero-eyebrow">
                NNCR
            </div>

            <h2 class="main-hero-heading">
                NNCR Reports
            </h2>

            <p class="main-hero-description">
                Track non-conformance reports issued to suppliers, from filing to supplier response and closure.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-file-text-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">File &amp; Notify</div>
                        <div class="main-hero-feature-desc">Reports are emailed to the supplier</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-clock-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Due Dates</div>
                        <div class="main-hero-feature-desc">Suppliers respond within 7 working days</div>
                    </div>

                </div>

                <div class="main-hero-feature">

                    <div class="main-hero-feature-icon">
                        <i class="fa fa-check-circle-o"></i>
                    </div>

                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Review &amp; Close</div>
                        <div class="main-hero-feature-desc">QA verifies each response</div>
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================
         STATUS SUMMARY (click to filter)
         ========================================= -->

    <div class="nncr-stats">
        <div class="nncr-stat is-active" data-status="all" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-list-ul"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@totalCount</div>
                <div class="nncr-stat-label">Total</div>
            </div>
        </div>
        <div class="nncr-stat is-info" data-status="awaiting" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-hourglass-half"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@awaitingCount</div>
                <div class="nncr-stat-label">Awaiting Response</div>
            </div>
        </div>
        <div class="nncr-stat is-brand" data-status="overdue" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-exclamation-triangle"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@overdueCount</div>
                <div class="nncr-stat-label">Overdue</div>
            </div>
        </div>
        <div class="nncr-stat is-success" data-status="approved" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-thumbs-o-up"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@approvedCount</div>
                <div class="nncr-stat-label">Approved</div>
            </div>
        </div>
        <div class="nncr-stat is-warning" data-status="rejected" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-thumbs-o-down"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@rejectedCount</div>
                <div class="nncr-stat-label">Rejected</div>
            </div>
        </div>
        <div class="nncr-stat" data-status="closed" role="button" tabindex="0">
            <span class="nncr-stat-icon"><i class="fa fa-check-circle"></i></span>
            <div class="nncr-stat-body">
                <div class="nncr-stat-value">@closedCount</div>
                <div class="nncr-stat-label">Closed</div>
            </div>
        </div>
    </div>


    <!-- =========================================
         SEARCH / FILTER
         ========================================= -->

    <div class="main-list-toolbar">

        <div class="main-list-search">

            <div class="input-group">

                <input type="text"
                       id="nncrSearch"
                       class="form-control"
                       placeholder="Search NNCR No., supplier, issued by, details..."
                       aria-label="Search NNCR reports" />

                <button type="button"
                        class="btn main-list-search-btn"
                        id="nncrSearchBtn"
                        title="Search">

                    <i class="fa fa-search"></i>

                    <span class="main-list-search-btn-text">Search</span>

                </button>

            </div>

        </div>

        <div class="main-list-status nncr-supplier-filter">

            <select id="supplierFilter"
                    class="form-control"
                    aria-label="Filter by supplier">

                <option value="">All Suppliers</option>
                @foreach (var s in suppliers)
                {
                    <option value="@s">@s</option>
                }

            </select>

        </div>

        <div class="nncr-toolbar-dates">
            <label for="dateFrom">Incident</label>
            <input type="date" id="dateFrom" class="form-control" title="From date" aria-label="Incident date from" />
            <span>to</span>
            <input type="date" id="dateTo" class="form-control" title="To date" aria-label="Incident date to" />
        </div>

        <button type="button" class="btn main-outline-btn nncr-export-btn" id="exportExcelBtn">
            <i class="fa fa-file-excel-o"></i> Export to Excel
        </button>

        <a href="@Url.Action("Quality", "Nncr")"
           class="btn main-list-add-btn"
           title="File NNCR">

            <i class="fa fa-plus"></i>

            <span class="main-list-add-btn-text">File NNCR</span>

        </a>

    </div>


    <!-- =========================================
         NNCR TABLE
         ========================================= -->

    @Html.Partial("~/Views/Nncr/_PartialView/_NncrListTable.cshtml", reports)


    <!-- =========================================
         PAGINATION
         ========================================= -->

    <div class="main-list-pagination" id="nncrPaginationBar">

        <div class="main-pagination-size">
            <span>Show</span>

            <select id="nncrPageSize"
                    class="form-control"
                    aria-label="Rows per page">

                <option value="10" selected>10</option>
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>

            </select>

            <span class="main-pagination-entries">entries</span>
        </div>

        <div class="main-pagination-summary" id="nncrPageInfo">
            Showing 0 entries
        </div>

        <div class="main-pagination-controls" id="nncrPagination">
            <!-- Rendered by nncr-list.js -->
        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script>
    window.NNCR_LIST_DATA = {
        totalCount: @totalCount,
        rows: @Html.Raw(exportRowsJson)
    };
</script>
<script src="@Url.Content("~/Scripts/nncr/nncr-list.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/nncr/nncr-list.js")).Ticks"></script>
