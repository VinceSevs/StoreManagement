@model StoreManagement.Models.NncrReport
@using StoreManagement.Models
@{
    Layout = "~/Views/Shared/_BareLayout.cshtml";
    ViewBag.Title = "NNCR Response";
    bool isAwaiting = Model.Status == NncrStatuses.AwaitingResponse;
    bool isResponded = Model.HasSupplierResponse;

    string badgeText = Model.StatusLabel;
    string badgeClass = Model.StatusKey == "awaiting" ? "is-info"
        : Model.StatusKey == "overdue" ? "is-brand"
        : Model.StatusKey == "approved" ? "is-success"
        : Model.StatusKey == "rejected" ? "is-warning" : "";

    var pageConfig = Newtonsoft.Json.JsonConvert.SerializeObject(new
    {
        responseToken = Model.ResponseToken,
        reportNumber = Model.ReportNumber,
        submitEndpoint = Url.Action("SubmitResponse", "Nncr")
    }, new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml });
}

<link href="@Url.Content("~/Content/nncr/nncr.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/nncr/nncr.css")).Ticks" rel="stylesheet" />
<link href="@Url.Content("~/Content/css/attachments.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/css/attachments.css")).Ticks" rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<div class="nncr-doc nncr-public">

    <div class="nncr-doc-header">
        <img src="@Url.Content("~/Content/images/nncr-logo.png")" class="nncr-doc-logo" alt="LEAD Logistics Innovations, Inc." />
        <div class="nncr-doc-meta">
            <div class="nncr-doc-eyebrow">NNCR Response</div>
            <h1 class="nncr-doc-title">Reference: @Model.ReportNumber</h1>
        </div>
        <span id="nncrStatusBadge" class="main-badge @badgeClass"><i class="fa fa-circle"></i>@badgeText</span>
    </div>

    @Html.Partial("~/Views/Nncr/_PartialView/_NncrDetails.cshtml", Model)

    @if (isResponded)
    {
        <div class="nncr-card">
            <div class="main-view-card-header">
                <h4><span class="nncr-step-num">6</span>Your Response</h4>
                <span class="main-badge">Already Submitted</span>
            </div>
            <div class="main-inline-alert is-warning mb-3">
                <i class="fa fa-info-circle"></i>
                <span>A response has already been submitted for this NNCR. If you need to make changes, please contact LLII QA directly.</span>
            </div>
            @Html.Partial("~/Views/Nncr/_PartialView/_NncrSupplierResponse.cshtml", Model)
        </div>
    }
    else if (isAwaiting)
    {
        <form id="responseForm" class="nncr-card nncr-response-form" novalidate>
            <div class="main-view-card-header">
                <h4><span class="nncr-step-num">6</span>Your Response</h4>
            </div>
            <div class="row">
                <div class="col-12 col-sm-6 main-form-group">
                    <label for="supplierEmail">Supplier Email</label>
                    <input type="text" class="form-control main-form-calculated-field nncr-mono" id="supplierEmail" value="@Model.SupplierEmail" readonly>
                </div>
                <div class="col-12 col-sm-6 main-form-group">
                    <label for="responseDate">Response Date</label>
                    <input type="text" class="form-control main-form-calculated-field nncr-mono" id="responseDate" value="@DateTime.Now.ToString("MMM dd, yyyy")" readonly>
                </div>
                <div class="col-12 col-sm-6 main-form-group">
                    <label for="supplierDecision">Decision <span class="required">*</span></label>
                    <select class="form-control" id="supplierDecision" required>
                        <option value="@NncrDecisions.Approve" selected>Approve</option>
                        <option value="@NncrDecisions.Reject">Reject</option>
                    </select>
                </div>
                <div class="col-12 main-form-group">
                    <label for="vendorRemarks">Remarks <span class="required">*</span></label>
                    <textarea class="form-control" id="vendorRemarks" rows="5" maxlength="4000" required
                              placeholder="Your remarks / action taken on this non-conformance."></textarea>
                    <div class="invalid-feedback">Please enter your remarks.</div>
                    <div class="main-inline-alert is-warning">
                        <i class="fa fa-clock-o"></i>
                        <span>Please respond by <strong>@(Model.DueDate?.ToString("MMMM dd, yyyy"))</strong> (7 working days from filing).</span>
                    </div>
                </div>
            </div>
        </form>

        <div class="nncr-submit-bar" id="responseSubmitBar">
            <span id="submitStatus" class="nncr-submit-status me-auto"></span>
            <button type="button" class="btn main-form-save-btn" id="submitBtn">Submit Response</button>
        </div>

        <div class="nncr-card nncr-thankyou d-none" id="responseThankYou">
            <div class="nncr-thankyou-icon mb-3" aria-hidden="true"><i class="fa fa-check"></i></div>
            <h2>Thank you for your response</h2>
            <p class="nncr-muted mb-3">
                Your response to <span class="nncr-mono">@Model.ReportNumber</span> has been recorded. LLII QA will review it and close the NNCR.
            </p>
            <dl class="row main-view-fields nncr-thankyou-body">
                <div class="col-12 main-view-field">
                    <dt>Decision</dt>
                    <dd id="thankYouDecision"></dd>
                </div>
                <div class="col-12 main-view-field">
                    <dt>Your Remarks</dt>
                    <dd class="nncr-readonly-block" id="thankYouRemarks"></dd>
                </div>
            </dl>
            <div class="nncr-muted mt-3 text-start">
                Submitted as <strong class="nncr-mono">@Model.SupplierEmail</strong> on <span class="nncr-mono" id="thankYouDate"></span>
            </div>
        </div>
    }
    else
    {
        <div class="nncr-card">
            <div class="main-empty">This NNCR is not open for a response.</div>
        </div>
    }

</div>

<script>
    window.NNCR_RESPONSE_DATA = @Html.Raw(pageConfig);
</script>
@Html.Partial("~/Views/Shared/_PartialView/_AttachmentLightbox.cshtml")
<script src="@Url.Content("~/Scripts/shared/lightbox.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/shared/lightbox.js")).Ticks"></script>

<script src="@Url.Content("~/Scripts/nncr/nncr-response.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/nncr/nncr-response.js")).Ticks"></script>
