@{
    Layout = "~/Views/Shared/_BareLayout.cshtml";
    ViewBag.Title = "Link Not Valid";
}

<link href="@Url.Content("~/Content/nncr/nncr.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/nncr/nncr.css")).Ticks" rel="stylesheet" />

<div class="nncr-invalid">
    <div class="main-empty-state-icon"><i class="fa fa-chain-broken"></i></div>
    <h1>Link Not Valid</h1>
    <p>
        This NNCR link is missing, expired, or no longer valid. Please double-check the link
        you were given, or contact QA if you believe this is a mistake.
    </p>
</div>
