@{
    ViewBag.Title = "NNCR Report Form";
}

<link href="@Url.Content("~/Content/nncr/nncr.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/nncr/nncr.css")).Ticks" rel="stylesheet" />
<link href="@Url.Content("~/Content/css/attachments.css")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/css/attachments.css")).Ticks" rel="stylesheet" />

<div class="main-list-page">

    <!-- =========================================
         NNCR FORM HERO BANNER
         ========================================= -->

    <div class="main-hero is-record">

        <img class="main-hero-bg"
             src="@Url.Content("~/Content/images/vendor-hero-image.jpg")"
             alt="Logistics operations" />

        <div class="main-hero-gradient"></div>

        <div class="main-hero-content">

            <nav class="main-hero-eyebrow main-hero-breadcrumb" aria-label="Breadcrumb">
                <a href="@Url.Action("NncrList", "Nncr")"
                   class="main-hero-back"
                   title="Back to NNCR Reports"
                   aria-label="Back to NNCR Reports">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <a href="@Url.Action("NncrList", "Nncr")">NNCR</a>
                <i class="fa fa-angle-right" aria-hidden="true"></i>
                <span>File NNCR</span>
            </nav>

            <div class="main-hero-title-row">
                <h2 class="main-hero-heading">NNCR Report</h2>
            </div>

            <p class="main-hero-description">
                Record a product quality or food safety non-conformance and send it to the supplier.
            </p>

            <div class="main-hero-features">

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-envelope-o"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Notification</div>
                        <div class="main-hero-feature-desc">Emailed to the supplier on submit</div>
                    </div>
                </div>

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-clock-o"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Response Window</div>
                        <div class="main-hero-feature-desc">@StoreManagement.Models.NncrDueDates.WorkingDaysToRespond working days</div>
                    </div>
                </div>

                <div class="main-hero-feature">
                    <div class="main-hero-feature-icon"><i class="fa fa-paperclip"></i></div>
                    <div class="main-hero-feature-text">
                        <div class="main-hero-feature-label">Attachments</div>
                        <div class="main-hero-feature-desc">Up to @IsseERP.Services.NncrAttachmentService.MaxFiles files</div>
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="nncr-doc">

        <div class="nncr-actions d-print-none">
            <span id="submitStatus" class="nncr-actions-lead nncr-submit-status"></span>
            <button type="button" class="btn main-form-cancel-btn" onclick="clearNncrForm()">Clear form</button>
            <button type="button" class="btn main-outline-btn" onclick="window.print()">
                <i class="fa fa-print"></i> Print
            </button>
            <button type="button" class="btn main-form-save-btn" id="submitBtn" onclick="submitNncrForm()">Submit NNCR</button>
        </div>

        <form id="nncrForm" class="nncr-form" onsubmit="return false;" autocomplete="off" novalidate>

            <div class="nncr-doc-header">
                <img src="@Url.Content("~/Content/images/nncr-logo.png")" class="nncr-doc-logo" alt="LEAD Logistics Innovations, Inc." />
                <div class="nncr-doc-meta">
                    <div class="nncr-doc-eyebrow">Quality Assurance</div>
                    <h1 class="nncr-doc-title">NNCR Report</h1>
                    <div class="nncr-doc-sub">Product Quality &amp; Food Safety Compliance</div>
                </div>
                <div class="nncr-head-fields">
                    <div class="main-form-group">
                        <label for="incidentDateInput">Date of Incident <span class="required">*</span></label>
                        <input type="date" class="form-control is-mono" name="date_of_incident" id="incidentDateInput" required>
                    </div>
                    <div class="main-form-group">
                        <label for="dueDateInput">Response Due</label>
                        <input type="text" class="form-control is-mono" id="dueDateInput" readonly
                               title="7 working days from today (Saturdays and Sundays not counted)">
                    </div>
                </div>
            </div>

            <div class="nncr-card">
                <div class="main-view-card-header">
                    <h4><span class="main-view-card-icon"><i class="fa fa-building-o"></i></span>Supplier &amp; Location</h4>
                </div>
                <div class="row">
                    <div class="col-12 col-md-6 main-form-group">
                        <label for="issuedByInput">Issued By <span class="nncr-hint">(Name / Department)</span></label>
                        <input type="text" class="form-control" id="issuedByInput" value="@ViewBag.IssuedByName" readonly>
                    </div>

                    <div class="col-12 col-md-6 main-form-group">
                        <label for="supplierSearchInput">Issued To <span class="nncr-hint">(Supplier Name)</span> <span class="required">*</span></label>
                        <div class="nncr-autocomplete" id="supplierSearchWrap">
                            <input type="text" class="form-control" id="supplierSearchInput" autocomplete="off"
                                   placeholder="Type to search supplier&hellip;" required>
                            <input type="hidden" id="issuedToId">
                            <div class="nncr-ac-dropdown" id="supplierDropdown"></div>
                        </div>
                        <div class="form-text" id="supplierEmailHint"></div>
                    </div>

                    <div class="col-12 col-md-6 main-form-group">
                        <label for="siteWarehouseSelect">Site Warehouse <span class="required">*</span></label>
                        <select class="form-control" name="site_warehouse" id="siteWarehouseSelect" onchange="handleWarehouseChange()" required>
                            <option value="" disabled selected>Select warehouse&hellip;</option>
                            @foreach (var w in ViewBag.Warehouse)
                            {
                                <option value="@w.WarehouseID" data-code="@w.ExternalCode">@w.WarehouseName</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6 main-form-group">
                        <label for="warehouseCodeInput">Warehouse Code</label>
                        <input type="text" class="form-control is-mono" id="warehouseCodeInput" placeholder="Auto-fills from selection" readonly>
                    </div>
                </div>
            </div>

            <div class="nncr-card">
                <div class="main-view-card-header">
                    <h4><span class="main-view-card-icon"><i class="fa fa-exclamation-triangle"></i></span>Non-conformance</h4>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <div class="nncr-box" id="nonconformanceTypeSection">
                            <div class="nncr-box-title">
                                Type of Non-conformance <small>(tick all that apply)</small>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeQuality" value="Quality Issues">
                                    <label class="form-check-label" for="ncTypeQuality">
                                        Quality Issues
                                        <span class="d-block nncr-hint fst-italic">thawing, foul odor, slimy texture, discoloration, dirty, etc.</span>
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeDamage" value="Damage items">
                                    <label class="form-check-label" for="ncTypeDamage">Damage items</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeExpired" value="Expired items">
                                    <label class="form-check-label" for="ncTypeExpired">Expired items</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypePest" value="Presence of pest/molds">
                                    <label class="form-check-label" for="ncTypePest">Presence of pest/molds</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeOthers" value="Others" data-detail="ncTypeOthersText" data-detail-required="true">
                                    <label class="form-check-label" for="ncTypeOthers">Others</label>
                                    <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="ncTypeOthersText" maxlength="200" placeholder="Specify the non-conformance">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6">
                        <div class="nncr-box" id="interceptionSection">
                            <div class="nncr-box-title">
                                Non-conformance Interception <small>(tick all that apply)</small>
                            </div>
                            <div class="d-flex flex-column gap-2">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="interception" id="icReceiving" value="Receiving" data-detail="icReceivingText">
                                    <label class="form-check-label" for="icReceiving">Receiving</label>
                                    <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icReceivingText" maxlength="200" placeholder="Receiving details (optional)">
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="interception" id="icStorage" value="Storage" data-detail="icStorageText">
                                    <label class="form-check-label" for="icStorage">Storage</label>
                                    <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icStorageText" maxlength="200" placeholder="Storage details (optional)">
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="interception" id="icDispatch" value="Dispatch" data-detail="icDispatchText">
                                    <label class="form-check-label" for="icDispatch">Dispatch</label>
                                    <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icDispatchText" maxlength="200" placeholder="Dispatch details (optional)">
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" name="interception" id="icOthers" value="Others" data-detail="icOthersText" data-detail-required="true">
                                    <label class="form-check-label" for="icOthers">Others</label>
                                    <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icOthersText" maxlength="200" placeholder="Specify where it was intercepted">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nncr-card">
                <div class="main-view-card-header">
                    <h4><span class="nncr-step-num">1</span>Details of the Non-conformance</h4>
                    <span class="nncr-card-note">To be completed by LLII-QA</span>
                </div>
                <div class="main-form-group mb-0">
                    <label for="detailsInput">Details <span class="required">*</span></label>
                    <textarea class="form-control" name="details" id="detailsInput" rows="6" required
                              placeholder="Describe what was found, when and where it was discovered, and which product, batch, or delivery is affected&hellip;"></textarea>
                </div>
            </div>

            <div class="nncr-card">
                <div class="main-view-card-header">
                    <h4><span class="nncr-step-num">2</span>Action Taken by LLII-QA / QA Remarks</h4>
                    <span class="nncr-card-note">Optional</span>
                </div>
                <div class="main-form-group mb-0">
                    <textarea class="form-control" name="qa_remarks" id="qaRemarksInput" rows="4" aria-label="QA remarks"
                              placeholder="e.g. items put on hold, segregated, returned to supplier&hellip;"></textarea>
                </div>
            </div>

            <div class="nncr-card" id="attachmentsSection">
                <div class="main-view-card-header">
                    <h4><span class="nncr-step-num">3</span>Photo / Document Attachments</h4>
                    <span class="nncr-card-note">Evidence photos, supporting documents, etc.</span>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap d-print-none">
                        <label class="btn main-outline-btn mb-0 d-inline-flex align-items-center">
                            <i class="fa fa-paperclip"></i> Add file(s)
                            <input type="file" multiple class="d-none" id="attachmentsInput" aria-label="Attachments">
                        </label>
                        <span class="capa-muted">Optional &mdash; up to @IsseERP.Services.NncrAttachmentService.MaxFiles files, 10 MB each, 25 MB total.</span>
                    </div>
                    <div class="capa-attach-empty" id="attachmentsEmpty">No attachments added yet.</div>
                    <div class="row row-cols-2 row-cols-md-3 g-3" id="attachmentsList"></div>
                </div>
            </div>


            <div class="nncr-card nncr-locked">
                <div class="main-view-card-header">
                    <h4><span class="nncr-step-num is-muted"><i class="fa fa-lock"></i></span>Action Taken by Supplier</h4>
                    <span class="nncr-card-note">To be completed by the supplier</span>
                </div>
                <div class="nncr-muted mb-2">
                    <i class="fa fa-history"></i>
                    The supplier fills this in later through the emailed link, within <strong>7 working days</strong> (Saturdays and Sundays not counted).
                </div>
                <div class="main-form-group mb-0">
                    <textarea class="form-control" rows="3" readonly disabled aria-label="Supplier action" placeholder="To be completed by the supplier."></textarea>
                </div>
            </div>

            <div class="nncr-info-note d-print-none">
                <i class="fa fa-envelope-o"></i>
                <span>On submit, this NNCR is sent directly to the supplier's email (from the supplier list).</span>
            </div>

            <p class="nncr-muted fst-italic">
                Note: For the Corrective Action Report, the recipient can utilize their official corrective action form to address the observed non-conformance.
            </p>

        </form>
    </div>
</div>

<script>
    window.NNCR_QUALITY_CONFIG = {
        saveUrl: '@Url.Action("SaveNncr", "Nncr")',
        statusUrl: '@Url.Action("NncrStatus", "Nncr")',
        workingDaysToRespond: @StoreManagement.Models.NncrDueDates.WorkingDaysToRespond,
        maxFiles: @IsseERP.Services.NncrAttachmentService.MaxFiles,
        maxFileBytes: @IsseERP.Services.NncrAttachmentService.MaxFileBytes,
        maxTotalBytes: @IsseERP.Services.NncrAttachmentService.MaxTotalBytes,
        suppliers: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ((IEnumerable<IsseERP.Models.Vendor>)ViewBag.Vendor).Select(v => new { id = v.VendorID, name = v.VendorName, email = (v.EmailAddress ?? "").Trim() }),
            new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }))
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="@Url.Content("~/Scripts/nncr/quality.js")?v=@System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/nncr/quality.js")).Ticks"></script>
