@{
    ViewBag.Title = "NNCR Report Form";
}

<link href="@Url.Content("~/Content/nncr/quality.css")?v=@DateTime.Now.Ticks" rel="stylesheet" />

<div class="container my-4">

    <div class="d-flex align-items-center justify-content-end gap-2 mb-3 d-print-none flex-wrap">
        <span id="submitStatus" class="me-auto small fw-semibold"></span>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearNncrForm()">Clear form</button>
        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            <i class="bi bi-printer"></i> Print
        </button>
        <button type="button" class="btn btn-primary btn-sm" id="submitBtn" onclick="submitNncrForm()">Submit NNCR</button>
    </div>

    <form id="nncrForm" class="card shadow-sm" onsubmit="return false;" autocomplete="off" novalidate>
        <div class="card-body p-4">

            <div class="d-flex justify-content-between align-items-end border-bottom pb-3 mb-4 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <img src="data:image/png;base64," class="brand-logo" alt="LEAD Logistics Innovations, Inc.">
                    <div>
                        <div class="text-uppercase small fw-semibold font-mono nncr-eyebrow">Quality Assurance</div>
                        <h1 class="h3 mb-0">NNCR Report</h1>
                        <div class="text-secondary small">Product Quality &amp; Food Safety Compliance</div>
                    </div>
                </div>
                <div class="d-flex gap-3 flex-wrap nncr-head-fields">
                    <div>
                        <label class="form-label small text-uppercase text-secondary mb-1" for="incidentDateInput">Date of Incident</label>
                        <input type="date" class="form-control font-mono" name="date_of_incident" id="incidentDateInput" required>
                    </div>
                    <div>
                        <label class="form-label small text-uppercase text-secondary mb-1" for="dueDateInput">Response Due</label>
                        <input type="text" class="form-control font-mono readonly-field" id="dueDateInput" readonly
                               title="7 working days from today (Saturdays and Sundays not counted)">
                    </div>
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary" for="issuedByInput">
                        Issued By <i class="fw-normal fst-italic text-lowercase">(Name / Department)</i>
                    </label>
                    <input type="text" class="form-control readonly-field" id="issuedByInput" value="@ViewBag.IssuedByName" readonly>
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary" for="supplierSearchInput">
                        Issued To <i class="fw-normal fst-italic text-lowercase">(Supplier Name)</i>
                    </label>
                    <div class="autocomplete-wrap" id="supplierSearchWrap">
                        <input type="text" class="form-control" id="supplierSearchInput" autocomplete="off"
                               placeholder="Type to search supplier&hellip;" required>
                        <input type="hidden" id="issuedToId">
                        <div class="list-group ac-dropdown shadow-sm" id="supplierDropdown"></div>
                    </div>
                    <div class="form-text" id="supplierEmailHint"></div>
                </div>

                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary" for="siteWarehouseSelect">Site Warehouse</label>
                    <select class="form-select" name="site_warehouse" id="siteWarehouseSelect" onchange="handleWarehouseChange()" required>
                        <option value="" disabled selected>Select warehouse&hellip;</option>
                        @foreach (var w in ViewBag.Warehouse)
                        {
                            <option value="@w.WarehouseID" data-code="@w.ExternalCode">@w.WarehouseName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small text-uppercase text-secondary" for="warehouseCodeInput">Warehouse Code</label>
                    <input type="text" class="form-control font-mono readonly-field" id="warehouseCodeInput" placeholder="Auto-fills from selection" readonly>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" id="nonconformanceTypeSection">
                        <div class="fw-semibold text-uppercase small mb-2 nncr-box-title">
                            Type of Non-conformance <span class="fw-normal text-secondary text-lowercase">(tick all that apply)</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeQuality" value="Quality Issues">
                                <label class="form-check-label" for="ncTypeQuality">
                                    Quality Issues
                                    <span class="d-block small text-secondary fst-italic">thawing, foul odor, slimy texture, discoloration, dirty, etc.</span>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeDamage" value="Damage items">
                                <label class="form-check-label" for="ncTypeDamage">Damage items</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeExpired" value="Expired items">
                                <label class="form-check-label" for="ncTypeExpired">Expired items</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypePest" value="Presence of pest/molds">
                                <label class="form-check-label" for="ncTypePest">Presence of pest/molds</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="nc_type" id="ncTypeOthers" value="Others" data-detail="ncTypeOthersText" data-detail-required="true">
                                <label class="form-check-label" for="ncTypeOthers">Others</label>
                                <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="ncTypeOthersText" maxlength="200" placeholder="Specify the non-conformance">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="border rounded p-3 h-100" id="interceptionSection">
                        <div class="fw-semibold text-uppercase small mb-2 nncr-box-title">
                            Non-conformance Interception <span class="fw-normal text-secondary text-lowercase">(tick all that apply)</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="interception" id="icReceiving" value="Receiving" data-detail="icReceivingText">
                                <label class="form-check-label" for="icReceiving">Receiving</label>
                                <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icReceivingText" maxlength="200" placeholder="Receiving details (optional)">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="interception" id="icStorage" value="Storage" data-detail="icStorageText">
                                <label class="form-check-label" for="icStorage">Storage</label>
                                <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icStorageText" maxlength="200" placeholder="Storage details (optional)">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="interception" id="icDispatch" value="Dispatch" data-detail="icDispatchText">
                                <label class="form-check-label" for="icDispatch">Dispatch</label>
                                <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icDispatchText" maxlength="200" placeholder="Dispatch details (optional)">
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="interception" id="icOthers" value="Others" data-detail="icOthersText" data-detail-required="true">
                                <label class="form-check-label" for="icOthers">Others</label>
                                <input type="text" class="form-control form-control-sm mt-1 d-none nncr-detail-input" id="icOthersText" maxlength="200" placeholder="Specify where it was intercepted">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge me-2">1</span>Details of the Non-conformance</span>
                    <small class="text-secondary fst-italic">To be completed by LLII-QA</small>
                </div>
                <div class="card-body">
                    <label class="form-label small text-uppercase text-secondary" for="detailsInput">Details</label>
                    <textarea class="form-control" name="details" id="detailsInput" rows="6" required
                              placeholder="Describe what was found, when and where it was discovered, and which product, batch, or delivery is affected&hellip;"></textarea>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge me-2">2</span>Action Taken by LLII-QA / QA Remarks</span>
                    <small class="text-secondary fst-italic">Optional</small>
                </div>
                <div class="card-body">
                    <textarea class="form-control" name="qa_remarks" id="qaRemarksInput" rows="4"
                              placeholder="e.g. items put on hold, segregated, returned to supplier&hellip;"></textarea>
                </div>
            </div>

            <div class="card mb-3" id="attachmentsSection">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge me-2">3</span>Attachments</span>
                    <small class="text-secondary fst-italic">Optional &mdash; up to 10 files, 10 MB each, 25 MB total</small>
                </div>
                <div class="card-body">
                    <input type="file" class="form-control d-print-none" id="attachmentsInput" multiple>
                    <ul class="list-group list-group-flush mt-2 nncr-file-list" id="attachmentsList"></ul>
                </div>
            </div>

            <div class="card mb-3 nncr-locked-card">
                <div class="card-header d-flex justify-content-between align-items-center bg-white flex-wrap gap-1">
                    <span><span class="step-badge step-badge-muted me-2"><i class="bi bi-lock-fill"></i></span>Action Taken by Supplier</span>
                    <small class="text-secondary fst-italic">To be completed by the supplier</small>
                </div>
                <div class="card-body">
                    <div class="small text-secondary mb-2">
                        <i class="bi bi-clock-history"></i>
                        The supplier fills this in later through the emailed link, within <strong>7 working days</strong> (Saturdays and Sundays not counted).
                    </div>
                    <textarea class="form-control" rows="3" readonly disabled placeholder="To be completed by the supplier."></textarea>
                </div>
            </div>

            <div class="alert alert-light border small d-flex gap-2 align-items-start mb-3 d-print-none">
                <i class="bi bi-envelope"></i>
                <span>On submit, this NNCR is sent directly to the supplier's email (from the supplier list).</span>
            </div>

            <p class="small fst-italic text-secondary mb-4">
                Note: For the Corrective Action Report, the recipient can utilize their official corrective action form to address the observed non-conformance.
            </p>

            <div class="d-flex justify-content-between text-secondary small border-top pt-3 font-mono flex-wrap gap-2">
                @*<span>QF-QAD-083 Rev 01</span>
                <span>Effectivity date: September 28, 2026</span>*@
            </div>

        </div>
    </form>
</div>

<script>
    window.NNCR_QUALITY_CONFIG = {
        saveUrl: '@Url.Action("SaveNncr", "Nncr")',
        statusUrl: '@Url.Action("NncrStatus", "Nncr")',
        workingDaysToRespond: @StoreManagement.Models.NncrDueDates.WorkingDaysToRespond,
        maxFiles: @IsseERP.Services.NncrAttachmentService.MaxFiles,
        maxFileBytes: @IsseERP.Services.NncrAttachmentService.MaxFileBytes,
        maxTotalBytes: @IsseERP.Services.NncrAttachmentService.MaxTotalBytes,
        suppliers: @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            ((IEnumerable<IsseERP.Models.Vendor>)ViewBag.Vendor).Select(v => new { id = v.VendorID, name = v.VendorName, email = (v.EmailAddress ?? "").Trim() }),
            new Newtonsoft.Json.JsonSerializerSettings { StringEscapeHandling = Newtonsoft.Json.StringEscapeHandling.EscapeHtml }))
    };
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="@Url.Content("~/Scripts/nncr/quality.js")?v=@DateTime.Now.Ticks"></script>
