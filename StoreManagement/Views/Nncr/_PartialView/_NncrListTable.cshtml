@model List<StoreManagement.Models.NncrReport>
@using StoreManagement.Models
@{
    Func<string, string> dashIfEmpty = s => string.IsNullOrWhiteSpace(s) ? "—" : s.Trim();
    Func<string, string> statusTone = key =>
        key == "awaiting" ? "is-info"
        : key == "overdue" ? "is-brand"
        : key == "approved" ? "is-success"
        : key == "rejected" ? "is-warning"
        : "";
}
<div class="main-list-table-wrapper">

    <div class="table-responsive">

        <table class="table main-list-table nncr-table" id="nncrTable">

            <thead>
                <tr>
                    <th class="sortable" data-column="date" data-sort-key="date">
                        <div class="th-content">
                            <span class="th-label">DATE OF INCIDENT</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Date of Incident" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="due" data-sort-key="due">
                        <div class="th-content">
                            <span class="th-label">DUE DATE</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Due Date" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="number" data-sort-col="2">
                        <div class="th-content">
                            <span class="th-label">NNCR NO.</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by NNCR No." tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="supplier" data-sort-col="3">
                        <div class="th-content">
                            <span class="th-label">SUPPLIER</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Supplier" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="warehouse" data-sort-col="4">
                        <div class="th-content">
                            <span class="th-label">SITE WAREHOUSE</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Site Warehouse" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="type" data-sort-col="5">
                        <div class="th-content">
                            <span class="th-label">TYPE OF NON-CONFORMANCE</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Type of Non-conformance" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="interception" data-sort-col="6">
                        <div class="th-content">
                            <span class="th-label">INTERCEPTION</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Interception" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="sortable" data-column="status" data-sort-col="7">
                        <div class="th-content">
                            <span class="th-label">STATUS</span>
                            <button type="button" class="btn main-column-sort" aria-label="Sort by Status" tabindex="-1"><i class="fa fa-sort sort-icon"></i></button>
                        </div>
                    </th>
                    <th class="actions-column main-actions-sticky" data-column="actions">ACTIONS</th>
                </tr>
            </thead>

            <tbody>
                @if (Model == null || Model.Count == 0)
                {
                    <tr class="main-empty-row">
                        <td colspan="9">
                            <div class="main-empty-state">
                                <div class="main-empty-state-icon"><i class="fa fa-file-text-o"></i></div>
                                <div class="main-empty-state-title">No NNCR reports yet</div>
                                <div class="main-empty-state-text">Filed reports will show up here. <a href="@Url.Action("Quality", "Nncr")">File an NNCR</a></div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    for (int i = 0; i < Model.Count; i++)
                    {
                        var nncr = Model[i];
                        string statusUrl = Url.Action("NncrStatus", "Nncr") + "?token=" + Url.Encode(nncr.ResponseToken ?? "");
                        string searchText = string.Join(" ", new[] {
                            nncr.ReportNumber, nncr.SupplierName, nncr.SiteWarehouseName, nncr.IssuedByName,
                            nncr.NonconformanceType, nncr.NonconformanceInterception, nncr.DetailsOfNonconformance
                        }).ToLowerInvariant();
                        string types = string.IsNullOrWhiteSpace(nncr.NonconformanceType) ? "—" : nncr.NonconformanceType.Replace("; ", ", ");
                        string interceptions = string.IsNullOrWhiteSpace(nncr.NonconformanceInterception) ? "—" : nncr.NonconformanceInterception.Replace("; ", ", ");
                        string rowClass = "nncr-row status-row-" + nncr.StatusKey
                            + (nncr.IsOverdue ? " is-overdue" : "")
                            + (nncr.IsDueSoon ? " is-due-soon" : "");

                        <tr class="@rowClass"
                            data-index="@i"
                            data-status="@nncr.StatusKey"
                            data-supplier="@(nncr.SupplierName ?? "")"
                            data-date="@(nncr.DateOfIncident.HasValue ? nncr.DateOfIncident.Value.ToString("yyyy-MM-dd") : "")"
                            data-due="@(nncr.DueDate.HasValue ? nncr.DueDate.Value.ToString("yyyy-MM-dd") : "")"
                            data-search="@searchText"
                            data-href="@statusUrl">
                            <td data-column="date" class="nncr-date-cell">@(nncr.DateOfIncident.HasValue ? nncr.DateOfIncident.Value.ToString("MMM dd, yyyy") : "—")</td>
                            <td data-column="due">
                                <div class="nncr-due-line">
                                    @if (nncr.IsOverdue || nncr.IsDueSoon)
                                    {
                                        <i class="fa fa-exclamation-triangle nncr-due-icon" title="@nncr.DueText" aria-label="@nncr.DueText"></i>
                                    }
                                    <span>@(nncr.DueDate.HasValue ? nncr.DueDate.Value.ToString("MMM dd, yyyy") : "—")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(nncr.DueText))
                                {
                                    <div class="nncr-due-text @(nncr.IsOverdue ? "is-overdue" : nncr.IsDueSoon ? "is-due-soon" : "")">@nncr.DueText</div>
                                }
                            </td>
                            <td data-column="number"><a href="@statusUrl" class="main-chip nncr-no-link">@dashIfEmpty(nncr.ReportNumber)</a></td>
                            <td data-column="supplier"><div class="nncr-cell-text" title="@(nncr.SupplierName ?? "")">@dashIfEmpty(nncr.SupplierName)</div></td>
                            <td data-column="warehouse"><div class="nncr-cell-text" title="@(nncr.SiteWarehouseName ?? "")">@dashIfEmpty(nncr.SiteWarehouseName)</div></td>
                            <td data-column="type"><div class="nncr-cell-text" title="@types">@types</div></td>
                            <td data-column="interception"><div class="nncr-cell-text" title="@interceptions">@interceptions</div></td>
                            <td data-column="status">
                                <span class="main-badge @statusTone(nncr.StatusKey)"><i class="fa fa-circle"></i>@dashIfEmpty(nncr.StatusLabel)</span>
                            </td>
                            <td data-column="actions" class="actions-column main-actions-sticky">
                                <a href="@statusUrl" class="btn btn-primary btn-sm" title="View NNCR" aria-label="View NNCR">View</a>
                            </td>
                        </tr>
                    }
                    <tr id="nncrNoMatchRow" class="main-empty-row d-none">
                        <td colspan="9">
                            <div class="main-empty-state">
                                <div class="main-empty-state-icon"><i class="fa fa-search"></i></div>
                                <div class="main-empty-state-title">No NNCR reports match the current filters</div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>
