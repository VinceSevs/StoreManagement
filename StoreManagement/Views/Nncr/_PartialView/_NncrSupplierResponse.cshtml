@model StoreManagement.Models.NncrReport
@using StoreManagement.Models
@* Read-only view of the supplier's submitted response (Approved / Rejected / Closed NNCRs). *@
@{
    bool approved = Model.SupplierDecision == NncrDecisions.Approve;
}
<dl class="row main-view-fields">
    <div class="col-12 col-sm-6 main-view-field">
        <dt>Decision</dt>
        <dd>
            <span class="main-badge @(approved ? "is-success" : "is-brand")">
                <i class="fa @(approved ? "fa-check-circle" : "fa-times-circle")"></i> @(approved ? "Approved" : Model.SupplierDecision == NncrDecisions.Reject ? "Rejected" : "—")
            </span>
        </dd>
    </div>
    <div class="col-12 col-sm-6 main-view-field">
        <dt>Response Date</dt>
        <dd class="nncr-mono">@(Model.AcknowledgeDate?.ToString("MMM dd, yyyy hh:mm tt"))</dd>
    </div>
    <div class="col-12 main-view-field">
        <dt>Supplier Remarks</dt>
        <dd class="nncr-readonly-block">@Model.VendorRemarks</dd>
    </div>
    <div class="col-12 col-sm-6 main-view-field">
        <dt>Supplier</dt>
        <dd>@Model.SupplierName</dd>
    </div>
    <div class="col-12 col-sm-6 main-view-field">
        <dt>Responded By (Email)</dt>
        <dd class="nncr-mono">@Model.RespondedEmail</dd>
    </div>
</dl>
